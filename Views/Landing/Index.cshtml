@model TrungTamNgoaiNgu.ViewModels.LandingViewModel
@{
    Layout = null;
    ViewData["Title"] = "LanguageBook - Trung Tâm Ngoại Ngữ Hàng Đầu & Nền Tảng Luyện Thi Trực Tuyến";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Google Fonts: Be Vietnam Pro -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body, button, input, select, textarea {
            font-family: 'Be Vietnam Pro', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
            background: #fff;
            color: #050505;
        }

        /* NAV */
        .lp-nav { background: rgba(255,255,255,0.96); backdrop-filter: blur(12px); position: sticky; top: 0; z-index: 1000; border-bottom: 1px solid #e4e6eb; padding: 12px 0; }
        .lp-logo { font-size: 22px; font-weight: 800; color: #0866ff; text-decoration: none; display: flex; align-items: center; gap: 8px; }
        .lp-logo span { color: #050505; }

        /* HERO */
        .hero { background: linear-gradient(135deg, #0044b3 0%, #0866ff 50%, #1a7bff 100%); min-height: 90vh; display: flex; align-items: center; position: relative; overflow: hidden; }
        .hero-circle1 { position: absolute; top: -120px; right: -120px; width: 550px; height: 550px; background: rgba(255,255,255,0.06); border-radius: 50%; }
        .hero-circle2 { position: absolute; bottom: -80px; left: -60px; width: 360px; height: 360px; background: rgba(255,255,255,0.04); border-radius: 50%; }
        .hero h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); font-weight: 800; color: #fff; line-height: 1.18; }
        .hero p.lead { font-size: 1.15rem; color: rgba(255,255,255,0.9); }
        .hero-badge { display: inline-flex; align-items: center; gap: 6px; background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.35); border-radius: 50px; padding: 6px 18px; font-size: 13px; font-weight: 600; margin-bottom: 20px; }
        
        .stat-box { text-align: center; padding: 20px 14px; background: rgba(255,255,255,0.12); border-radius: 16px; color: #fff; border: 1px solid rgba(255,255,255,0.22); backdrop-filter: blur(6px); transition: transform 0.2s; }
        .stat-box:hover { transform: translateY(-3px); background: rgba(255,255,255,0.18); }
        .stat-box .num { font-size: 2.2rem; font-weight: 900; line-height: 1.1; }
        .stat-box .lbl { font-size: 12px; opacity: 0.85; margin-top: 4px; }
        
        .btn-hero { background: #fff; color: #0866ff; border: none; border-radius: 12px; padding: 14px 32px; font-size: 1rem; font-weight: 800; transition: all 0.2s; box-shadow: 0 4px 14px rgba(0,0,0,0.15); display: inline-flex; align-items: center; gap: 8px; }
        .btn-hero:hover { background: #e8f0fe; color: #004ac0; transform: translateY(-2px); }
        .btn-hero-outline { background: transparent; color: #fff; border: 2px solid rgba(255,255,255,0.7); border-radius: 12px; padding: 13px 30px; font-size: 1rem; font-weight: 700; transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px; }
        .btn-hero-outline:hover { background: rgba(255,255,255,0.18); border-color: #fff; color: #fff; }

        /* FEATURES PILLARS */
        .feat-card { background: #ffffff; border: 1px solid #e4e6eb; border-radius: 16px; padding: 24px 20px; height: 100%; transition: all 0.25s; }
        .feat-card:hover { transform: translateY(-5px); box-shadow: 0 12px 28px rgba(0,0,0,0.08); border-color: #c7d2fe; }
        .feat-icon { width: 56px; height: 56px; border-radius: 14px; display: flex; align-items: center; justify-content: center; margin-bottom: 16px; font-size: 24px; }

        /* ONLINE EXAM SHOWCASE SECTION */
        .exam-showcase-section { background: linear-gradient(180deg, #f0f7ff 0%, #eaf2ff 100%); border-top: 1px solid #dbeafe; border-bottom: 1px solid #dbeafe; }
        .exam-card-preview { background: #ffffff; border: 1px solid #cbd5e1; border-radius: 12px; padding: 18px; height: 100%; transition: all 0.2s; display: flex; flex-direction: column; justify-content: space-between; }
        .exam-card-preview:hover { transform: translateY(-4px); box-shadow: 0 12px 24px rgba(8,102,255,0.12); border-color: #0866ff; }

        /* COURSE CARDS */
        .course-card { background: #fff; border-radius: 14px; overflow: hidden; box-shadow: 0 2px 14px rgba(0,0,0,0.06); transition: all 0.2s; height: 100%; border: 1px solid #f0f2f5; display: flex; flex-direction: column; }
        .course-card:hover { transform: translateY(-5px); box-shadow: 0 14px 30px rgba(0,0,0,0.12); }
        .course-card-img { height: 155px; overflow: hidden; position: relative; background: #000; }
        .course-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.3s; }
        .course-card:hover .course-card-img img { transform: scale(1.05); }

        /* HALL OF FAME / SOCIAL PROOF */
        .fame-card { background: #ffffff; border-radius: 16px; padding: 22px; border: 1px solid #e4e6eb; height: 100%; position: relative; transition: all 0.2s; }
        .fame-card:hover { transform: translateY(-4px); box-shadow: 0 10px 25px rgba(0,0,0,0.08); border-color: #fcd34d; }
        .fame-score-badge { position: absolute; top: 16px; right: 16px; background: #fef3c7; color: #92400e; font-weight: 800; font-size: 13px; padding: 4px 10px; border-radius: 20px; border: 1px solid #fde68a; }

        /* LEARNING PATHWAY */
        .step-circle { width: 50px; height: 50px; border-radius: 50%; background: #0866ff; color: #fff; font-weight: 800; font-size: 20px; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; box-shadow: 0 6px 16px rgba(8,102,255,0.3); }

        /* TEACHER */
        .teacher-card { background: #fff; border-radius: 16px; padding: 24px 16px; text-align: center; box-shadow: 0 2px 12px rgba(0,0,0,0.06); border: 1px solid #f0f2f5; transition: transform 0.2s; }
        .teacher-card:hover { transform: translateY(-4px); box-shadow: 0 10px 20px rgba(0,0,0,0.1); }
        .teacher-avatar { width: 84px; height: 84px; border-radius: 50%; object-fit: cover; border: 3px solid #0866ff; margin: 0 auto 12px; display: block; }

        /* PROMO BANNER */
        .promo-banner { background: linear-gradient(135deg, #1e3a8a 0%, #0866ff 60%, #06b6d4 100%); border-radius: 20px; padding: 36px 32px; color: #ffffff; box-shadow: 0 14px 34px rgba(8,102,255,0.25); }

        /* REGISTER */
        .register-section { background: linear-gradient(135deg, #f0f7ff 0%, #e8efff 100%); }
        .register-card { background: #fff; border-radius: 20px; box-shadow: 0 8px 36px rgba(8,102,255,0.12); border: 1px solid #e0e7ff; }

        /* FOOTER */
        .lp-footer { background: #0f172a; color: rgba(255,255,255,0.7); }
        .lp-footer a { color: rgba(255,255,255,0.6); text-decoration: none; transition: color 0.15s; }
        .lp-footer a:hover { color: #fff; }

        html { scroll-behavior: smooth; }
    </style>
</head>
<body>

<!-- =========================================================================
     1. STICKY NAVIGATION BAR
     ========================================================================= -->
<nav class="lp-nav">
    <div class="container d-flex justify-content-between align-items-center">
        <a href="/" class="lp-logo">
            <span style="font-size:26px;">📚</span>
            <span>Language<span style="color:#0866ff;">Book</span></span>
        </a>
        <div class="d-none d-lg-flex gap-4 align-items-center">
            <a href="#about" class="text-dark text-decoration-none fw-semibold small">Giới thiệu</a>
            <a href="#luyenthi" class="text-primary text-decoration-none fw-bold small"><i class="bi bi-journal-check me-1"></i>Luyện thi online</a>
            <a href="#courses" class="text-dark text-decoration-none fw-semibold small">Khóa học</a>
            <a href="#achievements" class="text-dark text-decoration-none fw-semibold small">Thành tích học viên</a>
            <a href="#teachers" class="text-dark text-decoration-none fw-semibold small">Giảng viên</a>
            <a href="#faq" class="text-dark text-decoration-none fw-semibold small">Hỏi đáp</a>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <a href="/LuyenThi" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold d-none d-sm-inline-flex">
                <i class="bi bi-laptop me-1"></i>Thi thử Online
            </a>
            <a href="#register" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Đăng ký</a>
            <a href="/TaiKhoan/Login" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold" style="background:#0866ff;">
                Đăng nhập
            </a>
        </div>
    </div>
</nav>

<!-- =========================================================================
     2. HERO BANNER
     ========================================================================= -->
<section class="hero">
    <div class="hero-circle1"></div>
    <div class="hero-circle2"></div>
    <div class="container position-relative" style="z-index:1;">
        <div class="row align-items-center g-5 py-5">
            <div class="col-lg-7">
                <span class="hero-badge">
                    <i class="bi bi-award-fill text-warning"></i> Trung tâm ngoại ngữ quốc tế hàng đầu & Luyện thi thông minh
                </span>
                <h1 class="mb-4">Mở Rộng Cơ Hội<br/>Bứt Phá <span style="color:#a5c8ff;">Điểm Số Chuẩn</span></h1>
                <p class="lead mb-4">
                    Đào tạo toàn diện <strong>Tiếng Anh (IELTS, TOEIC) &bull; Tiếng Nhật &bull; Tiếng Hàn &bull; Tiếng Trung</strong>.<br/>
                    Cam kết chuẩn đầu ra bằng văn bản pháp lý &bull; Nền tảng luyện đề thi online chấm điểm tức thì.
                </p>
                <div class="d-flex flex-wrap gap-3 mb-5">
                    <a href="#register" class="btn-hero">
                        <i class="bi bi-pencil-square"></i> Đăng ký nhận ưu đãi 25%
                    </a>
                    <a href="/LuyenThi" class="btn-hero-outline">
                        <i class="bi bi-journal-check"></i> Thi thử miễn phí ngay
                    </a>
                </div>

                <!-- 4 Thống kê ấn tượng -->
                <div class="row g-2 text-center">
                    <div class="col-3">
                        <div class="stat-box">
                            <div class="num">5,000+</div>
                            <div class="lbl">Học viên theo học</div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="stat-box">
                            <div class="num">98.6%</div>
                            <div class="lbl">Đạt mục tiêu cam kết</div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="stat-box">
                            <div class="num">350K+</div>
                            <div class="lbl">Lượt luyện đề online</div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="stat-box">
                            <div class="num">15+</div>
                            <div class="lbl">Năm uy tín đào tạo</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="position-relative">
                    <img src="/images/anhtienganh/trung-tam-tieng-anh-wall-street-english.jpg" 
                         class="img-fluid rounded-4 shadow-lg w-100 border border-white border-3"
                         alt="Cơ sở vật chất chuẩn quốc tế tại LanguageBook" 
                         style="height:340px; object-fit:cover;" />
                    
                    <!-- Floating badge 1 -->
                    <div class="position-absolute bottom-0 start-0 m-3 p-3 bg-white rounded-3 shadow-lg border d-flex align-items-center gap-3" style="max-width:280px;">
                        <div class="rounded-circle bg-success bg-opacity-10 p-2 text-success fs-4">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div>
                            <div class="fw-bold small text-dark">Cam kết đầu ra 100%</div>
                            <div class="text-muted" style="font-size:11px;">Học lại hoàn toàn miễn phí nếu chưa đạt band điểm</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     3. 4 TRỤ CỘT CHẤT LƯỢNG (FEATURES)
     ========================================================================= -->
<section id="about" class="py-5 bg-white">
    <div class="container">
        <div class="text-center mb-5">
            <span class="badge bg-primary-subtle text-primary px-3 py-2 mb-2" style="font-size:13px;">⭐ Vì sao chọn chúng tôi</span>
            <h2 class="fw-bold fs-1">Chuẩn Mực Đào Tạo Quốc Tế</h2>
            <p class="text-muted">Phương pháp giảng dạy hiện đại kết hợp công nghệ giúp rút ngắn 50% thời gian học</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="feat-card">
                    <div class="feat-icon bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-patch-check-fill"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Cam kết chuẩn đầu ra</h5>
                    <p class="text-muted small mb-0">Hợp đồng đào tạo minh bạch. Học viên được hỗ trợ học lại miễn phí 100% nếu không đạt mục tiêu đề ra.</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="feat-card">
                    <div class="feat-icon bg-success bg-opacity-10 text-success">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Lớp sĩ số vàng 8-12 HV</h5>
                    <p class="text-muted small mb-0">Giảng viên theo sát từng học viên, sửa phát âm chi tiết, kèm cặp 1-1 với trợ giảng chất lượng cao.</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="feat-card">
                    <div class="feat-icon bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-journal-bookmark-fill"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Giáo trình chuẩn Cambridge</h5>
                    <p class="text-muted small mb-0">Giáo trình cập nhật liên tục từ Cambridge, Oxford, ETS & Hanban bám sát 100% đề thi thực tế tại IDP & BC.</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="feat-card">
                    <div class="feat-icon bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-laptop-fill"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Phòng luyện thi online</h5>
                    <p class="text-muted small mb-0">Hệ thống luyện đề thi trực tuyến thông minh: Tự động chấm điểm sau 1 giây, phân tích câu sai kèm lời giải chi tiết.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     4. PHÒNG LUYỆN THI ONLINE (GIỚI THIỆU THI THỬ TRỰC TUYẾN)
     ========================================================================= -->
<section id="luyenthi" class="py-5 exam-showcase-section">
    <div class="container">
        <div class="row align-items-center mb-5">
            <div class="col-lg-8">
                <span class="badge bg-primary text-white px-3 py-2 mb-2" style="font-size:12px;">💻 PHÒNG LUYỆN THI ONLINE</span>
                <h2 class="fw-bold fs-1 text-dark">Nền Tảng Luyện Đề Thi Trực Tuyến Độc Quyền</h2>
                <p class="text-muted">Luyện tập từng phần thi, làm bài full test và xem chi tiết câu sai kèm lý do giải thích chuẩn xác như thi thật.</p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a href="/LuyenThi" class="btn btn-primary rounded-pill px-4 py-2 fw-bold" style="background:#0866ff;">
                    Vào thư viện đề thi <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <!-- Featured Exams List -->
        @if (Model.DeThisHot.Any())
        {
            <div class="row g-3 mb-4">
                @foreach (var dt in Model.DeThisHot)
                {
                    <div class="col-lg-3 col-md-6">
                        <div class="exam-card-preview shadow-sm">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="badge bg-primary-subtle text-primary border" style="font-size:11px;">#@dt.TheLoai</span>
                                    <span class="badge bg-light text-secondary border" style="font-size:11px;">@dt.KyNang</span>
                                </div>
                                <h6 class="fw-bold text-dark mb-2" style="font-size:14px; line-height:1.4;">@dt.TieuDe</h6>
                                <div class="text-muted small mb-3">
                                    <div><i class="bi bi-clock me-1 text-primary"></i>@dt.ThoiGianPhut phút &bull; @dt.TongSoCau câu hỏi</div>
                                    <div class="mt-1"><i class="bi bi-people me-1 text-secondary"></i>@dt.SoLuotLam.ToString("N0") lượt luyện thi</div>
                                </div>
                            </div>
                            <div class="pt-2 border-top">
                                <a href="/LuyenThi/ChiTiet/@dt.MaDeThi" class="btn btn-outline-primary btn-sm w-100 rounded-pill fw-semibold">
                                    Thi thử ngay &rarr;
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- 3 Điểm vượt trội của hệ thống luyện đề -->
        <div class="row g-3 text-center">
            <div class="col-md-4">
                <div class="p-3 bg-white rounded-3 border">
                    <i class="bi bi-stopwatch text-primary fs-3 mb-2 d-block"></i>
                    <strong class="text-dark small d-block mb-1">Chấm điểm tức thì sau 1 giây</strong>
                    <span class="text-muted" style="font-size:12px;">Biết ngay số câu đúng, câu sai và tỷ lệ chính xác %</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-white rounded-3 border">
                    <i class="bi bi-lightbulb text-warning fs-3 mb-2 d-block"></i>
                    <strong class="text-dark small d-block mb-1">Lý do giải thích chi tiết từng câu</strong>
                    <span class="text-muted" style="font-size:12px;">Trích dẫn Transcript nghe, từ khóa đọc và phân tích ngữ pháp</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-white rounded-3 border">
                    <i class="bi bi-chat-heart text-danger fs-3 mb-2 d-block"></i>
                    <strong class="text-dark small d-block mb-1">Cộng đồng thảo luận sôi nổi</strong>
                    <span class="text-muted" style="font-size:12px;">Hỏi đáp trực tiếp dưới mỗi bài kiểm tra cùng giảng viên</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     5. CÁC KHÓA HỌC NỔI BẬT (COURSES)
     ========================================================================= -->
<section id="courses" class="py-5" style="background:#f7f8fa;">
    <div class="container">
        <div class="text-center mb-5">
            <span class="badge bg-primary-subtle text-primary px-3 py-2 mb-2" style="font-size:13px;">📖 Chương trình đào tạo</span>
            <h2 class="fw-bold fs-1">Khóa Học Nổi Bật & Ưu Đãi</h2>
            <p class="text-muted">Lộ trình học bài bản được thiết kế riêng cho người đi làm và học sinh - sinh viên</p>
        </div>

        @if (Model.KhoaHocs.Any())
        {
            <div class="row g-4">
                @foreach (var course in Model.KhoaHocs)
                {
                    <div class="col-lg-3 col-md-4 col-sm-6">
                        <div class="course-card">
                            <div class="course-card-img">
                                <img src="@ImageHelper.GetCourseImage(course.NgoaiNgu, course.TenKhoaHoc, course.MaKhoaHoc)" alt="@course.TenKhoaHoc" />
                                <div class="position-absolute top-0 start-0 p-2 d-flex gap-1">
                                    <span class="badge bg-primary" style="font-size:10px;">@course.NgoaiNgu</span>
                                    <span class="badge bg-warning text-dark fw-bold" style="font-size:10px;">@course.CapDo</span>
                                </div>
                            </div>
                            <div class="p-3 d-flex flex-column justify-content-between flex-grow-1">
                                <div>
                                    <h6 class="fw-bold mb-1 text-truncate" title="@course.TenKhoaHoc" style="font-size:14px;">@course.TenKhoaHoc</h6>
                                    <div class="text-muted small mb-2"><i class="bi bi-clock me-1"></i>@course.SoBuoi buổi học chuyên sâu</div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                    <div>
                                        <div class="fw-bold text-primary" style="font-size:15px;">@course.HocPhi.ToString("N0") ₫</div>
                                        <div class="text-muted text-decoration-line-through" style="font-size:11px;">@((course.HocPhi * 1.25m).ToString("N0")) ₫</div>
                                    </div>
                                    <a href="#register" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold" style="font-size:11px; background:#0866ff;">
                                        Đăng ký
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
