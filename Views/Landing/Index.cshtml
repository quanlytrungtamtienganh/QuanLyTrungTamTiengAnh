<!-- =========================================================================
     11. FORM ĐĂNG KÝ TÀI KHOẢN & TƯ VẤN (BẢO MẬT & REALTIME VALIDATION)
     ========================================================================= -->
<section id="register" class="py-5 register-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">
                <div class="register-card p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="mb-2" style="font-size:2.8rem;">🎓</div>
                        <h2 class="fw-bold mb-2">Đăng Ký Tài Khoản & Nhận Tư Vấn</h2>
                        <p class="text-muted small">
                            Gửi thông tin của bạn — Admin sẽ duyệt tài khoản và gửi thông tin đăng nhập về Gmail của bạn trong vòng <strong>24 giờ</strong>.
                        </p>
                    </div>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success rounded-3 d-flex align-items-start gap-2">
                            <i class="bi bi-check-circle-fill fs-5 mt-1 text-success"></i>
                            <div>@TempData["Success"]</div>
                        </div>
                    }
                    @if (TempData["Info"] != null)
                    {
                        <div class="alert alert-info rounded-3 d-flex align-items-start gap-2">
                            <i class="bi bi-info-circle-fill fs-5 mt-1"></i>
                            <div>@TempData["Info"]</div>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger rounded-3">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                        </div>
                    }

                    <form method="post" action="/Landing/GuiYeuCau" id="formDangKy" novalidate>
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Họ và tên <span class="text-danger">*</span></label>
                                <input type="text" name="hoTen" id="inputHoTen" class="form-control rounded-3" placeholder="Nguyễn Văn A" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Gmail <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input type="email" name="email" id="inputEmail" class="form-control rounded-3" 
                                           placeholder="example@gmail.com" required autocomplete="off" />
                                    <span class="input-group-text bg-white border-start-0 rounded-end-3" id="emailStatusIcon" style="border-left:none;"></span>
                                </div>
                                <div id="emailFeedback" class="mt-1" style="display:none;font-size:13px;"></div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Số điện thoại</label>
                                <div class="input-group">
                                    <input type="tel" name="soDienThoai" id="inputSDT" class="form-control rounded-3" 
                                           placeholder="0901 234 567" autocomplete="off" />
                                    <span class="input-group-text bg-white border-start-0 rounded-end-3" id="sdtStatusIcon" style="border-left:none;"></span>
                                </div>
                                <div id="sdtFeedback" class="mt-1" style="display:none;font-size:13px;"></div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Đăng ký với tư cách <span class="text-danger">*</span></label>
                                <select name="vaiTroMongMuon" class="form-select rounded-3" required>
                                    <option value="HocVien">🎓 Học viên</option>
                                    <option value="GiaoVien">👨‍🏫 Giáo viên / Giảng viên</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold small">Ghi chú thêm (tùy chọn)</label>
                                <textarea name="ghiChu" class="form-control rounded-3" rows="2"
                                          placeholder="Bạn muốn học khóa gì? Trình độ hiện tại? Mục tiêu của bạn?"></textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" id="btnGuiYeuCau" class="btn btn-primary w-100 py-3 fw-bold rounded-3" style="font-size:1rem; background:#0866ff;">
                                    <i class="bi bi-send-fill me-2"></i>Gửi yêu cầu tạo tài khoản
                                </button>
                            </div>
                        </div>
                    </form>

                    <script>
                    (function () {
                        let emailTimer = null, sdtTimer = null;
                        let emailOk = true, sdtOk = true;

                        function setFieldState(inputEl, iconEl, feedbackEl, state, msg) {
                            inputEl.classList.remove('is-invalid', 'is-valid');
                            feedbackEl.style.display = 'none';
                            iconEl.innerHTML = '';

                            if (state === 'loading') {
                                iconEl.innerHTML = '<span class="spinner-border spinner-border-sm text-secondary" style="width:14px;height:14px;"></span>';
                            } else if (state === 'ok') {
                                inputEl.classList.add('is-valid');
                                iconEl.innerHTML = '<i class="bi bi-check-circle-fill text-success" style="font-size:16px;"></i>';
                            } else if (state === 'error') {
                                inputEl.classList.add('is-invalid');
                                iconEl.innerHTML = '<i class="bi bi-x-circle-fill text-danger" style="font-size:16px;"></i>';
                                feedbackEl.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1 text-danger"></i><span class="text-danger fw-semibold">' + msg + '</span>';
                                feedbackEl.style.display = 'block';
                            }
                        }

                        function updateSubmitBtn() {
                            var btn = document.getElementById('btnGuiYeuCau');
                            if (!emailOk || !sdtOk) {
                                btn.disabled = true;
                                btn.classList.replace('btn-primary', 'btn-secondary');
                                btn.innerHTML = '<i class="bi bi-shield-x me-2"></i>Vui lòng kiểm tra lại thông tin';
                            } else {
                                btn.disabled = false;
                                btn.classList.replace('btn-secondary', 'btn-primary');
                                btn.innerHTML = '<i class="bi bi-send-fill me-2"></i>Gửi yêu cầu tạo tài khoản';
                            }
                        }

                        var emailInput = document.getElementById('inputEmail');
                        var emailIcon  = document.getElementById('emailStatusIcon');
                        var emailFeed  = document.getElementById('emailFeedback');

                        emailInput.addEventListener('input', function () {
                            clearTimeout(emailTimer);
                            var val = this.value.trim();
                            if (!val || !val.includes('@@')) {
                                setFieldState(this, emailIcon, emailFeed, 'idle', '');
                                emailOk = true; updateSubmitBtn(); return;
                            }
                            setFieldState(this, emailIcon, emailFeed, 'loading', '');
                            var self = this;
                            emailTimer = setTimeout(function () {
                                fetch('/Landing/KiemTraEmail?email=' + encodeURIComponent(val))
                                    .then(r => r.json())
                                    .then(data => {
                                        if (data.trung) {
                                            emailOk = false;
                                            setFieldState(self, emailIcon, emailFeed, 'error', data.thongBao);
                                        } else {
                                            emailOk = true;
                                            setFieldState(self, emailIcon, emailFeed, 'ok', '');
                                        }
                                        updateSubmitBtn();
                                    })
                                    .catch(() => { emailOk = true; setFieldState(self, emailIcon, emailFeed, 'idle', ''); updateSubmitBtn(); });
                            }, 600);
                        });

                        var sdtInput = document.getElementById('inputSDT');
                        var sdtIcon  = document.getElementById('sdtStatusIcon');
                        var sdtFeed  = document.getElementById('sdtFeedback');

                        sdtInput.addEventListener('input', function () {
                            clearTimeout(sdtTimer);
                            var val = this.value.replace(/\s/g, '').trim();
                            if (!val || val.length < 9) {
                                setFieldState(this, sdtIcon, sdtFeed, 'idle', '');
                                sdtOk = true; updateSubmitBtn(); return;
                            }
                            setFieldState(this, sdtIcon, sdtFeed, 'loading', '');
                            var self = this;
                            sdtTimer = setTimeout(function () {
                                fetch('/Landing/KiemTraSDT?soDienThoai=' + encodeURIComponent(val))
                                    .then(r => r.json())
                                    .then(data => {
                                        if (data.trung) {
                                            sdtOk = false;
                                            setFieldState(self, sdtIcon, sdtFeed, 'error', data.thongBao);
                                        } else {
                                            sdtOk = true;
                                            setFieldState(self, sdtIcon, sdtFeed, 'ok', '');
                                        }
                                        updateSubmitBtn();
                                    })
                                    .catch(() => { sdtOk = true; setFieldState(self, sdtIcon, sdtFeed, 'idle', ''); updateSubmitBtn(); });
                            }, 600);
                        });

                        document.getElementById('formDangKy').addEventListener('submit', function (e) {
                            if (!emailOk || !sdtOk) {
                                e.preventDefault();
                                return false;
                            }
                        });
                    })();
                    </script>

                    <div class="text-center mt-4 pt-3 border-top">
                        <span class="text-muted small">Đã có tài khoản?</span>
                        <a href="/TaiKhoan/Login" class="text-primary fw-bold ms-2">Đăng nhập ngay →</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

