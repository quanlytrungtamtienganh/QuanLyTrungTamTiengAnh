@model TrungTamNgoaiNgu.Models.KhoaHoc
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Xóa khóa học";
}

<div class="edu-page-header">
    <div>
        <h2 class="edu-page-title text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa khóa học</h2>
        <p class="edu-page-subtitle">Hành động này sẽ xóa dữ liệu khóa học khỏi hệ thống nếu không có lớp học liên kết</p>
    </div>
    <div>
        <a asp-action="Index" class="btn-edu btn-edu-outline">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="edu-card border-danger">
            <div class="alert alert-danger d-flex align-items-center mb-4">
                <i class="bi bi-shield-exclamation fs-3 me-3"></i>
                <div>
                    <strong>Cảnh báo quan trọng:</strong> Bạn có chắc chắn muốn xóa khóa học này không? Hành động này không thể hoàn tác!
                </div>
            </div>

            <div class="p-3 bg-light rounded-3 mb-4">
                <div class="row g-3">
                    <div class="col-sm-4 text-muted">Mã khóa học:</div>
                    <div class="col-sm-8 fw-bold">#KH-@Model.MaKhoaHoc</div>

                    <div class="col-sm-4 text-muted">Tên khóa học:</div>
                    <div class="col-sm-8 fw-semibold text-primary fs-5">@Model.TenKhoaHoc</div>

                    <div class="col-sm-4 text-muted">Ngoại ngữ:</div>
                    <div class="col-sm-8"><span class="edu-badge badge-info-soft">@Model.NgoaiNgu</span></div>

                    <div class="col-sm-4 text-muted">Cấp độ:</div>
                    <div class="col-sm-8">@Model.CapDo</div>

                    <div class="col-sm-4 text-muted">Học phí:</div>
                    <div class="col-sm-8 fw-bold text-success">@Model.HocPhi.ToString("N0") VNĐ</div>

                    <div class="col-sm-4 text-muted">Số lớp đang mở:</div>
                    <div class="col-sm-8">
                        @if (Model.LopHocs.Any())
                        {
                            <span class="badge bg-danger">@Model.LopHocs.Count lớp học đang phụ thuộc (Không thể xóa!)</span>
                        }
                        else
                        {
                            <span class="badge bg-success">0 lớp học (Được phép xóa an toàn)</span>
                        }
                    </div>
                </div>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MaKhoaHoc" />
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn-edu btn-edu-outline">Hủy bỏ</a>
                    <button type="submit" class="btn-edu btn-edu-danger" @(Model.LopHocs.Any() ? "disabled title='Vui lòng xóa các lớp học liên kết trước'" : "")>
                        <i class="bi bi-trash me-1"></i> Xác nhận xóa
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
