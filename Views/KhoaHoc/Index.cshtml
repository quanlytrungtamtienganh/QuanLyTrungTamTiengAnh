@model IEnumerable<TrungTamNgoaiNgu.Models.KhoaHoc>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý Khóa Học · Meta Business Suite";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-1 d-flex align-items-center gap-2">
            <i class="bi bi-journal-album text-primary"></i> Quản Lý Danh Mục Khóa Học
        </h3>
        <p class="text-muted mb-0 small">Danh mục các chương trình đào tạo, chứng chỉ và lộ trình ngoại ngữ của trung tâm</p>
    </div>
    <div>
        <a asp-action="Create" class="fb-btn fb-btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Thêm khóa học mới
        </a>
    </div>
</div>

<!-- Search Bar -->
<div class="fb-card p-3 mb-3">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-10">
            <input type="text" name="searchString" value="@ViewBag.SearchString" class="fb-input" placeholder="Tìm kiếm theo tên khóa học, ngôn ngữ hoặc cấp độ..." />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="fb-btn fb-btn-primary w-100">Tìm kiếm</button>
            @if (!string.IsNullOrEmpty(ViewBag.SearchString as string))
            {
                <a asp-action="Index" class="fb-btn fb-btn-secondary" title="Xóa bộ lọc"><i class="bi bi-x-lg"></i></a>
            }
        </div>
    </form>
</div>

<!-- Courses Directory Card -->
<div class="fb-card">
    <div class="fb-card-header">
        <div class="fw-bold text-dark d-flex align-items-center gap-2">
            <i class="bi bi-journal-check text-primary"></i> Danh sách @Model.Count() khóa học
        </div>
        <div class="text-muted small">
            LanguageBook Curriculum Registry
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="p-5 text-center text-muted">
            <i class="bi bi-journal-x fs-1 text-muted d-block mb-2"></i>
            <h6 class="fw-bold">Không tìm thấy khóa học nào</h6>
            <a asp-action="Create" class="fb-btn fb-btn-primary mt-2">+ Thêm khóa học đầu tiên</a>
        </div>
    }
    else
    {
        <div class="divide-y">
            @foreach (var item in Model)
            {
                <div class="p-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3 hover-bg">
                    <div class="d-flex align-items-start gap-3">
                        <div class="fb-avatar fb-avatar-lg" style="background: #e7f3ff; color: #0866ff;">
                            <i class="bi bi-journal-text fs-4"></i>
                        </div>

                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <a asp-action="Details" asp-route-id="@item.MaKhoaHoc" class="fw-bold fs-5 text-decoration-none text-dark">
                                    @item.TenKhoaHoc
                                </a>
                                <span class="badge bg-light text-dark border">@item.NgoaiNgu</span>
                                <span class="fb-badge fb-badge-blue">@item.CapDo</span>
                                
                                @if (item.TrangThai == "Đang mở")
                                {
                                    <span class="fb-badge fb-badge-green">Tuyển sinh</span>
                                }
                                else
                                {
                                    <span class="fb-badge fb-badge-red">Tạm dừng</span>
                                }
                            </div>

                            <p class="text-secondary small mb-2 text-truncate" style="max-width: 600px;">
                                @(string.IsNullOrEmpty(item.MoTa) ? "Chương trình đào tạo chuẩn quốc tế." : item.MoTa)
                            </p>

                            <div class="text-secondary small d-flex flex-wrap align-items-center gap-3">
                                <span>Thời lượng: <strong>@item.SoBuoi buổi</strong></span>
                                <span>Học phí: <strong class="text-primary">@item.HocPhi.ToString("N0") VNĐ</strong></span>
                                <span><i class="bi bi-people me-1"></i><strong>@item.LopHocs.Count</strong> lớp trực thuộc</span>
                            </div>
                        </div>
                    </div>

                    <!-- Right Actions -->
                    <div class="d-flex align-items-center gap-2">
                        <a asp-action="Details" asp-route-id="@item.MaKhoaHoc" class="fb-btn fb-btn-secondary fb-btn-sm">
                            Xem
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.MaKhoaHoc" class="fb-btn fb-btn-secondary fb-btn-sm">
                            Sửa
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.MaKhoaHoc" class="fb-btn fb-btn-outline fb-btn-sm text-danger">
                            Xóa
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>
