@model TrungTamNgoaiNgu.Models.LopHoc
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Mở lớp học mới";
}

<div class="edu-page-header">
    <div>
        <h2 class="edu-page-title"><i class="bi bi-plus-circle text-primary me-2"></i>Mở lớp học mới</h2>
        <p class="edu-page-subtitle">Thiết lập thông tin lịch học, phòng học và sĩ số tối đa cho lớp tuyển sinh</p>
    </div>
    <div>
        <a asp-action="Index" class="btn-edu btn-edu-outline">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="edu-card">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6 form-group">
                        <label asp-for="TenLop" class="form-label form-label-required"></label>
                        <input asp-for="TenLop" class="form-control" placeholder="Ví dụ: ENG-IELTS-K37" autofocus />
                        <span asp-validation-for="TenLop" class="field-validation-error"></span>
                    </div>

                    <div class="col-md-6 form-group">
                        <label asp-for="MaKhoaHoc" class="form-label form-label-required"></label>
                        <select asp-for="MaKhoaHoc" asp-items="ViewBag.MaKhoaHoc" class="form-select"></select>
                        <span asp-validation-for="MaKhoaHoc" class="field-validation-error"></span>
                    </div>

                    <div class="col-md-12 form-group">
                        <label asp-for="MaGiaoVien" class="form-label">Giáo viên phụ trách giảng dạy</label>
                        <select asp-for="MaGiaoVien" asp-items="ViewBag.MaGiaoVien" class="form-select">
                            <option value="">-- Chưa phân công giáo viên --</option>
                        </select>
                        <span asp-validation-for="MaGiaoVien" class="field-validation-error"></span>
                    </div>

                    <div class="col-md-4 form-group">
                        <label asp-for="NgayKhaiGiang" class="form-label form-label-required"></label>
                        <input asp-for="NgayKhaiGiang" type="date" class="form-control" />
                        <span asp-validation-for="NgayKhaiGiang" class="field-validation-error"></span>
                    </div>

                    <div class="col-md-4 form-group">
                        <label asp-for="LichHoc" class="form-label form-label-required"></label>
                        <input asp-for="LichHoc" class="form-control" placeholder="Tối 2-4-6 (18:30 - 20:00)" />
                        <span asp-validation-for="LichHoc" class="field-validation-error"></span>
                    </div>

                    <div class="col-md-4 form-group">
                        <label asp-for="PhongHoc" class="form-label form-label-required"></label>
                        <input asp-for="PhongHoc" class="form-control" placeholder="Phòng A.201" />
                        <span asp-validation-for="PhongHoc" class="field-validation-error"></span>
                    </div>

                    <div class="col-md-4 form-group">
                        <label asp-for="SoLuongToiDa" class="form-label form-label-required"></label>
                        <input asp-for="SoLuongToiDa" type="number" class="form-control" min="1" max="100" />
                        <span asp-validation-for="SoLuongToiDa" class="field-validation-error"></span>
                    </div>

                    <div class="col-md-4 form-group">
                        <label asp-for="HocPhi" class="form-label form-label-required"></label>
                        <div class="input-group">
                            <input asp-for="HocPhi" type="number" step="50000" class="form-control" />
                            <span class="input-group-text bg-light">VNĐ</span>
                        </div>
                        <span asp-validation-for="HocPhi" class="field-validation-error"></span>
                    </div>

                    <div class="col-md-4 form-group">
                        <label asp-for="TrangThai" class="form-label form-label-required"></label>
                        <select asp-for="TrangThai" class="form-select">
                            <option value="Đang tuyển sinh">Đang tuyển sinh</option>
                            <option value="Đang học">Đang học</option>
                            <option value="Đã kết thúc">Đã kết thúc</option>
                            <option value="Đã hủy">Đã hủy</option>
                        </select>
                        <span asp-validation-for="TrangThai" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn-edu btn-edu-outline">Hủy bỏ</a>
                    <button type="submit" class="btn-edu btn-edu-primary">
                        <i class="bi bi-check-circle me-1"></i> Mở lớp học
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
