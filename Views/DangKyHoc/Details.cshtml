@model TrungTamNgoaiNgu.Models.DangKyHoc
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chi tiết lượt đăng ký #" + Model.MaDangKy;
}

<div class="edu-page-header">
    <div>
        <h2 class="edu-page-title"><i class="bi bi-file-earmark-text-fill text-primary me-2"></i>Chi tiết phiếu đăng ký #DK-@Model.MaDangKy</h2>
        <p class="edu-page-subtitle">Thông tin học viên ghi danh và lớp học tương ứng</p>
    </div>
    <div>
        <a asp-action="Index" class="btn-edu btn-edu-outline">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-lg-8">
        <div class="edu-card">
            <div class="edu-card-header">
                <h5 class="edu-card-title">Phiếu ghi danh học viên</h5>
                <span>
                    @if (Model.TrangThai == "Đã xác nhận")
                    {
                        <span class="edu-badge badge-success-soft"><i class="bi bi-check-circle-fill"></i> Đã xác nhận</span>
                    }
                    else if (Model.TrangThai == "Chờ xác nhận")
                    {
                        <span class="edu-badge badge-warning-soft"><i class="bi bi-hourglass-split"></i> Chờ xác nhận</span>
                    }
                    else
                    {
                        <span class="edu-badge badge-danger-soft"><i class="bi bi-x-circle-fill"></i> Đã hủy</span>
                    }
                </span>
            </div>

            <!-- Học viên -->
            <h6 class="fw-bold text-primary mb-3"><i class="bi bi-person me-1"></i> Thông tin học viên</h6>
            <div class="p-3 bg-light rounded-3 mb-4">
                <div class="row g-2">
                    <div class="col-sm-4 text-muted">Họ và tên:</div>
                    <div class="col-sm-8 fw-semibold">@(Model.HocVien?.HoTen ?? "—")</div>

                    <div class="col-sm-4 text-muted">Số điện thoại:</div>
                    <div class="col-sm-8">@(Model.HocVien?.SoDienThoai ?? "—")</div>

                    <div class="col-sm-4 text-muted">Email:</div>
                    <div class="col-sm-8">@(Model.HocVien?.Email ?? "—")</div>

                    <div class="col-sm-4 text-muted">Địa chỉ:</div>
                    <div class="col-sm-8">@(Model.HocVien?.DiaChi ?? "—")</div>
                </div>
            </div>

            <!-- Lớp học & Khóa học -->
            <h6 class="fw-bold text-primary mb-3"><i class="bi bi-easel me-1"></i> Lớp học đăng ký</h6>
            <div class="p-3 bg-light rounded-3 mb-4">
                <div class="row g-2">
                    <div class="col-sm-4 text-muted">Tên lớp học:</div>
                    <div class="col-sm-8 fw-bold text-dark">@(Model.LopHoc?.TenLop ?? "—")</div>

                    <div class="col-sm-4 text-muted">Khóa học:</div>
                    <div class="col-sm-8">@(Model.LopHoc?.KhoaHoc?.TenKhoaHoc ?? "—")</div>

                    <div class="col-sm-4 text-muted">Lịch học:</div>
                    <div class="col-sm-8">@(Model.LopHoc?.LichHoc ?? "—")</div>

                    <div class="col-sm-4 text-muted">Phòng học:</div>
                    <div class="col-sm-8">@(Model.LopHoc?.PhongHoc ?? "—")</div>

                    <div class="col-sm-4 text-muted">Ngày khai giảng:</div>
                    <div class="col-sm-8">@(Model.LopHoc?.NgayKhaiGiang.ToString("dd/MM/yyyy") ?? "—")</div>

                    <div class="col-sm-4 text-muted">Học phí:</div>
                    <div class="col-sm-8 fw-bold text-success fs-5">@Model.HocPhi.ToString("N0") VNĐ</div>

                    <div class="col-sm-4 text-muted">Thời điểm đăng ký:</div>
                    <div class="col-sm-8">@Model.NgayDangKy.ToString("dd/MM/yyyy HH:mm:ss")</div>
                </div>
            </div>

            <!-- Nút hành động cho Admin -->
            <div class="d-flex justify-content-end gap-2 border-top pt-3">
                @if (Model.TrangThai == "Chờ xác nhận")
                {
                    <form asp-action="XacNhan" asp-route-id="@Model.MaDangKy" method="post" onsubmit="return confirm('Xác nhận học viên vào lớp?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-edu btn-edu-success">
                            <i class="bi bi-check-circle me-1"></i> Xác nhận đăng ký
                        </button>
                    </form>

                    <form asp-action="HuyDangKy" asp-route-id="@Model.MaDangKy" method="post" onsubmit="return confirm('Hủy lượt đăng ký này?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-edu btn-edu-danger">
                            <i class="bi bi-x-circle me-1"></i> Hủy đăng ký
                        </button>
                    </form>
                }
                else if (Model.TrangThai == "Đã xác nhận")
                {
                    <form asp-action="HuyDangKy" asp-route-id="@Model.MaDangKy" method="post" onsubmit="return confirm('Hủy lượt đăng ký đã duyệt này?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-edu btn-edu-outline text-danger">
                            <i class="bi bi-x-circle me-1"></i> Hủy đăng ký
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
