@model IEnumerable<TrungTamNgoaiNgu.Models.DangKyHoc>
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "Đơn Đăng Ký Của Tôi · LanguageBook";
    var openCount = Model.Count(d => d.TrangThai == "Chờ xác nhận");
    var closedCount = Model.Count(d => d.TrangThai == "Đã xác nhận");
    var cancelledCount = Model.Count(d => d.TrangThai == "Đã hủy");
}

<div class="container-xl py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-bookmark-check-fill text-primary"></i> Đơn đăng ký & Khóa học đã lưu
            </h3>
            <p class="text-muted mb-0 small">Theo dõi trạng thái xét duyệt nhập học và lịch sử ghi danh của bạn</p>
        </div>
        <div>
            <a href="/LopHoc" class="fb-btn fb-btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Đăng ký lớp mới
            </a>
        </div>
    </div>

    <!-- Facebook Activity Log Box -->
    <div class="fb-card">
        <div class="fb-card-header">
            <div class="d-flex align-items-center gap-3">
                <span class="fb-badge fb-badge-yellow">
                    <i class="bi bi-hourglass-split me-1"></i> @openCount Chờ duyệt
                </span>
                <span class="fb-badge fb-badge-green">
                    <i class="bi bi-check-circle-fill me-1"></i> @closedCount Đã xác nhận
                </span>
                @if (cancelledCount > 0)
                {
                    <span class="fb-badge fb-badge-red">
                        <i class="bi bi-x-circle me-1"></i> @cancelledCount Đã hủy
                    </span>
                }
            </div>

            <div class="text-muted small">
                Tổng cộng @Model.Count() phiếu đăng ký
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-inbox fs-1 text-muted d-block mb-2"></i>
                <h5 class="fw-bold">Bạn chưa có đơn đăng ký nào</h5>
                <p class="small text-muted">Hãy khám phá các lớp học đang mở để gửi yêu cầu giữ chỗ ngay hôm nay.</p>
                <a href="/LopHoc" class="fb-btn fb-btn-primary mt-2">Xem lịch mở lớp</a>
            </div>
        }
        else
        {
            <div class="divide-y">
                @foreach (var item in Model.OrderByDescending(d => d.NgayDangKy))
                {
                    <div class="p-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3 hover-bg">
                        <div class="d-flex align-items-start gap-3">
                            <div class="fb-avatar fb-avatar-lg" style="background: #e7f3ff; color: #0866ff;">
                                <i class="bi bi-file-earmark-text-fill fs-4"></i>
                            </div>

                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="fw-bold fs-5 text-dark">Lớp: @(item.LopHoc?.TenLop ?? "—")</span>
                                    <span class="badge bg-light text-dark border">@(item.LopHoc?.KhoaHoc?.TenKhoaHoc ?? "—")</span>
                                    
                                    @if (item.TrangThai == "Đã xác nhận")
                                    {
                                        <span class="fb-badge fb-badge-green"><i class="bi bi-check-circle-fill me-1"></i>Đã duyệt</span>
                                    }
                                    else if (item.TrangThai == "Chờ xác nhận")
                                    {
                                        <span class="fb-badge fb-badge-yellow"><i class="bi bi-hourglass-split me-1"></i>Chờ xác nhận</span>
                                    }
                                    else
                                    {
                                        <span class="fb-badge fb-badge-red"><i class="bi bi-x-circle me-1"></i>Đã hủy</span>
                                    }
                                </div>

                                <div class="text-secondary small d-flex flex-wrap align-items-center gap-3">
                                    <span>Mã đơn: <strong class="font-monospace text-primary">#DK-@item.MaDangKy.ToString("D4")</strong></span>
                                    <span>Ngày gửi: <strong>@item.NgayDangKy.ToString("dd/MM/yyyy HH:mm")</strong></span>
                                    <span>Học phí: <strong class="text-success">@((item.LopHoc?.HocPhi ?? 0).ToString("N0")) VNĐ</strong></span>
                                    <span>Lịch học: <strong>@(item.LopHoc?.LichHoc ?? "—")</strong></span>
                                    <span>Phòng: <strong>@(item.LopHoc?.PhongHoc ?? "—")</strong></span>
                                </div>
                            </div>
                        </div>

                        <!-- Right Actions -->
                        <div class="d-flex align-items-center gap-2">
                            @if (item.TrangThai == "Chờ xác nhận")
                            {
                                <form asp-action="Huy" asp-route-id="@item.MaDangKy" method="post" onsubmit="return confirm('Bạn có chắc muốn hủy đăng ký lớp này?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="fb-btn fb-btn-outline fb-btn-sm text-danger">
                                        <i class="bi bi-x-lg me-1"></i> Hủy đăng ký
                                    </button>
                                </form>
                            }
                            @if (item.LopHoc != null)
                            {
                                <a asp-controller="LopHoc" asp-action="Details" asp-route-id="@item.LopHoc.MaLop" class="fb-btn fb-btn-secondary fb-btn-sm">
                                    Xem lớp học
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
