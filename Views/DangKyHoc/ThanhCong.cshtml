@model TrungTamNgoaiNgu.Models.DangKyHoc
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "Đăng Ký Khóa Học Thành Công · LanguageBook";
}

<div class="container py-4">
    <!-- 4.16. Quy trình 5 bước trực quan -->
    <div class="fb-card p-3 mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 text-center" style="font-size: 0.9rem;">
            <div class="d-flex align-items-center gap-2 text-success fw-bold">
                <span class="badge bg-success rounded-circle p-2"><i class="bi bi-check-lg"></i></span>
                <span>1. Chọn lớp</span>
            </div>
            <i class="bi bi-chevron-right text-muted d-none d-md-inline"></i>

            <div class="d-flex align-items-center gap-2 text-success fw-bold">
                <span class="badge bg-success rounded-circle p-2"><i class="bi bi-check-lg"></i></span>
                <span>2. Xem thông tin lớp</span>
            </div>
            <i class="bi bi-chevron-right text-muted d-none d-md-inline"></i>

            <div class="d-flex align-items-center gap-2 text-success fw-bold">
                <span class="badge bg-success rounded-circle p-2"><i class="bi bi-check-lg"></i></span>
                <span>3. Nhấn "Đăng ký"</span>
            </div>
            <i class="bi bi-chevron-right text-muted d-none d-md-inline"></i>

            <div class="d-flex align-items-center gap-2 text-success fw-bold">
                <span class="badge bg-success rounded-circle p-2"><i class="bi bi-check-lg"></i></span>
                <span>4. Xác nhận đăng ký</span>
            </div>
            <i class="bi bi-chevron-right text-muted d-none d-md-inline"></i>

            <div class="d-flex align-items-center gap-2 text-primary fw-bold">
                <span class="badge bg-primary rounded-circle p-2"><i class="bi bi-trophy-fill"></i></span>
                <span class="text-decoration-underline">5. Đăng ký thành công</span>
            </div>
        </div>
    </div>

    <!-- Success Celebration Card -->
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="fb-card p-4 text-center mb-4">
                <div class="mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success-subtle text-success" style="width: 80px; height: 80px;">
                        <i class="bi bi-check-circle-fill" style="font-size: 48px;"></i>
                    </div>
                </div>

                <h3 class="fw-bold text-success mb-2">Đăng Ký Khóa Học Thành Công!</h3>
                <p class="text-muted mb-4">
                    Hồ sơ đăng ký của bạn đã được tiếp nhận vào hệ thống của trung tâm. Ban Quản Trị sẽ sớm liên hệ xác nhận và hướng dẫn nhập học.
                </p>

                <div class="p-4 bg-light rounded-3 text-start mb-4 border">
                    <div class="row g-3">
                        <div class="col-sm-4 text-muted">Mã hồ sơ đăng ký:</div>
                        <div class="col-sm-8 fw-bold font-monospace text-primary fs-5">#DK-@Model.MaDangKy.ToString("D4")</div>

                        <div class="col-sm-4 text-muted">Học viên đăng ký:</div>
                        <div class="col-sm-8 fw-semibold text-dark">@(Model.HocVien?.HoTen ?? "—")</div>

                        <div class="col-sm-4 text-muted">Khóa học:</div>
                        <div class="col-sm-8 fw-bold text-dark">@(Model.LopHoc?.KhoaHoc?.TenKhoaHoc ?? "—")</div>

                        <div class="col-sm-4 text-muted">Lớp học:</div>
                        <div class="col-sm-8 fw-semibold text-primary">@(Model.LopHoc?.TenLop ?? "—")</div>

                        <div class="col-sm-4 text-muted">Lịch học & Phòng:</div>
                        <div class="col-sm-8">@(Model.LopHoc?.LichHoc ?? "—") (@(Model.LopHoc?.PhongHoc ?? "—"))</div>

                        <div class="col-sm-4 text-muted">Ngày khai giảng:</div>
                        <div class="col-sm-8 fw-semibold">@(Model.LopHoc != null ? Model.LopHoc.NgayKhaiGiang.ToString("dd/MM/yyyy") : "—")</div>

                        <div class="col-sm-4 text-muted">Giảng viên phụ trách:</div>
                        <div class="col-sm-8">@(Model.LopHoc?.GiaoVien?.HoTen ?? "Trung tâm phân công")</div>

                        <div class="col-sm-4 text-muted">Học phí:</div>
                        <div class="col-sm-8 fw-bold text-success fs-5">@Model.HocPhi.ToString("N0") VNĐ</div>

                        <div class="col-sm-4 text-muted">Trạng thái hồ sơ:</div>
                        <div class="col-sm-8">
                            <span class="fb-badge fb-badge-yellow"><i class="bi bi-hourglass-split me-1"></i>Chờ xác nhận</span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a asp-controller="DangKyHoc" asp-action="History" class="fb-btn fb-btn-primary">
                        <i class="bi bi-clock-history me-1"></i> Xem lịch sử hồ sơ của tôi
                    </a>
                    <a asp-controller="LopHoc" asp-action="Index" class="fb-btn fb-btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Xem danh sách lớp học khác
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
