@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tạo Tài Khoản Giáo Viên Mới · Meta Business Suite";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="fw-bold mb-1 d-flex align-items-center gap-2">
                    <i class="bi bi-person-plus-fill text-primary"></i> Tạo Tài Khoản Giáo Viên Mới
                </h3>
                <p class="text-muted mb-0 small">Cấp thông tin đăng nhập và hồ sơ giảng dạy cho giáo viên tại trung tâm</p>
            </div>
            <a asp-action="Index" class="fb-btn fb-btn-secondary">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>

        <div class="fb-card p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <h6 class="text-primary fw-bold border-bottom pb-2 mb-3">
                            <i class="bi bi-shield-lock me-1"></i> 1. Thông tin tài khoản đăng nhập
                        </h6>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Tên đăng nhập <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-person-circle text-muted"></i></span>
                            <input type="text" name="tenDangNhap" class="form-control" placeholder="VD: giaovien.lananh" required />
                        </div>
                        <small class="text-muted">Sử dụng để đăng nhập vào cổng giáo viên.</small>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Mật khẩu khởi tạo <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-key-fill text-muted"></i></span>
                            <input type="password" name="matKhau" class="form-control" value="123456" required />
                        </div>
                        <small class="text-muted">Mặc định ban đầu: <code>123456</code> (giáo viên có thể đổi sau).</small>
                    </div>

                    <div class="col-12 mt-4">
                        <h6 class="text-primary fw-bold border-bottom pb-2 mb-3">
                            <i class="bi bi-person-vcard me-1"></i> 2. Hồ sơ chuyên môn giảng viên
                        </h6>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Họ và tên giáo viên <span class="text-danger">*</span></label>
                        <input type="text" name="hoTen" class="form-control" placeholder="VD: Thầy Nguyễn Văn Minh" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Bộ môn / Chuyên môn đào tạo <span class="text-danger">*</span></label>
                        <select name="chuyenMon" class="form-select" required>
                            <option value="Tiếng Anh (IELTS)">Tiếng Anh (IELTS Intensive)</option>
                            <option value="Tiếng Anh (Giao tiếp)">Tiếng Anh (Giao tiếp Quốc tế)</option>
                            <option value="Tiếng Nhật (JLPT)">Tiếng Nhật (JLPT N5 - N1)</option>
                            <option value="Tiếng Trung (HSK)">Tiếng Trung (HSK 1 - 6)</option>
                            <option value="Tiếng Hàn (TOPIK)">Tiếng Hàn (TOPIK 1 - 6)</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Học vị / Chứng chỉ quốc tế</label>
                        <input type="text" name="hocVi" class="form-control" placeholder="VD: Thạc sĩ TESOL / IELTS 8.5" value="Thạc sĩ Sư phạm Ngoại ngữ" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Số điện thoại liên hệ</label>
                        <input type="text" name="soDienThoai" class="form-control" placeholder="VD: 0988.123.456" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Email cơ quan / liên hệ</label>
                        <input type="email" name="email" class="form-control" placeholder="VD: minh.nguyen@educenter.edu.vn" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Link ảnh đại diện (Avatar URL)</label>
                        <input type="text" name="anhDaiDien" class="form-control" placeholder="https://..." value="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80" />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Giới thiệu ngắn / Kinh nghiệm giảng dạy</label>
                        <textarea name="gioiThieu" class="form-control" rows="3" placeholder="Mô tả phong cách giảng dạy, thành tích học viên, kinh nghiệm thực tế..."></textarea>
                    </div>

                    <div class="col-12 mt-4 d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="fb-btn fb-btn-secondary">Hủy bỏ</a>
                        <button type="submit" class="fb-btn fb-btn-primary">
                            <i class="bi bi-check-lg me-1"></i> Lưu và Tạo tài khoản giáo viên
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
