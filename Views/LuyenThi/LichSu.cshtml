@model List<TrungTamNgoaiNgu.Models.KetQuaLuyenThi>
@{
    ViewData["Title"] = "Lịch sử luyện thi của bạn";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="container-fluid px-lg-5 py-4" style="background:#f8fafc; min-height: 90vh;">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-clock-history text-primary me-2"></i>Lịch sử luyện thi của bạn
            </h1>
            <p class="text-muted small">Xem lại danh sách các bài thi đã làm, điểm số và xem lại chi tiết lời giải.</p>
        </div>
        <a href="/LuyenThi" class="btn btn-primary rounded-pill px-4 fw-semibold" style="background:#2563eb;">
            <i class="bi bi-journal-plus me-1"></i>Luyện đề thi mới
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <i class="bi bi-inbox fs-1 text-muted mb-3 d-block"></i>
            <h5 class="fw-bold text-dark">Bạn chưa làm bài kiểm tra nào</h5>
            <p class="text-muted small mb-4">Hãy bắt đầu làm một bài kiểm tra để đánh giá trình độ hiện tại của mình.</p>
            <div>
                <a href="/LuyenThi" class="btn btn-primary px-4 rounded-pill">Vào thư viện đề thi</a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small">
                        <tr>
                            <th>Đề thi</th>
                            <th>Chế độ / Phần thi</th>
                            <th class="text-center">Số câu đúng</th>
                            <th class="text-center">Độ chính xác</th>
                            <th class="text-center">Thời gian làm</th>
                            <th>Ngày nộp</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @foreach (var k in Model)
                        {
                            var m = Math.Floor((double)k.ThoiGianLamGiay / 60);
                            var s = k.ThoiGianLamGiay % 60;
                            var timeStr = $"{(m < 10 ? "0" : "")}{m}:{(s < 10 ? "0" : "")}{s}";
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@(k.DeThi?.TieuDe ?? "Đề thi")</div>
                                    <span class="badge bg-light text-secondary border small">@(k.DeThi?.TheLoai ?? "IELTS")</span>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                        @k.CheDoLam
                                    </span>
                                    <div class="text-muted small mt-1">@k.CacPhanDaLam</div>
                                </td>
                                <td class="text-center">
                                    <strong class="text-success">@k.SoCauDung</strong>/@k.TongSoCau
                                </td>
                                <td class="text-center">
                                    <span class="badge @(k.DoChinhXac >= 70 ? "bg-success" : (k.DoChinhXac >= 50 ? "bg-warning text-dark" : "bg-danger")) px-2 py-1">
                                        @k.DoChinhXac%
                                    </span>
                                </td>
                                <td class="text-center text-muted">
                                    <i class="bi bi-stopwatch me-1"></i>@timeStr
                                </td>
                                <td class="text-muted">
                                    @k.NgayNop.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="text-end">
                                    <a href="/LuyenThi/KetQua/@k.MaKetQua" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                        <i class="bi bi-eye me-1"></i>Xem lại & Lời giải
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
