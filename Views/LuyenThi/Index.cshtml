@model TrungTamNgoaiNgu.ViewModels.LuyenThiIndexViewModel
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Thư viện đề thi online · LanguageBook";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    var userName = HttpContextAccessor.HttpContext?.Session?.GetString("HoTen") ?? "Học viên";
    var userLogin = HttpContextAccessor.HttpContext?.Session?.GetString("TenDangNhap") ?? "user";
    var isLoggedIn = !string.IsNullOrEmpty(HttpContextAccessor.HttpContext?.Session?.GetString("HoTen"));

    var categories = new[] {
        new { Key = "TatCa", Label = "Tất cả đề thi (40 đề)", Icon = "bi-collection-fill", Bg = "#e7f3ff", Color = "#0866ff" },
        new { Key = "TOEIC", Label = "Tiếng Anh (TOEIC)", Icon = "bi-award-fill", Bg = "#fef7e0", Color = "#f7b125" },
        new { Key = "JLPT", Label = "Tiếng Nhật (JLPT)", Icon = "bi-book-half", Bg = "#f0e6ff", Color = "#9360f7" },
        new { Key = "HSK", Label = "Tiếng Trung (HSK)", Icon = "bi-translate", Bg = "#fde8e8", Color = "#e41e3f" },
        new { Key = "TOPIK", Label = "Tiếng Hàn (TOPIK)", Icon = "bi-globe", Bg = "#e0f2fe", Color = "#0284c7" }
    };
}

<div class="container-fluid px-lg-4 py-3">
    <div class="row g-3">
        <!-- =========================================================================
             1. LEFT COLUMN: FACEBOOK SHORTCUTS SIDEBAR (ĐỒNG BỘ 100% MENU CHÍNH)
             ========================================================================= -->
        <div class="col-lg-3 col-xl-3 d-none d-lg-block">
            <div class="fb-sidebar">
                <!-- User Profile Card -->
                <a href="@(isLoggedIn ? "/TaiKhoan/Profile" : "/TaiKhoan/Login")" class="fb-sidebar-item mb-2">
                    <div class="fb-avatar" style="background:#0866ff; color:#fff;">
                        @(!string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "U")
                    </div>
                    <div class="d-flex flex-column text-truncate">
                        <span class="fw-bold text-truncate" style="font-size:14px;">@userName</span>
                        <span class="text-muted" style="font-size:11px;">Học viên LanguageBook</span>
                    </div>
                </a>

                <div class="fb-sidebar-title text-uppercase" style="font-size:11px; letter-spacing:0.5px;">Phòng luyện thi online</div>

                <a href="/LuyenThi?theLoai=TatCa" class="fb-sidebar-item @(Model.TheLoaiHienTai == "TatCa" ? "active" : "")">
                    <div class="fb-sidebar-icon" style="background: #e7f3ff; color: #0866ff;">
                        <i class="bi bi-collection-play-fill"></i>
                    </div>
                    <span>Tất cả kho đề thi (@Model.TongSoDe)</span>
                </a>

                <a href="/LuyenThi/LichSu" class="fb-sidebar-item">
                    <div class="fb-sidebar-icon" style="background: #fef7e0; color: #f7b125;">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <span>Lịch sử luyện thi của tôi</span>
                </a>

                <hr class="my-2" style="border-color: #e4e6eb;" />

                <div class="fb-sidebar-title text-uppercase" style="font-size:11px; letter-spacing:0.5px;">Chứng chỉ 4 ngôn ngữ</div>

                <a href="/LuyenThi?theLoai=TOEIC" class="fb-sidebar-item @(Model.TheLoaiHienTai.Contains("TOEIC") ? "active" : "")">
                    <div class="fb-sidebar-icon" style="background: #fef7e0; color: #f7b125;">
                        <i class="bi bi-award-fill"></i>
                    </div>
                    <span>Tiếng Anh (TOEIC 200 câu)</span>
                </a>

                <a href="/LuyenThi?theLoai=JLPT" class="fb-sidebar-item @(Model.TheLoaiHienTai.Contains("JLPT") || Model.TheLoaiHienTai == "N" ? "active" : "")">
                    <div class="fb-sidebar-icon" style="background: #f0e6ff; color: #9360f7;">
                        <i class="bi bi-book-half"></i>
                    </div>
                    <span>Tiếng Nhật (JLPT 200 câu)</span>
                </a>

                <a href="/LuyenThi?theLoai=HSK" class="fb-sidebar-item @(Model.TheLoaiHienTai.Contains("HSK") ? "active" : "")">
                    <div class="fb-sidebar-icon" style="background: #fde8e8; color: #e41e3f;">
                        <i class="bi bi-translate"></i>
                    </div>
                    <span>Tiếng Trung (HSK 200 câu)</span>
                </a>

                <a href="/LuyenThi?theLoai=TOPIK" class="fb-sidebar-item @(Model.TheLoaiHienTai.Contains("TOPIK") ? "active" : "")">
                    <div class="fb-sidebar-icon" style="background: #e0f2fe; color: #0284c7;">
                        <i class="bi bi-globe"></i>
                    </div>
                    <span>Tiếng Hàn (TOPIK 200 câu)</span>
                </a>

                <hr class="my-2" style="border-color: #e4e6eb;" />

                <div class="fb-sidebar-title text-uppercase" style="font-size:11px; letter-spacing:0.5px;">Tiện ích bổ trợ</div>

                <a href="/KhoaHoc/Catalog" class="fb-sidebar-item">
                    <div class="fb-sidebar-icon" style="background: #e7f3ff; color: #0866ff;">
                        <i class="bi bi-journal-album"></i>
                    </div>
                    <span>Khóa học bồi dưỡng chuyên sâu</span>
                </a>

                <a href="/LopHoc" class="fb-sidebar-item">
                    <div class="fb-sidebar-icon" style="background: #f0e6ff; color: #9360f7;">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <span>Nhóm học tập & Lịch lớp</span>
                </a>
            </div>
        </div>

        <!-- =========================================================================
             2. CENTER COLUMN: EXAM LIBRARY (ĐỒNG BỘ FORM FACEBOOK CARD)
             ========================================================================= -->
        <div class="col-lg-6 col-xl-6">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show rounded-3 shadow-sm mb-3 d-flex align-items-center" role="alert">
                    <i class="bi bi-shield-exclamation text-warning fs-4 me-2"></i>
                    <div class="small fw-semibold">@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Header Filter & Search Card (FB Style) -->
            <div class="fb-card mb-3">
                <div class="fb-card-header d-flex justify-content-between align-items-center">
                    <div class="fb-card-title">
                        <i class="bi bi-journal-check text-primary fs-4"></i>
                        <span>Thư viện đề thi trực tuyến</span>
                    </div>
                    <span class="fb-badge fb-badge-blue">@Model.TongSoDe đề có sẵn</span>
                </div>

                <div class="fb-card-body p-3">
                    <!-- Search input form -->
                    <form method="get" action="/LuyenThi" class="mb-3">
                        <input type="hidden" name="theLoai" value="@Model.TheLoaiHienTai" />
                        <div class="d-flex gap-2">
                            <div class="fb-search-box flex-grow-1 w-100" style="width:100%!important;">
                                <i class="bi bi-search fb-search-icon"></i>
                                <input type="text" name="tuKhoa" value="@Model.TuKhoa" class="fb-search-input" 
                                       placeholder="Tìm kiếm theo tên đề thi, kỹ năng, dạng bài..." />
                            </div>
                            <button type="submit" class="fb-btn fb-btn-primary fw-semibold px-3" style="border-radius: var(--fb-radius-pill);">
                                Tìm
                            </button>
                        </div>
                    </form>

                    <!-- Category Pills Scrollable -->
                    <div class="d-flex gap-1 overflow-x-auto pb-1" style="white-space: nowrap; scrollbar-width: none;">
                        @foreach (var cat in categories)
                        {
                            var isActive = Model.TheLoaiHienTai == cat.Key || (cat.Key != "TatCa" && Model.TheLoaiHienTai.Contains(cat.Key));
                            <a href="/LuyenThi?theLoai=@cat.Key" 
                               class="btn btn-sm rounded-pill px-3 fw-semibold @(isActive ? "btn-primary" : "btn-light text-secondary")"
                               style="font-size:12px; @(isActive ? "background:#0866ff; border-color:#0866ff;" : "")">
                                @cat.Label
                            </a>
                        }
                    </div>

                    <!-- Secondary Tabs (Tất cả / Đề rút gọn) -->
                    <div class="d-flex border-top mt-3 pt-2 gap-3" style="font-size:13px;">
                        <a href="/LuyenThi?theLoai=@Model.TheLoaiHienTai&tab=TatCa" 
                           class="text-decoration-none fw-bold pb-1 @(Model.Tab == "TatCa" ? "border-bottom border-primary border-2 text-primary" : "text-secondary")">
                            Tất cả đề thi (@Model.TongSoDe)
                        </a>
                        <a href="/LuyenThi?theLoai=@Model.TheLoaiHienTai&tab=DeRutGon" 
                           class="text-decoration-none fw-bold pb-1 @(Model.Tab == "DeRutGon" ? "border-bottom border-primary border-2 text-primary" : "text-secondary")">
                            Đề thi rút gọn & Test nhanh
                        </a>
                    </div>
                </div>
            </div>

            <!-- List of Exam Cards (FB Style) -->
            @if (!Model.DeThis.Any())
            {
                <div class="fb-card text-center p-5">
                    <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
                    <h5 class="fw-bold text-dark">Chưa có đề thi phù hợp</h5>
                    <p class="text-muted small">Hãy thử tìm kiếm với từ khóa khác hoặc chuyển sang danh mục đề khác.</p>
                    <a href="/LuyenThi" class="btn btn-sm btn-outline-primary rounded-pill px-4">Xem tất cả đề thi</a>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var dt in Model.DeThis)
                    {
                        var soPhan = dt.PhanThis?.Count ?? 0;
                        var soBinhLuan = dt.BinhLuans?.Count ?? 0;
                        var isListening = dt.KyNang != null && dt.KyNang.Contains("Listening");

                        <div class="fb-card mb-0 shadow-sm">
                            <div class="fb-card-header d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2 text-truncate">
                                    <div class="fb-avatar fb-avatar-sm" style="@(isListening ? "background:#e7f3ff; color:#0866ff;" : "background:#e7f8ec; color:#31a24c;")">
                                        <i class="bi @(isListening ? "bi-headphones" : "bi-book")"></i>
                                    </div>
                                    <span class="fw-bold text-dark text-truncate" style="font-size:14.5px;">@dt.TieuDe</span>
                                </div>
                                <div class="d-flex gap-1 flex-shrink-0">
                                    <span class="fb-badge fb-badge-blue">@dt.TheLoai</span>
                                    <span class="fb-badge fb-badge-green">@dt.KyNang</span>
                                </div>
                            </div>

                            <div class="fb-card-body p-3">
                                @if (!string.IsNullOrEmpty(dt.MoTa))
                                {
                                    <p class="text-muted small mb-3 text-truncate-2" style="font-size:13px; line-height:1.5;">@dt.MoTa</p>
                                }

                                <!-- Meta Info Row -->
                                <div class="row g-2 text-center mb-3">
                                    <div class="col-3">
                                        <div class="p-2 rounded bg-light border">
                                            <div class="text-muted" style="font-size:11px;"><i class="bi bi-clock me-1 text-primary"></i>Thời gian</div>
                                            <strong class="text-dark small">@dt.ThoiGianPhut phút</strong>
                                        </div>
                                    </div>
                                    <div class="col-3">
                                        <div class="p-2 rounded bg-light border">
                                            <div class="text-muted" style="font-size:11px;"><i class="bi bi-list-ol me-1 text-success"></i>Số phần</div>
                                            <strong class="text-dark small">@soPhan phần</strong>
                                        </div>
                                    </div>
                                    <div class="col-3">
                                        <div class="p-2 rounded bg-light border">
                                            <div class="text-muted" style="font-size:11px;"><i class="bi bi-question-circle me-1 text-warning"></i>Số câu</div>
                                            <strong class="text-dark small">@dt.TongSoCau câu</strong>
                                        </div>
                                    </div>
                                    <div class="col-3">
                                        <div class="p-2 rounded bg-light border">
                                            <div class="text-muted" style="font-size:11px;"><i class="bi bi-people me-1 text-secondary"></i>Lượt thi</div>
                                            <strong class="text-dark small">@dt.SoLuotLam.ToString("N0")</strong>
                                        </div>
                                    </div>
                                </div>

                                <!-- Features badges -->
                                <div class="d-flex flex-wrap gap-2 align-items-center mb-1">
                                    @if (isListening)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border" style="font-size:11px;"><i class="bi bi-headphones me-1"></i>Có bài nghe Audio</span>
                                    }
                                    <span class="text-muted" style="font-size:12px;"><i class="bi bi-check2-all text-success me-1"></i>Chấm điểm tự động</span>
                                    <span class="text-muted" style="font-size:12px;"><i class="bi bi-lightbulb-fill text-warning me-1"></i>Có giải thích chi tiết</span>
                                    <span class="text-muted" style="font-size:12px;"><i class="bi bi-chat-dots text-info me-1"></i>@soBinhLuan bình luận</span>
                                </div>
                            </div>

                            <div class="fb-card-footer p-2 bg-light border-top d-flex justify-content-between align-items-center">
                                <span class="text-muted small ps-2" style="font-size:11.5px;">Cập nhật format chuẩn 2026</span>
                                <a href="/LuyenThi/ChiTiet/@dt.MaDeThi" class="btn btn-sm btn-primary rounded-pill px-4 fw-bold" style="background:#0866ff; border-color:#0866ff;">
                                    Chi tiết & Luyện tập <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- =========================================================================
             3. RIGHT COLUMN: WIDGETS & USER STATS (ĐỒNG BỘ 100% MENU CHÍNH)
             ========================================================================= -->
        <div class="col-lg-3 col-xl-3 d-none d-lg-block">
            <!-- User Widget Card -->
            <div class="fb-card mb-3">
                <div class="fb-card-header">
                    <div class="fb-card-title" style="font-size:15px;">
                        <i class="bi bi-person-circle text-primary"></i> Tiến độ cá nhân
                    </div>
                </div>
                <div class="fb-card-body p-3 text-center">
                    <div class="fb-avatar fb-avatar-lg mx-auto mb-2" style="background:#0866ff; color:#fff; font-size:22px;">
                        @(!string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "U")
                    </div>
                    <div class="fw-bold text-dark fs-6">@userName</div>
                    <div class="text-muted small mb-3">@@@userLogin</div>

                    <div class="alert alert-warning border-0 small py-2 px-3 mb-3 text-start" style="background:#fffbeb; color:#92400e; font-size:12px;">
                        <i class="bi bi-bullseye me-1 text-warning"></i>
                        Đặt mục tiêu điểm số giúp bạn tăng 40% hiệu suất ôn luyện mỗi ngày.
                    </div>

                    <a href="/LuyenThi/LichSu" class="btn btn-outline-primary btn-sm w-100 rounded-pill fw-semibold py-2">
                        <i class="bi bi-clock-history me-1"></i>Xem lịch sử làm bài
                    </a>
                </div>
            </div>

            <!-- Bảng Vàng Vinh Danh Điểm Cao -->
            <div class="fb-card mb-3">
                <div class="fb-card-header">
                    <div class="fb-card-title" style="font-size:15px;">
                        <i class="bi bi-trophy-fill text-warning"></i> Bảng vàng tuần này
                    </div>
                </div>
                <div class="fb-card-body p-2">
                    <div class="d-flex align-items-center justify-content-between p-2 rounded hover-bg">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-warning text-dark fw-bold" style="font-size:11px;">#1</span>
                            <div class="fb-avatar fb-avatar-sm" style="background:#31a24c; color:#fff;">N</div>
                            <div class="small">
                                <div class="fw-bold">Nguyễn Hoàng Nam</div>
                                <span class="text-muted" style="font-size:11px;">IELTS 8.5 (Listening 9.0)</span>
                            </div>
                        </div>
                        <span class="badge bg-success" style="font-size:10px;">39/40</span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between p-2 rounded hover-bg">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-secondary text-white fw-bold" style="font-size:11px;">#2</span>
                            <div class="fb-avatar fb-avatar-sm" style="background:#0866ff; color:#fff;">V</div>
                            <div class="small">
                                <div class="fw-bold">Trần Thảo Vy</div>
                                <span class="text-muted" style="font-size:11px;">TOEIC Test 01</span>
                            </div>
                        </div>
                        <span class="badge bg-primary" style="font-size:10px;">965/990</span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between p-2 rounded hover-bg">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-secondary text-white fw-bold" style="font-size:11px;">#3</span>
                            <div class="fb-avatar fb-avatar-sm" style="background:#9360f7; color:#fff;">A</div>
                            <div class="small">
                                <div class="fw-bold">Lê Phương Anh</div>
                                <span class="text-muted" style="font-size:11px;">JLPT N2 Mock Test</span>
                            </div>
                        </div>
                        <span class="badge bg-info text-dark" style="font-size:10px;">168/180</span>
                    </div>
                </div>
            </div>

            <!-- Group Thảo Luận Facebook Style -->
            <div class="fb-card mb-3 p-3 text-center">
                <i class="bi bi-chat-quote-fill text-primary fs-2 mb-2 d-block"></i>
                <h6 class="fw-bold small text-dark mb-1">Cộng đồng Luyện Đề LanguageBook</h6>
                <p class="text-muted small mb-3" style="font-size:12px;">Hơn 45,000 thành viên trao đổi đáp án, giải thích chi tiết và chia sẻ forecast đề thi mỗi ngày.</p>
                <a href="#discuss" class="btn btn-sm btn-outline-primary rounded-pill w-100 fw-semibold">
                    <i class="bi bi-people-fill me-1"></i>Tham gia thảo luận
                </a>
            </div>
        </div>
    </div>
</div>
