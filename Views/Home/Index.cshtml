@model TrungTamNgoaiNgu.ViewModels.HomeViewModel
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "Bảng tin · LanguageBook";
    var userName = HttpContextAccessor.HttpContext?.Session.GetString("HoTen") ?? "Bạn";
    var userRole = HttpContextAccessor.HttpContext?.Session.GetString("VaiTro");
    var currentUserId = HttpContextAccessor.HttpContext?.Session.GetInt32("MaTaiKhoan");
    var isLoggedIn = !string.IsNullOrEmpty(HttpContextAccessor.HttpContext?.Session.GetString("HoTen"));
    var isAdmin = userRole == "Admin";
}

<div class="container-fluid px-lg-4 py-3">
    <div class="row g-3">
        <!-- =========================================================================
             1. LEFT COLUMN: FACEBOOK SHORTCUTS SIDEBAR
             ========================================================================= -->
        <div class="col-lg-3 col-xl-3 d-none d-lg-block">
            <div class="fb-sidebar">
                <!-- User Profile Shortcut -->
                <a href="@(isLoggedIn ? "/TaiKhoan/Profile" : "/TaiKhoan/Login")" class="fb-sidebar-item mb-1">
                    <div class="fb-avatar">
                        @(!string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "U")
                    </div>
                    <span class="text-truncate">@userName</span>
                </a>

                <a href="/KhoaHoc/Catalog" class="fb-sidebar-item">
                    <div class="fb-sidebar-icon" style="background: #e7f3ff; color: #0866ff;">
                        <i class="bi bi-collection-play-fill"></i>
                    </div>
                    <span>Kho khóa học & Video</span>
                </a>

                <a href="/LopHoc" class="fb-sidebar-item">
                    <div class="fb-sidebar-icon" style="background: #f0e6ff; color: #9360f7;">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <span>Nhóm & Lịch lớp học</span>
                </a>

                <a href="/LuyenThi" class="fb-sidebar-item">
                    <div class="fb-sidebar-icon" style="background: #e0f2fe; color: #0284c7;">
                        <i class="bi bi-journal-check"></i>
                    </div>
                    <span>Luyện thi online</span>
                </a>

                @if (isLoggedIn && userRole == "HocVien")
                {
                    <a href="/DangKyHoc/History" class="fb-sidebar-item">
                        <div class="fb-sidebar-icon" style="background: #e7f8ec; color: #31a24c;">
                            <i class="bi bi-bookmark-check-fill"></i>
                        </div>
                        <span>Đơn đã lưu & Đăng ký</span>
                    </a>
                }

                @if (isLoggedIn && userRole == "GiaoVien")
                {
                    <a href="/GiaoVien/LichDay" class="fb-sidebar-item">
                        <div class="fb-sidebar-icon" style="background: #e7f3ff; color: #0866ff;">
                            <i class="bi bi-calendar-check-fill"></i>
                        </div>
                        <span>Lịch giảng dạy cá nhân</span>
                    </a>
                }

                <a href="/HocVien" class="fb-sidebar-item">
                    <div class="fb-sidebar-icon" style="background: #fef7e0; color: #f7b125;">
                        <i class="bi bi-person-badge-fill"></i>
                    </div>
                    <span>Cộng đồng học viên (@Model.TotalStudents)</span>
                </a>

                @if (isLoggedIn && userRole == "Admin")
                {
                    <a href="/ThongKe" class="fb-sidebar-item">
                        <div class="fb-sidebar-icon" style="background: #fde8e8; color: #e41e3f;">
                            <i class="bi bi-speedometer2"></i>
                        </div>
                        <span>Bảng tin Quản trị viên</span>
                    </a>
                }

                <hr class="my-2" style="border-color: #e4e6eb;" />

                <!-- Trung tâm shortcuts -->
                <div class="fb-sidebar-title">Lối tắt của bạn</div>

                <a href="/KhoaHoc/Catalog?ngoaiNgu=Tiếng Anh" class="fb-sidebar-item">
                    <div class="fb-sidebar-icon" style="background: #e4e6eb;">
                        🇬🇧
                    </div>
                    <span>CLB Tiếng Anh & IELTS</span>
                </a>

                <a href="/KhoaHoc/Catalog?ngoaiNgu=Tiếng Nhật" class="fb-sidebar-item">
                    <div class="fb-sidebar-icon" style="background: #e4e6eb;">
                        🇯🇵
                    </div>
                    <span>Cộng đồng Tiếng Nhật JLPT</span>
                </a>

                <a href="/KhoaHoc/Catalog?ngoaiNgu=Tiếng Trung" class="fb-sidebar-item">
                    <div class="fb-sidebar-icon" style="background: #e4e6eb;">
                        🇨🇳
                    </div>
                    <span>Hội luyện thi HSK Cấp tốc</span>
                </a>

                <div class="px-2 pt-3 text-muted" style="font-size: 11px; line-height: 1.6;">
                    Quyền riêng tư &bull; Điều khoản &bull; Quảng cáo &bull; Lựa chọn quảng cáo &bull; Cookie &bull; Xem thêm &bull; Meta &copy; 2026
                </div>
            </div>
        </div>

        <!-- =========================================================================
             2. CENTER COLUMN: FACEBOOK NEWSFEED
             ========================================================================= -->
        <div class="col-lg-6 col-xl-6 col-12">
            <!-- 2.1 Facebook Stories Carousel -->
            <div class="fb-stories-container">
                <!-- Story 1: Campus 5 Sao -->
                <a href="/KhoaHoc/Catalog" class="fb-story-card" style="background-image: url('/images/anhtienganh/trung-tam-tieng-anh-wall-street-english.jpg');">
                    <div class="fb-story-avatar" style="border-color: #fff; background: #0866ff; color: #fff;">
                        <i class="bi bi-star-fill text-white fs-6"></i>
                    </div>
                    <div class="fb-story-name">Campus 5 Sao</div>
                </a>

                <!-- Story 2: IELTS -->
                <a href="/KhoaHoc/Catalog?searchTerm=IELTS" class="fb-story-card" style="background-image: url('/images/anhtienganh/trung-tam-tieng-anh-idt-1342029.jpg');">
                    <div class="fb-story-avatar" style="background: #e41e3f; color: #fff;">IE</div>
                    <div class="fb-story-name">IELTS 7.5+ Học bổng</div>
                </a>

                <!-- Story 3: Tiếng Anh Giao Tiếp -->
                <a href="/KhoaHoc/Catalog?ngoaiNgu=Tiếng Anh" class="fb-story-card" style="background-image: url('/images/anhtienganh/ttta-1.jpg');">
                    <div class="fb-story-avatar" style="background: #11998e; color: #fff;">EN</div>
                    <div class="fb-story-name">Lớp tương tác 1:1</div>
                </a>

                <!-- Story 4: Tiếng Trung -->
                <a href="/KhoaHoc/Catalog?ngoaiNgu=Tiếng Trung" class="fb-story-card" style="background-image: url('/images/anhtienganh/tiengtrung1.jpg');">
                    <div class="fb-story-avatar" style="background: #8e2de2; color: #fff;">CN</div>
                    <div class="fb-story-name">Lớp Tiếng Trung HSK</div>
                </a>

                <!-- Story 5: Tiếng Hàn -->
                <a href="/KhoaHoc/Catalog?ngoaiNgu=Tiếng Hàn" class="fb-story-card" style="background-image: url('/images/anhtienganh/tienghan.jpg');">
                    <div class="fb-story-avatar" style="background: #f857a6; color: #fff;">KR</div>
                    <div class="fb-story-name">CLB Tiếng Hàn TOPIK</div>
                </a>
            </div>

            <!-- 2.2 Facebook "Tạo bài viết" Box (Đăng bài cho Học viên, Giáo viên, Quản lý) -->
            <div class="fb-create-post-card">
                <div class="fb-create-post-top">
                    <div class="fb-avatar">
                        @(!string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "U")
                    </div>
                    <div class="fb-create-post-input" onclick="openCreatePostModal()" role="button" tabindex="0">
                        @userName ơi, bạn đang nghĩ gì thế? Chia sẻ bài viết ngay...
                    </div>
                </div>
                <div class="fb-create-post-actions">
                    <button type="button" class="fb-action-item btn border-0 bg-transparent text-secondary p-0" onclick="openCreatePostModal('photo')">
                        <i class="bi bi-images text-success fs-5"></i>
                        <span>Ảnh / Video</span>
                    </button>
                    <button type="button" class="fb-action-item btn border-0 bg-transparent text-secondary p-0" onclick="openCreatePostModal('background')">
                        <i class="bi bi-palette-fill text-danger fs-5"></i>
                        <span>Phông nền màu</span>
                    </button>
                    <button type="button" class="fb-action-item btn border-0 bg-transparent text-secondary p-0" onclick="openCreatePostModal('bold')">
                        <i class="bi bi-type-bold text-primary fs-5"></i>
                        <span>Tô đậm chữ</span>
                    </button>
                </div>
            </div>

            <!-- 2.2.1 Thanh điều khiển Kiểm duyệt bài viết (Dành cho Quản trị viên / Admin) -->
            @if (isAdmin)
            {
                <div class="fb-mod-card" id="adminModerationBar">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary px-2 py-1"><i class="bi bi-shield-check me-1"></i>QUẢN TRỊ VIÊN</span>
                            <div class="form-check form-switch m-0 d-flex align-items-center gap-2">
                                <input class="form-check-input" type="checkbox" role="switch" id="toggleApprovalSwitch" onchange="togglePostApproval(this.checked)" style="cursor: pointer; width: 2.2em; height: 1.2em;">
                                <label class="form-check-label small fw-semibold" for="toggleApprovalSwitch" id="toggleApprovalLabel">Đang tải...</label>
                            </div>
                        </div>
                        <div>
                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill fw-semibold py-1 px-3" onclick="openAdminReportsModal()">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>Báo cáo sai phạm
                                <span class="badge bg-danger ms-1" id="topReportBadge">0</span>
                            </button>
                        </div>
                    </div>
                    <div class="d-flex gap-2 border-top pt-2">
                        <button type="button" class="btn btn-sm btn-light active rounded-pill px-3 filter-feed-btn" data-filter="all" onclick="filterFeed('all', this)">
                            Tất cả bài viết
                        </button>
                        <button type="button" class="btn btn-sm btn-light rounded-pill px-3 filter-feed-btn position-relative" data-filter="pending" onclick="filterFeed('pending', this)">
                            Bài chờ duyệt
                            <span class="badge bg-warning text-dark ms-1" id="topPendingBadge">0</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-light rounded-pill px-3 filter-feed-btn" data-filter="reported" onclick="filterFeed('reported', this)">
                            Có báo cáo vi phạm
                        </button>
                    </div>
                </div>
            }

            <!-- 2.2.2 Container Bài viết người dùng đăng tải -->
            <div id="fbUserPostsContainer">
                <div class="text-center py-4 text-muted">
                    <div class="spinner-border spinner-border-sm text-primary mb-2"></div>
                    <div class="small">Đang tải bài viết cộng đồng...</div>
                </div>
            </div>

            <!-- 2.3 Post Feed: Khóa học nổi bật dạng bài viết Facebook -->
            @foreach (var kh in Model.FeaturedCourses)
            {
                <article class="fb-post" id="post-@kh.MaKhoaHoc">
                    <!-- Post Header -->
                    <div class="fb-post-header">
                        <div class="fb-post-author">
                            <div class="fb-avatar" style="background: #ffffff; border: 1px solid #e4e6eb; padding: 2px;">
                                <img src="~/images/logo.png" alt="Logo" style="width: 100%; height: 100%; object-fit: contain;" />
                            </div>
                            <div>
                                <div class="fb-author-name">
                                    LanguageBook Academy
                                    <i class="bi bi-patch-check-fill fb-verified-badge" title="Trang đào tạo đã xác minh"></i>
                                </div>
                                <div class="fb-post-meta">
                                    <span>Được tài trợ</span> &bull;
                                    <span>2 giờ trước</span> &bull;
                                    <i class="bi bi-globe-americas"></i>
                                </div>
                            </div>
                        </div>
                        <div>
                            <button class="btn btn-sm btn-light border-0 rounded-circle text-muted" type="button" title="Tùy chọn bài viết">
                                <i class="bi bi-three-dots"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Post Body / Content Text -->
                    <div class="fb-post-body">
                        <p class="mb-2">
                            🔥 <strong>[@kh.NgoaiNgu.ToUpper()] KHÓA HỌC: @kh.TenKhoaHoc.ToUpper()</strong> 🔥
                        </p>
                        <p class="mb-2 text-secondary">
                            @kh.MoTa
                        </p>
                        <div class="d-flex flex-wrap gap-2 my-2">
                            <span class="fb-badge fb-badge-blue"><i class="bi bi-mortarboard-fill me-1"></i>Chuẩn CEFR: @kh.CapDo</span>
                            <span class="fb-badge fb-badge-green"><i class="bi bi-clock-history me-1"></i>Thời lượng: @kh.SoBuoi buổi</span>
                            <span class="fb-badge fb-badge-yellow"><i class="bi bi-translate me-1"></i>Ngôn ngữ: @kh.NgoaiNgu</span>
                        </div>
                        <div class="small text-primary fw-semibold mt-2">
                            #LanguageBook #KhoaHocNgoaiNgu #@kh.NgoaiNgu.Replace(" ", "") #@kh.CapDo
                        </div>
                    </div>

                    <!-- Post Media / Preview Card -->
                    <div class="fb-post-media">
                        @{
                            string bannerImg = ImageHelper.GetCourseImage(kh.NgoaiNgu, kh.TenKhoaHoc, kh.MaKhoaHoc);
                        }
                        <div class="position-relative overflow-hidden" style="max-height: 380px; background: #000;">
                            <img src="@bannerImg" alt="@kh.TenKhoaHoc" class="w-100" style="max-height: 360px; object-fit: cover; display: block;" />
                            <div class="position-absolute top-0 start-0 w-100 p-3 d-flex justify-content-between align-items-start" style="background: linear-gradient(180deg, rgba(0,0,0,0.65) 0%, transparent 100%);">
                                <span class="badge bg-danger px-3 py-2 fs-6 fw-bold shadow-sm"><i class="bi bi-fire me-1"></i>CHỈ CÒN VÀI SUẤT</span>
                                <span class="badge bg-light text-dark px-2 py-1 shadow-sm"><i class="bi bi-award-fill text-warning me-1"></i>Khóa học tiêu biểu</span>
                            </div>
                            <div class="position-absolute bottom-0 start-0 w-100 p-3 text-white" style="background: linear-gradient(0deg, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 60%, transparent 100%);">
                                <h4 class="fw-bold text-white mb-1">@kh.TenKhoaHoc</h4>
                                <div class="text-light opacity-90 small"><i class="bi bi-geo-alt-fill text-danger me-1"></i>Cơ sở 5★ hiện đại &bull; Trực tiếp hoặc Online tương tác 1:1</div>
                            </div>
                        </div>

                        <!-- Call to Action Banner -->
                        <div class="fb-post-media-content d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div>
                                <div class="text-uppercase text-muted" style="font-size: 11px; font-weight: 700;">HỌC PHÍ NIÊM YẾT CHÍNH THỨC</div>
                                <div class="fw-bold fs-5 text-primary">@kh.HocPhi.ToString("N0") VNĐ</div>
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-controller="KhoaHoc" asp-action="Details" asp-route-id="@kh.MaKhoaHoc" class="fb-btn fb-btn-primary">
                                    <i class="bi bi-send-check me-1"></i> Đăng ký học ngay
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Post Stats (Reactions & Comments) -->
                    <div class="fb-post-stats">
                        <div class="d-flex align-items-center gap-2">
                            <div class="fb-reactions-icons">
                                <span class="fb-reaction-icon fb-reaction-like"><i class="bi bi-hand-thumbs-up-fill"></i></span>
                                <span class="fb-reaction-icon fb-reaction-love"><i class="bi bi-heart-fill"></i></span>
                            </div>
                            <span>148 người khác</span>
                        </div>
                        <div class="d-flex gap-3 text-muted">
                            <a href="#comments-@kh.MaKhoaHoc" class="text-muted text-decoration-none" data-bs-toggle="collapse" role="button">
                                @(kh.BinhLuans?.Count ?? 0) bình luận
                            </a>
                            <span>15 lượt chia sẻ</span>
                        </div>
                    </div>

                    <!-- Post Action Buttons (Like, Comment, Share, Register) -->
                    <div class="fb-post-actions-bar">
                        <button class="fb-post-action-btn active-liked" type="button">
                            <i class="bi bi-hand-thumbs-up-fill"></i>
                            <span>Thích</span>
                        </button>
                        <a href="#comments-@kh.MaKhoaHoc" class="fb-post-action-btn" data-bs-toggle="collapse" role="button">
                            <i class="bi bi-chat-square"></i>
                            <span>Bình luận (@(kh.BinhLuans?.Count ?? 0))</span>
                        </a>
                        <button class="fb-post-action-btn" type="button">
                            <i class="bi bi-share"></i>
                            <span>Chia sẻ</span>
                        </button>
                        <a asp-controller="KhoaHoc" asp-action="Details" asp-route-id="@kh.MaKhoaHoc" class="fb-post-action-btn text-primary fw-bold">
                            <i class="bi bi-box-arrow-up-right"></i>
                            <span>Xem lớp</span>
                        </a>
                    </div>

                    <!-- Comments Section (Facebook Comment Bubbles & Input) -->
                    <div class="collapse show p-3 pt-2 border-top bg-light-subtle" id="comments-@kh.MaKhoaHoc">
                        <!-- Comments List -->
                        @if (kh.BinhLuans != null && kh.BinhLuans.Any())
                        {
                            <div class="d-flex flex-column gap-2 mb-3">
                                @foreach (var bl in kh.BinhLuans.OrderBy(b => b.NgayBinhLuan))
                                {
                                    var isCommentOwner = currentUserId.HasValue && bl.MaTaiKhoan == currentUserId.Value;
                                    var canDelete = isAdmin || isCommentOwner;

                                    <div class="d-flex align-items-start gap-2">
                                        <!-- User Avatar -->
                                        <div class="fb-avatar fb-avatar-sm flex-shrink-0" style="background: @(bl.TaiKhoan?.VaiTro == "Admin" ? "#0866ff" : "#42b72a"); color: #fff;">
                                            @(bl.TaiKhoan?.HoTen != null && bl.TaiKhoan.HoTen.Length > 0 ? bl.TaiKhoan.HoTen.Substring(0, 1).ToUpper() : "U")
                                        </div>

                                        <div class="flex-grow-1">
                                            <!-- Comment Bubble -->
                                            <div class="p-2 px-3 rounded-4 d-inline-block position-relative" style="background-color: #f0f2f5; max-width: 95%;">
                                                <div class="d-flex align-items-center gap-2 mb-1">
                                                    <span class="fw-bold small text-dark">@(bl.TaiKhoan?.HoTen ?? "Người dùng")</span>
                                                    @if (bl.TaiKhoan?.VaiTro == "Admin")
                                                    {
                                                        <span class="badge bg-primary" style="font-size: 9px; padding: 1px 5px;">Quản trị viên</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success" style="font-size: 9px; padding: 1px 5px;">Học viên</span>
                                                    }
                                                </div>
                                                <div class="small text-dark" style="word-break: break-word;">
                                                    @bl.NoiDung
                                                </div>
                                            </div>

                                            <!-- Comment Actions (Time & Delete Button) -->
                                            <div class="d-flex align-items-center gap-3 ms-2 mt-1 text-muted" style="font-size: 11px;">
                                                <span>@bl.NgayBinhLuan.ToString("dd/MM HH:mm")</span>
                                                <span class="fw-semibold text-secondary" style="cursor: pointer;">Thích</span>
                                                
                                                @if (canDelete)
                                                {
                                                    <form asp-controller="BinhLuan" asp-action="Delete" asp-route-id="@bl.MaBinhLuan" method="post" class="d-inline m-0 p-0" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bình luận này?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="returnUrl" value="/#post-@kh.MaKhoaHoc" />
                                                        <button type="submit" class="border-0 bg-transparent text-danger p-0 fw-semibold" style="font-size: 11px; cursor: pointer;">
                                                            <i class="bi bi-trash3 me-1"></i>Xóa
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <!-- Add Comment Form -->
                        @if (isLoggedIn)
                        {
                            <form asp-controller="BinhLuan" asp-action="Create" method="post" class="d-flex align-items-center gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="maKhoaHoc" value="@kh.MaKhoaHoc" />
                                <input type="hidden" name="returnUrl" value="/#post-@kh.MaKhoaHoc" />

                                <div class="fb-avatar fb-avatar-sm flex-shrink-0">
                                    @(!string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "U")
                                </div>

                                <div class="position-relative flex-grow-1">
                                    <input type="text" name="noiDung" class="fb-input py-1 px-3 pe-5 rounded-pill" style="font-size: 13px;" placeholder="Viết bình luận cho khóa học này..." required />
                                    <button type="submit" class="position-absolute end-0 top-50 translate-middle-y me-2 border-0 bg-transparent text-primary" title="Gửi bình luận">
                                        <i class="bi bi-send-fill fs-6"></i>
                                    </button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="p-2 text-center text-muted small bg-white rounded border">
                                <i class="bi bi-chat-quote me-1 text-primary"></i> 
                                <a href="/TaiKhoan/Login?returnUrl=/#post-@kh.MaKhoaHoc" class="text-primary fw-bold text-decoration-none">Đăng nhập</a> để tham gia bình luận cùng học viên và quản trị viên.
                            </div>
                        }
                    </div>
                </article>
            }

            @if (!Model.FeaturedCourses.Any())
            {
                <div class="fb-card p-4 text-center text-muted">
                    <i class="bi bi-journal-x fs-1 d-block mb-2 text-secondary"></i>
                    <h5>Chưa có bài viết hoặc khóa học nào hiển thị</h5>
                </div>
            }
        </div>

        <!-- =========================================================================
             3. RIGHT COLUMN: FACEBOOK SPONSORED & ONLINE CONTACTS
             ========================================================================= -->
        <div class="col-lg-3 col-xl-3 d-none d-lg-block">
            <div class="fb-sidebar">
                <!-- 3.1 Được tài trợ (Sponsored Ads) -->
                <div class="fb-sidebar-title">Được tài trợ</div>
                <div class="fb-card p-2 mb-3">
                    <div class="d-flex gap-2 align-items-center mb-2">
                        <div class="rounded overflow-hidden" style="width: 80px; height: 60px; flex-shrink: 0;">
