@section Scripts {
<script>
    // State variables
    let post_currentFeedFilter = 'all';
    let post_selectedBackground = null;
    let post_selectedImageFile = null;
    let post_selectedVideoFile = null;
    let post_isUserLoggedIn = @(isLoggedIn ? "true" : "false");
    let post_isUserAdmin = @(isAdmin ? "true" : "false");
    let post_cachedPosts = {};

    // Tự động tải bài viết ngay khi script sẵn sàng hoặc DOMContentLoaded
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () {
            loadNewsFeed('all');
        });
    } else {
        loadNewsFeed('all');
    }

    // =========================================================================
    // 1. TẢI DANH SÁCH BÀI VIẾT (GET FEED)
    // =========================================================================
    function loadNewsFeed(filter = 'all') {
        post_currentFeedFilter = filter;
        const container = document.getElementById('fbUserPostsContainer');
        if (!container) return;

        container.innerHTML = `
            <div class="text-center py-4 text-muted">
                <div class="spinner-border spinner-border-sm text-primary mb-2"></div>
                <div class="small">Đang tải bài viết cộng đồng...</div>
            </div>
        `;

        fetch('/BaiViet/GetFeed?filter=' + encodeURIComponent(filter))
            .then(res => {
                if (!res.ok) {
                    throw new Error('HTTP ' + res.status);
                }
                return res.json();
            })
            .then(data => {
                if (!data || !data.success) {
                    container.innerHTML = `
                        <div class="alert alert-warning text-center small my-3 p-3">
                            <div>${data?.message || 'Không thể tải danh sách bài viết.'}</div>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill mt-2 px-3" onclick="loadNewsFeed('${filter}')">
                                <i class="bi bi-arrow-clockwise me-1"></i>Thử lại
                            </button>
                        </div>
                    `;
                    return;
                }

                // Cập nhật thông tin quản trị nếu là Admin
                if (data.isAdmin) {
                    const switchElem = document.getElementById('toggleApprovalSwitch');
                    const labelElem = document.getElementById('toggleApprovalLabel');
                    const pendingBadge = document.getElementById('topPendingBadge');
                    const reportBadge = document.getElementById('topReportBadge');

                    if (switchElem) switchElem.checked = data.batXetDuyet;
                    if (labelElem) {
                        labelElem.innerHTML = data.batXetDuyet 
                            ? '<span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Đang BẬT xét duyệt</span>'
                            : '<span class="text-secondary"><i class="bi bi-dash-circle me-1"></i>Đang TẮT (Đăng ngay)</span>';
                    }
                    if (pendingBadge) pendingBadge.innerText = data.pendingCount;
                    if (reportBadge) reportBadge.innerText = data.reportCount;
                }

                if (!data.posts || data.posts.length === 0) {
                    container.innerHTML = `
                        <div class="text-center py-5 bg-white rounded-3 border mb-3">
                            <i class="bi bi-chat-square-quote fs-1 text-secondary mb-2 d-block"></i>
                            <div class="fw-bold text-secondary">Chưa có bài viết nào trong mục này.</div>
                            <div class="text-muted small mt-1">Hãy là người đầu tiên chia sẻ cảm nghĩ và tiến độ học tập hôm nay!</div>
                            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill mt-3 px-3" onclick="openCreatePostModal()">
                                <i class="bi bi-pencil-square me-1"></i>Đăng bài ngay
                            </button>
                        </div>
                    `;
                    return;
                }

                let html = '';
                post_cachedPosts = {};
                data.posts.forEach(p => {
                    post_cachedPosts[p.maBaiViet] = p;
                    html += renderSinglePostHtml(p, data.currentUserId, data.isAdmin);
                });
                container.innerHTML = html;
            })
            .catch(err => {
                console.error("Lỗi tải feed:", err);
                container.innerHTML = `
                    <div class="alert alert-light border shadow-sm text-center small my-3 p-3">
                        <i class="bi bi-cloud-slash text-danger fs-3 d-block mb-1"></i>
                        <div class="fw-bold text-dark">Chưa thể kết nối tới máy chủ để tải bài viết.</div>
                        <div class="text-muted mt-1">Hệ thống đang đồng bộ dữ liệu hoặc máy chủ đang khởi động lại.</div>
                        <button type="button" class="btn btn-sm btn-primary rounded-pill mt-3 px-3 shadow-sm" onclick="loadNewsFeed(post_currentFeedFilter)">
                            <i class="bi bi-arrow-clockwise me-1"></i>Thử lại ngay
                        </button>
                    </div>
                `;
            });
    }

    // Render HTML cho từng bài viết
    function renderSinglePostHtml(p, currentUserId, isAdmin) {
        const formattedContent = formatPostContentText(p.noiDung);
        const avatarLetter = (p.tacGiaTen && p.tacGiaTen.length > 0) ? p.tacGiaTen.substring(0, 1).toUpperCase() : 'U';
        const roleBadge = p.tacGiaVaiTro === 'Admin' 
            ? '<span class="badge bg-danger ms-1" style="font-size: 10px;">Quản trị</span>'
            : (p.tacGiaVaiTro === 'GiaoVien' ? '<span class="badge bg-primary ms-1" style="font-size: 10px;">Giáo viên</span>' : '<span class="badge bg-success ms-1" style="font-size: 10px;">Học viên</span>');

        // Trạng thái chờ duyệt
        let statusBadge = '';
        if (p.trangThai === 'ChoDuyet') {
            statusBadge = `
                <div class="alert alert-warning py-1 px-3 mb-2 small d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-hourglass-split me-1"></i><strong>Bài viết đang chờ Quản trị viên duyệt</strong> trước khi hiển thị công khai.</span>
                    ${p.canApprove ? `
                        <div class="d-flex gap-1">
                            <button type="button" class="btn btn-success btn-sm rounded-pill py-0 px-2 fw-bold" onclick="approvePost(${p.maBaiViet}, true)"><i class="bi bi-check-lg me-1"></i>Duyệt</button>
                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill py-0 px-2 fw-bold" onclick="approvePost(${p.maBaiViet}, false)"><i class="bi bi-x-lg me-1"></i>Từ chối</button>
                        </div>
                    ` : ''}
                </div>
            `;
        }

        // Báo cáo vi phạm (Dành cho Admin)
        let reportAlert = '';
        if (isAdmin && p.soBaoCao > 0) {
            reportAlert = `
                <div class="alert alert-danger py-1 px-3 mb-2 small d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-exclamation-triangle-fill me-1"></i><strong>Cảnh báo:</strong> Bài viết này nhận được <strong>${p.soBaoCao}</strong> lượt báo cáo sai phạm!</span>
                    <button type="button" class="btn btn-danger btn-sm rounded-pill py-0 px-2 fw-bold" onclick="openAdminReportsModal()">Xử lý ngay</button>
                </div>
            `;
        }

        // Thân bài viết: Phông nền màu hoặc chữ bình thường
        let bodyHtml = '';
        if (p.phongNen && p.phongNen !== 'none' && !p.hinhAnhUrl && !p.videoUrl) {
            bodyHtml = `
                <div class="fb-post-bg-canvas fb-bg-${p.phongNen}">
                    <div>${formattedContent}</div>
                </div>
            `;
        } else {
            bodyHtml = `
                <div class="fb-post-body">
                    <p class="mb-2" style="white-space: pre-line;">${formattedContent}</p>
                </div>
            `;
        }

        // Ảnh đính kèm
        let mediaHtml = '';
        if (p.hinhAnhUrl) {
            mediaHtml += `
                <div class="fb-post-media">
                    <img src="${p.hinhAnhUrl}" alt="Ảnh bài viết" loading="lazy" />
                </div>
            `;
        }
        // Video đính kèm
        if (p.videoUrl) {
            mediaHtml += `
                <div class="fb-post-media bg-dark">
                    <video controls class="w-100" style="max-height: 420px;" preload="metadata">
                        <source src="${p.videoUrl}">
                        Trình duyệt của bạn không hỗ trợ phát video này.
                    </video>
                </div>
            `;
        }

        // Bài viết gốc lồng bên trong (Nếu đây là bài chia sẻ)
        let sharedPostHtml = '';
        if (p.baiVietGoc) {
            const orig = p.baiVietGoc;
            const origAvatarLetter = (orig.tacGiaTen && orig.tacGiaTen.length > 0) ? orig.tacGiaTen.substring(0, 1).toUpperCase() : 'U';
            let origMedia = '';
            if (orig.hinhAnhUrl) {
                origMedia += `<div class="rounded overflow-hidden mb-2"><img src="${orig.hinhAnhUrl}" alt="Ảnh đính kèm" class="w-100" style="max-height: 280px; object-fit: cover;" /></div>`;
            }
            if (orig.videoUrl) {
                origMedia += `<div class="rounded overflow-hidden mb-2 bg-dark"><video controls class="w-100" style="max-height: 280px;"><source src="${orig.videoUrl}"></video></div>`;
            }
            let origBody = '';
            if (orig.phongNen && orig.phongNen !== 'none' && !orig.hinhAnhUrl && !orig.videoUrl) {
                origBody = `<div class="fb-post-bg-canvas fb-bg-${orig.phongNen} rounded p-3 text-center my-2" style="font-size: 15px;">${formatPostContentText(orig.noiDung)}</div>`;
            } else {
                origBody = `<div class="small text-dark mb-2" style="white-space: pre-line;">${formatPostContentText(orig.noiDung)}</div>`;
            }

            sharedPostHtml = `
                <div class="border rounded-3 p-3 bg-light mx-3 mb-3 shadow-xs">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="fb-avatar" style="width: 32px; height: 32px; font-size: 13px; ${orig.tacGiaAvatar ? `background-image: url('${orig.tacGiaAvatar}'); background-size: cover;` : 'background: #0866ff; color: #fff;'}">
                            ${!orig.tacGiaAvatar ? origAvatarLetter : ''}
                        </div>
                        <div>
                            <div class="fw-bold small text-dark">${orig.tacGiaTen}</div>
                            <div class="text-muted" style="font-size: 11px;">${orig.ngayDangHienThi} &bull; <i class="bi bi-globe-americas"></i></div>
                        </div>
                    </div>
                    ${origBody}
                    ${origMedia}
                </div>
            `;
        }

        // Menu 3 chấm (Xóa bài hoặc Báo cáo)
        let menuItems = '';
        if (p.canDelete) {
            menuItems += `<li><a class="dropdown-item text-danger py-1" href="javascript:void(0)" onclick="confirmDeletePost(${p.maBaiViet})"><i class="bi bi-trash3 me-2"></i>Xóa bài viết</a></li>`;
        }
        if (p.canReport) {
            menuItems += `<li><a class="dropdown-item text-warning py-1" href="javascript:void(0)" onclick="openReportModal(${p.maBaiViet})"><i class="bi bi-flag me-2"></i>Báo cáo sai phạm</a></li>`;
        }
        menuItems += `<li><a class="dropdown-item py-1" href="javascript:void(0)" onclick="copyPostLink(${p.maBaiViet})"><i class="bi bi-link-45deg me-2"></i>Sao chép liên kết</a></li>`;

        return `
            <article class="fb-post" id="user-post-${p.maBaiViet}">
                <!-- Header -->
                <div class="fb-post-header">
                    <div class="fb-post-author">
                        <div class="fb-avatar" style="${p.tacGiaAvatar ? `background-image: url('${p.tacGiaAvatar}'); background-size: cover;` : 'background: #0866ff; color: #fff;'}">
                            ${!p.tacGiaAvatar ? avatarLetter : ''}
                        </div>
                        <div>
                            <div class="fb-author-name">
                                ${p.tacGiaTen} ${roleBadge}
                            </div>
                            <div class="fb-post-meta">
                                <span>${p.ngayDangHienThi}</span> &bull;
                                <i class="bi bi-globe-americas" title="Công khai"></i>
                            </div>
                        </div>
                    </div>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-light border-0 rounded-circle text-muted" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-three-dots"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border">
                            ${menuItems}
                        </ul>
                    </div>
                </div>

                <!-- Cảnh báo trạng thái -->
                <div class="px-3">
                    ${statusBadge}
                    ${reportAlert}
                </div>

                <!-- Thân bài viết -->
                ${bodyHtml}

                <!-- Ảnh / Video -->
                ${mediaHtml}

                <!-- Bài viết chia sẻ (lồng) -->
                ${sharedPostHtml}

                <!-- Stats Bar -->
                <div class="fb-post-stats">
                    <div class="d-flex align-items-center gap-1">
                        <div class="fb-like-bubble" style="${(p.soThich > 0) ? '' : 'display: none;'}" id="like-bubble-${p.maBaiViet}"><i class="bi bi-hand-thumbs-up-fill"></i></div>
                        <span class="text-muted small" id="like-count-${p.maBaiViet}">${p.soThich > 0 ? (p.soThich + ' người thích') : 'Hãy là người đầu tiên thích'}</span>
                    </div>
                    <div class="text-muted small d-flex gap-2">
                        <span id="comment-count-label-${p.maBaiViet}" style="cursor: pointer;" onclick="togglePostCommentBox(${p.maBaiViet})">${p.soBinhLuan} bình luận</span> &bull;
                        <span id="share-count-label-${p.maBaiViet}">${p.soChiaSe} chia sẻ</span>
                    </div>
                </div>

                <!-- Actions Bar -->
                <div class="fb-post-actions-bar">
                    <button type="button" class="fb-post-action-btn ${p.daThich ? 'active-liked text-primary fw-bold' : ''}" id="like-btn-${p.maBaiViet}" onclick="togglePostLike(this, ${p.maBaiViet})">
                        <i class="bi ${p.daThich ? 'bi-hand-thumbs-up-fill text-primary' : 'bi-hand-thumbs-up'} fs-5"></i>
                        <span>Thích</span>
                    </button>
                    <button type="button" class="fb-post-action-btn" onclick="togglePostCommentBox(${p.maBaiViet})">
                        <i class="bi bi-chat fs-5"></i>
                        <span>Bình luận</span>
                    </button>
                    <button type="button" class="fb-post-action-btn" onclick="openSharePostModal(${p.maBaiViet})">
                        <i class="bi bi-share fs-5"></i>
                        <span>Chia sẻ</span>
                    </button>
                </div>

                <!-- Comments Section -->
                <div class="fb-comments-section border-top px-3 py-2 bg-light-subtle d-none" id="comments-section-${p.maBaiViet}">
                    <!-- Ô nhập bình luận mới -->
                    <div class="d-flex align-items-start gap-2 mb-3 mt-2">
                        <div class="fb-avatar fb-avatar-sm flex-shrink-0" style="background: #0866ff; color: #fff; width: 34px; height: 34px; font-size: 14px;">
                            @(!string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "U")
                        </div>
                        <div class="flex-grow-1 position-relative">
                            <textarea id="comment-input-${p.maBaiViet}" 
                                      class="form-control form-control-sm rounded-4 pe-5" 
                                      rows="1" 
                                      placeholder="Viết bình luận công khai... (Nhấn Enter để gửi)" 
                                      onkeydown="handleCommentKeyDown(event, ${p.maBaiViet})" 
                                      style="font-size: 13px; resize: none; background: #f0f2f5;"></textarea>
                            <button type="button" class="btn btn-sm btn-link text-primary position-absolute end-0 top-50 translate-middle-y me-1 p-1 text-decoration-none" onclick="submitComment(${p.maBaiViet})" title="Gửi bình luận">
                                <i class="bi bi-send-fill fs-6"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Danh sách bình luận -->
                    <div class="fb-comments-list d-flex flex-column gap-2" id="comments-list-${p.maBaiViet}">
                        <!-- Danh sách bình luận được tải động ở đây -->
                    </div>
                </div>
            </article>
        `;
    }

    // Helper format text (hỗ trợ **in đậm**)
    function formatPostContentText(text) {
        if (!text) return '';
        let escaped = text
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;");
        // Convert **in đậm** thành <strong>in đậm</strong>
        escaped = escaped.replace(/\*\*(.*?)\*\*/g, '<strong class="fw-bold text-dark">$1</strong>');
        return escaped;
    }

    // =========================================================================
    // 2. TẠO BÀI VIẾT (MODAL, PHÔNG NỀN, TÔ ĐẬM, ẢNH, VIDEO)
    // =========================================================================
    function openCreatePostModal(mode = 'none') {
        if (!post_isUserLoggedIn) {
            const reqModal = document.getElementById('fbRequireLoginModal');
            if (reqModal && window.bootstrap) {
                bootstrap.Modal.getOrCreateInstance(reqModal).show();
            } else {
                window.location.href = '/TaiKhoan/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
            }
            return;
        }

        const modalElem = document.getElementById('fbCreatePostModal');
        if (!modalElem) return;
        const modal = bootstrap.Modal.getOrCreateInstance(modalElem);
        modal.show();

        if (mode === 'photo') {
            setTimeout(() => {
                const input = document.getElementById('postImageFileInput');
                if (input) input.click();
            }, 300);
        } else if (mode === 'background') {
            toggleBackgroundPalette(true);
        } else if (mode === 'bold') {
            setTimeout(() => insertBoldText(), 300);
        }
    }

    // Chèn cú pháp in đậm **chữ** vào vị trí con trỏ
    function insertBoldText() {
        const textarea = document.getElementById('postContentInput');
        if (!textarea) return;

        const start = textarea.selectionStart;
        const end = textarea.selectionEnd;
        const text = textarea.value;

        if (start !== end) {
            // Có bôi đen đoạn chữ -> Bọc đoạn đó trong **...**
            const selected = text.substring(start, end);
            textarea.value = text.substring(0, start) + '**' + selected + '**' + text.substring(end);
            textarea.selectionStart = start;
            textarea.selectionEnd = end + 4;
        } else {
            // Không bôi đen -> chèn mẫu **chữ in đậm**
            textarea.value = text.substring(0, start) + '**chữ in đậm**' + text.substring(end);
            textarea.selectionStart = start + 2;
            textarea.selectionEnd = start + 13;
        }
        textarea.focus();
    }

    // Bật/tắt thanh chọn phông nền
    function toggleBackgroundPalette(forceShow = false) {
        const picker = document.getElementById('postBackgroundPicker');
        if (!picker) return;
        if (forceShow) {
            picker.classList.remove('d-none');
        } else {
            picker.classList.toggle('d-none');
        }
    }

    // Áp dụng phông nền màu / gradient
    function applyPostBackground(bgName) {
        post_selectedBackground = (bgName === 'none') ? null : bgName;
        const wrapper = document.getElementById('postComposerWrapper');
        const textarea = document.getElementById('postContentInput');

        // Bỏ hết class gradient cũ
        wrapper.className = 'rounded-3 transition-all mb-2';
        textarea.classList.remove('text-white');

        // Update active swatch
        document.querySelectorAll('.fb-color-swatch').forEach(sw => sw.classList.remove('active'));

        if (post_selectedBackground) {
            wrapper.classList.add('fb-bg-' + post_selectedBackground);
            wrapper.style.minHeight = '240px';
            wrapper.style.display = 'flex';
            wrapper.style.alignItems = 'center';
            wrapper.style.justifyContent = 'center';

            textarea.classList.add('text-white');
            textarea.style.textAlign = 'center';
            textarea.style.fontSize = '22px';
            textarea.style.fontWeight = 'bold';
            textarea.style.textShadow = '0 1px 2px rgba(0,0,0,0.4)';

            // Tự động gỡ bỏ ảnh/video nếu có vì phông nền ưu tiên hiển thị chữ to
            clearSelectedPostImage();
            clearSelectedVideo();
        } else {
            wrapper.style.minHeight = '140px';
            wrapper.style.display = 'block';
            textarea.style.textAlign = 'left';
            textarea.style.fontSize = '17px';
            textarea.style.fontWeight = 'normal';
            textarea.style.textShadow = 'none';
        }
    }

    // Chọn file ảnh
    function handleImageSelected(input) {
        if (!input.files || input.files.length === 0) return;
        const file = input.files[0];
        post_selectedImageFile = file;

        // Reset phông nền vì đã có ảnh
        applyPostBackground('none');

        const reader = new FileReader();
        reader.onload = function (e) {
            document.getElementById('postImagePreview').src = e.target.result;
            document.getElementById('postImagePreviewBox').classList.remove('d-none');
        };
        reader.readAsDataURL(file);
    }

    function clearSelectedPostImage() {
        post_selectedImageFile = null;
        document.getElementById('postImageFileInput').value = '';
        document.getElementById('postImagePreviewBox').classList.add('d-none');
    }

    // Chọn file video
    function handleVideoSelected(input) {
        if (!input.files || input.files.length === 0) return;
        const file = input.files[0];
        post_selectedVideoFile = file;

        // Reset phông nền vì đã có video
        applyPostBackground('none');

        const video = document.getElementById('postVideoPreview');
        video.src = URL.createObjectURL(file);
        document.getElementById('postVideoPreviewBox').classList.remove('d-none');
    }

    function clearSelectedVideo() {
        post_selectedVideoFile = null;
        document.getElementById('postVideoFileInput').value = '';
        document.getElementById('postVideoPreviewBox').classList.add('d-none');
        const video = document.getElementById('postVideoPreview');
        video.pause();
        video.src = '';
    }

    // Gửi bài viết lên Server
    function submitCreatePost() {
        const content = document.getElementById('postContentInput').value.trim();
        if (!content) {
            alert('Vui lòng nhập nội dung cho bài viết!');
            return;
        }

        const btn = document.getElementById('btnSubmitPost');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang đăng bài...';

        const formData = new FormData();
        formData.append('noiDung', content);
        if (post_selectedBackground) {
            formData.append('phongNen', post_selectedBackground);
        }
        if (post_selectedImageFile) {
            formData.append('hinhAnhFile', post_selectedImageFile);
        }
        if (post_selectedVideoFile) {
            formData.append('videoFile', post_selectedVideoFile);
        }

        fetch('/BaiViet/TaoBaiViet', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            btn.disabled = false;
            btn.innerHTML = 'Đăng bài viết';

            if (data && data.success) {
                // Đóng modal & reset form
                const createModalElem = document.getElementById('fbCreatePostModal');
                if (createModalElem && window.bootstrap) {
                    bootstrap.Modal.getOrCreateInstance(createModalElem).hide();
                }
                document.getElementById('postContentInput').value = '';
                applyPostBackground('none');
                clearSelectedPostImage();
                clearSelectedVideo();

                alert(data.message || 'Đăng bài viết thành công!');
                loadNewsFeed(post_currentFeedFilter);
            } else {
                alert(data.message || 'Không thể đăng bài viết!');
            }
        })
        .catch(err => {
            btn.disabled = false;
            btn.innerHTML = 'Đăng bài viết';
            console.error("Lỗi đăng bài:", err);
            alert('Có lỗi xảy ra khi kết nối máy chủ!');
        });
    }

    // =========================================================================
    // 3. XÓA BÀI VIẾT (TÁC GIẢ HOẶC QUẢN LÝ CÓ QUYỀN XÓA)
    // =========================================================================
    function confirmDeletePost(postId) {
        if (!confirm('Bạn có chắc chắn muốn xóa bài viết này khỏi bảng tin?')) return;

        fetch('/BaiViet/XoaBaiViet?maBaiViet=' + postId, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if (data && data.success) {
                    const postElem = document.getElementById('user-post-' + postId);
                    if (postElem) {
                        postElem.style.transition = 'all 0.3s ease';
                        postElem.style.opacity = '0';
                        postElem.style.transform = 'scale(0.95)';
                        setTimeout(() => postElem.remove(), 300);
                    }
                    alert(data.message || 'Đã xóa bài viết thành công!');
                } else {
                    alert(data.message || 'Không thể xóa bài viết!');
                }
            });
    }

    // =========================================================================
    // 4. BÁO CÁO BÀI VIẾT SAI PHẠM (HỌC VIÊN & GIÁO VIÊN BÁO CÁO)
    // =========================================================================
    function openReportModal(postId) {
        if (!post_isUserLoggedIn) {
            const reqModal = document.getElementById('fbRequireLoginModal');
            if (reqModal && window.bootstrap) {
                bootstrap.Modal.getOrCreateInstance(reqModal).show();
            } else {
                window.location.href = '/TaiKhoan/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
            }
            return;
        }
        document.getElementById('reportTargetPostId').value = postId;
        document.getElementById('reportDetailsInput').value = '';
        const reportModalElem = document.getElementById('fbReportPostModal');
        if (reportModalElem && window.bootstrap) {
            bootstrap.Modal.getOrCreateInstance(reportModalElem).show();
        }
    }

    function submitPostReport() {
        const postId = document.getElementById('reportTargetPostId').value;
        const selectedRadio = document.querySelector('input[name="reportReasonRadio"]:checked');
        const reason = selectedRadio ? selectedRadio.value : '';
        const details = document.getElementById('reportDetailsInput').value.trim();

        if (!reason) {
            alert('Vui lòng chọn lý do báo cáo sai phạm!');
            return;
        }

        fetch('/BaiViet/BaoCaoBaiViet?maBaiViet=' + postId + '&lyDo=' + encodeURIComponent(reason) + '&chiTiet=' + encodeURIComponent(details), {
            method: 'POST'
        })
        .then(res => res.json())
        .then(data => {
            if (data && data.success) {
                const reportModalElem = document.getElementById('fbReportPostModal');
                if (reportModalElem && window.bootstrap) {
                    bootstrap.Modal.getOrCreateInstance(reportModalElem).hide();
                }
                alert(data.message || 'Cảm ơn bạn đã báo cáo sai phạm!');
            } else {
                alert(data.message || 'Không thể gửi báo cáo!');
            }
        });
    }

    // =========================================================================
    // 5. QUẢN TRỊ VIÊN: BẬT/TẮT KIỂM DUYỆT & PHÊ DUYỆT BÀI VIẾT
    // =========================================================================
    function togglePostApproval(isChecked) {
        fetch('/BaiViet/BatTatXetDuyet?batXetDuyet=' + isChecked, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if (data && data.success) {
                    const labelElem = document.getElementById('toggleApprovalLabel');
                    if (labelElem) {
                        labelElem.innerHTML = data.batXetDuyet 
                            ? '<span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Đang BẬT xét duyệt</span>'
                            : '<span class="text-secondary"><i class="bi bi-dash-circle me-1"></i>Đang TẮT (Đăng ngay)</span>';
                    }
                    alert(data.message);
                } else {
                    alert(data.message || 'Không thể thay đổi cấu hình!');
                }
            });
    }

    function approvePost(postId, isApproved) {
        const actionText = isApproved ? 'phê duyệt để bài viết hiển thị công khai' : 'TỪ CHỐI và gỡ bỏ bài viết này';
        if (!confirm(`Bạn có chắc chắn muốn ${actionText}?`)) return;

        fetch('/BaiViet/DuyetBaiViet?maBaiViet=' + postId + '&dongY=' + isApproved, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if (data && data.success) {
                    alert(data.message);
                    loadNewsFeed(post_currentFeedFilter);
                } else {
                    alert(data.message || 'Không thể thực hiện phê duyệt!');
                }
            });
    }

    function filterFeed(filter, btn) {
        document.querySelectorAll('.filter-feed-btn').forEach(b => b.classList.remove('active', 'btn-primary'));
        if (btn) btn.classList.add('active');
        post_currentFeedFilter = filter;
        loadNewsFeed(filter);
    }

    // =========================================================================
    // 6. QUẢN TRỊ VIÊN: XỬ LÝ TRUNG TÂM BÁO CÁO VI PHẠM
    // =========================================================================
    function openAdminReportsModal() {
        const modalElem = document.getElementById('fbAdminReportsModal');
        if (modalElem && window.bootstrap) {
            bootstrap.Modal.getOrCreateInstance(modalElem).show();
        }

        const container = document.getElementById('adminReportsContainer');
        container.innerHTML = '<div class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm text-danger mb-2"></div><div>Đang tải danh sách báo cáo vi phạm...</div></div>';

        fetch('/BaiViet/GetDanhSachBaoCao')
            .then(res => res.json())
            .then(data => {
                if (!data || !data.success || !data.reports || data.reports.length === 0) {
                    container.innerHTML = '<div class="alert alert-success text-center py-4 mb-0"><i class="bi bi-shield-check fs-2 d-block mb-2"></i>Hiện tại không có báo cáo sai phạm nào cần xử lý!</div>';
                    return;
                }

                let html = '<div class="d-flex flex-column gap-3">';
                data.reports.forEach(r => {
                    html += `
                        <div class="card border border-danger-subtle p-3 shadow-sm rounded-3" id="admin-report-card-${r.maBaoCao}">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="badge bg-danger mb-1">${r.lyDo}</span>
                                    <div class="small text-muted">Báo cáo bởi: <strong>${r.nguoiBaoCaoTen}</strong> &bull; ${r.ngayBaoCao}</div>
                                </div>
                                <span class="badge bg-light text-secondary border">Mã bài viết: #${r.maBaiViet}</span>
                            </div>
                            ${r.chiTiet ? `<div class="p-2 bg-light rounded small mb-2 text-secondary"><strong>Chi tiết:</strong> ${r.chiTiet}</div>` : ''}

                            <!-- Nội dung bài viết bị báo cáo -->
                            <div class="border rounded p-2 mb-3 bg-white">
                                <div class="small text-muted mb-1">Tác giả bài viết: <strong>${r.baiVietTacGia}</strong></div>
                                <div class="small fw-semibold text-dark">${r.baiVietNoiDung}</div>
                                ${r.baiVietHinhAnh ? `<img src="${r.baiVietHinhAnh}" class="mt-2 rounded" style="max-height: 120px; object-fit: cover;" />` : ''}
                            </div>

                            <!-- Nút hành động của Quản lý -->
                            <div class="d-flex justify-content-end gap-2 border-top pt-2">
                                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" onclick="handleReportAction(${r.maBaoCao}, 'bo_qua')">
                                    <i class="bi bi-shield-check me-1"></i>Bỏ qua báo cáo
                                </button>
                                <button type="button" class="btn btn-danger btn-sm rounded-pill" onclick="handleReportAction(${r.maBaoCao}, 'xoa_bai')">
                                    <i class="bi bi-trash3 me-1"></i>Xóa bài viết vi phạm
                                </button>
                            </div>
                        </div>
                    `;
                });
                html += '</div>';
                container.innerHTML = html;
            });
    }

    function handleReportAction(reportId, action) {
        const actionLabel = action === 'xoa_bai' ? 'XÓA bài viết vi phạm này' : 'BỎ QUA báo cáo này';
        if (!confirm(`Bạn có chắc chắn muốn ${actionLabel}?`)) return;

        fetch('/BaiViet/XuLyBaoCao?maBaoCao=' + reportId + '&hanhDong=' + action, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if (data && data.success) {
                    const card = document.getElementById('admin-report-card-' + reportId);
                    if (card) card.remove();
                    alert(data.message);
                    loadNewsFeed(post_currentFeedFilter);
                } else {
                    alert(data.message || 'Không thể xử lý báo cáo!');
                }
            });
    }

    // =========================================================================
    // 7. TƯƠNG TÁC THÍCH (LIKE / UNLIKE)
    // =========================================================================
    function togglePostLike(btn, postId) {
        if (!post_isUserLoggedIn) {
            const reqModal = document.getElementById('fbRequireLoginModal');
            if (reqModal && window.bootstrap) {
                bootstrap.Modal.getOrCreateInstance(reqModal).show();
            } else {
                window.location.href = '/TaiKhoan/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
            }
            return;
        }

        fetch('/BaiViet/ToggleLike?maBaiViet=' + postId, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if (data && data.success) {
                    const icon = btn.querySelector('i');
                    const countSpan = document.getElementById('like-count-' + postId);
                    const bubble = document.getElementById('like-bubble-' + postId);

                    if (data.isLiked) {
                        btn.classList.add('active-liked', 'text-primary', 'fw-bold');
                        if (icon) icon.className = 'bi bi-hand-thumbs-up-fill fs-5 text-primary';
                    } else {
                        btn.classList.remove('active-liked', 'text-primary', 'fw-bold');
                        if (icon) icon.className = 'bi bi-hand-thumbs-up fs-5';
                    }

                    if (countSpan) {
                        countSpan.innerText = data.likeCount > 0 ? (data.likeCount + ' người thích') : 'Hãy là người đầu tiên thích';
                    }
                    if (bubble) {
                        bubble.style.display = data.likeCount > 0 ? 'inline-flex' : 'none';
                    }
                } else if (data && data.requireLogin) {
                    const reqModal = document.getElementById('fbRequireLoginModal');
                    if (reqModal && window.bootstrap) {
                        bootstrap.Modal.getOrCreateInstance(reqModal).show();
                    }
                } else {
                    alert(data.message || 'Không thể tương tác thích bài viết!');
                }
            })
            .catch(err => {
                console.error("Lỗi toggle like:", err);
            });
    }

    // =========================================================================
    // 8. BÌNH LUẬN BÀI VIẾT (COMMENT SYSTEM)
    // =========================================================================
    function togglePostCommentBox(postId) {
        const commentSection = document.getElementById('comments-section-' + postId);
        if (!commentSection) return;

        const isCurrentlyHidden = commentSection.classList.contains('d-none');
        if (isCurrentlyHidden) {
            commentSection.classList.remove('d-none');
            // Tải danh sách bình luận
            loadPostComments(postId);
            // Focus vào ô input
            const input = document.getElementById('comment-input-' + postId);
            if (input) setTimeout(() => input.focus(), 150);
        } else {
            commentSection.classList.add('d-none');
        }
    }

    function loadPostComments(postId) {
        const list = document.getElementById('comments-list-' + postId);
        if (!list) return;

        list.innerHTML = `
            <div class="text-center py-2 text-muted small">
                <div class="spinner-border spinner-border-sm text-secondary me-1"></div> Đang tải bình luận...
            </div>
        `;

        fetch('/BaiViet/GetBinhLuans?maBaiViet=' + postId)
            .then(res => res.json())
            .then(data => {
                if (!data || !data.success) {
                    list.innerHTML = `<div class="text-center text-muted small py-2">Không thể tải bình luận.</div>`;
                    return;
                }

                const countLabel = document.getElementById('comment-count-label-' + postId);
                if (countLabel) countLabel.innerText = `${data.totalComments} bình luận`;

                if (!data.comments || data.comments.length === 0) {
                    list.innerHTML = `<div class="text-center text-muted small py-2"><i class="bi bi-chat-dots me-1"></i>Chưa có bình luận nào. Hãy là người đầu tiên bình luận!</div>`;
                    return;
                }

                let html = '';
                data.comments.forEach(c => {
                    const avatarLetter = (c.tacGiaTen && c.tacGiaTen.length > 0) ? c.tacGiaTen.substring(0, 1).toUpperCase() : 'U';
                    const roleBadge = c.tacGiaVaiTro === 'Admin' 
                        ? '<span class="badge bg-danger ms-1" style="font-size: 9px; padding: 1px 5px;">Quản trị</span>'
                        : (c.tacGiaVaiTro === 'GiaoVien' ? '<span class="badge bg-primary ms-1" style="font-size: 9px; padding: 1px 5px;">Giáo viên</span>' : '<span class="badge bg-success ms-1" style="font-size: 9px; padding: 1px 5px;">Học viên</span>');

                    html += `
                        <div class="d-flex align-items-start gap-2 mb-1" id="post-comment-${c.maBinhLuan}">
                            <div class="fb-avatar fb-avatar-sm flex-shrink-0" style="width: 32px; height: 32px; font-size: 13px; ${c.tacGiaAvatar ? `background-image: url('${c.tacGiaAvatar}'); background-size: cover;` : 'background: #0866ff; color: #fff;'}">
                                ${!c.tacGiaAvatar ? avatarLetter : ''}
                            </div>
                            <div class="flex-grow-1">
                                <div class="p-2 px-3 rounded-4 d-inline-block position-relative" style="background-color: #f0f2f5; max-width: 95%;">
                                    <div class="d-flex align-items-center gap-1 mb-1">
                                        <span class="fw-bold small text-dark">${c.tacGiaTen}</span>
                                        ${roleBadge}
                                    </div>
                                    <div class="small text-dark" style="word-break: break-word;">${formatPostContentText(c.noiDung)}</div>
                                </div>
                                <div class="d-flex align-items-center gap-3 ms-2 mt-1 text-muted" style="font-size: 11px;">
                                    <span>${c.ngayBinhLuanHienThi}</span>
                                    ${c.canDelete ? `
                                        <a href="javascript:void(0)" class="text-danger fw-semibold text-decoration-none" onclick="confirmDeleteComment(${c.maBinhLuan}, ${postId})">
                                            <i class="bi bi-trash3 me-1"></i>Xóa
                                        </a>
                                    ` : ''}
                                </div>
                            </div>
                        </div>
                    `;
                });
                list.innerHTML = html;
            })
            .catch(err => {
                console.error("Lỗi load bình luận:", err);
                list.innerHTML = `<div class="text-center text-danger small py-2">Lỗi kết nối khi tải bình luận.</div>`;
            });
    }

    function handleCommentKeyDown(event, postId) {
        if (event.key === 'Enter' && !event.shiftKey) {
            event.preventDefault();
            submitComment(postId);
        }
    }

    function submitComment(postId) {
        if (!post_isUserLoggedIn) {
            const reqModal = document.getElementById('fbRequireLoginModal');
            if (reqModal && window.bootstrap) {
                bootstrap.Modal.getOrCreateInstance(reqModal).show();
            } else {
                window.location.href = '/TaiKhoan/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
            }
            return;
        }

        const input = document.getElementById('comment-input-' + postId);
        if (!input) return;
        const content = input.value.trim();
        if (!content) return;

        input.disabled = true;

        const formData = new FormData();
        formData.append('maBaiViet', postId);
        formData.append('noiDung', content);

        fetch('/BaiViet/ThemBinhLuan', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            input.disabled = false;
            if (data && data.success) {
                input.value = '';
                const countLabel = document.getElementById('comment-count-label-' + postId);
                if (countLabel) countLabel.innerText = `${data.totalComments} bình luận`;

                // Tải lại bình luận
                loadPostComments(postId);
            } else if (data && data.requireLogin) {
                const reqModal = document.getElementById('fbRequireLoginModal');
                if (reqModal && window.bootstrap) {
                    bootstrap.Modal.getOrCreateInstance(reqModal).show();
                }
            } else {
                alert(data.message || 'Không thể gửi bình luận!');
            }
        })
        .catch(err => {
            input.disabled = false;
            console.error("Lỗi gửi bình luận:", err);
            alert('Có lỗi xảy ra khi kết nối máy chủ!');
        });
    }

    function confirmDeleteComment(commentId, postId) {
        if (!confirm('Bạn có chắc chắn muốn xóa bình luận này?')) return;

        fetch('/BaiViet/XoaBinhLuan?maBinhLuan=' + commentId, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if (data && data.success) {
                    const cElem = document.getElementById('post-comment-' + commentId);
                    if (cElem) cElem.remove();
                    const countLabel = document.getElementById('comment-count-label-' + postId);
                    if (countLabel) countLabel.innerText = `${data.totalComments} bình luận`;
                } else {
                    alert(data.message || 'Không thể xóa bình luận!');
                }
            })
            .catch(err => {
                console.error("Lỗi xóa bình luận:", err);
            });
    }

    // =========================================================================
    // 9. CHIA SẺ BÀI VIẾT (SHARE POST SYSTEM)
    // =========================================================================
    function openSharePostModal(postId) {
        if (!post_isUserLoggedIn) {
            const reqModal = document.getElementById('fbRequireLoginModal');
            if (reqModal && window.bootstrap) {
                bootstrap.Modal.getOrCreateInstance(reqModal).show();
            } else {
                window.location.href = '/TaiKhoan/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
            }
            return;
        }

        const post = post_cachedPosts[postId];
        if (!post) {
            alert('Không tìm thấy thông tin bài viết!');
            return;
        }

        document.getElementById('shareTargetPostId').value = postId;
        document.getElementById('shareCaptionInput').value = '';
        document.getElementById('sharePreviewAuthor').innerText = post.tacGiaTen;
        document.getElementById('sharePreviewTime').innerText = post.ngayDangHienThi;
        document.getElementById('sharePreviewContent').innerHTML = formatPostContentText(post.noiDung);

        const avatarElem = document.getElementById('sharePreviewAvatar');
        if (avatarElem) {
            if (post.tacGiaAvatar) {
                avatarElem.style.backgroundImage = `url('${post.tacGiaAvatar}')`;
                avatarElem.style.backgroundSize = 'cover';
                avatarElem.innerText = '';
            } else {
                avatarElem.style.backgroundImage = 'none';
                avatarElem.innerText = (post.tacGiaTen && post.tacGiaTen.length > 0) ? post.tacGiaTen.substring(0, 1).toUpperCase() : 'U';
            }
        }

        const mediaElem = document.getElementById('sharePreviewMedia');
        if (mediaElem) {
            mediaElem.innerHTML = '';
            if (post.hinhAnhUrl) {
                mediaElem.innerHTML = `<img src="${post.hinhAnhUrl}" class="w-100 rounded" style="max-height: 180px; object-fit: cover;" />`;
            } else if (post.videoUrl) {
                mediaElem.innerHTML = `<div class="bg-dark text-white text-center py-4 rounded small"><i class="bi bi-camera-video-fill fs-3 d-block mb-1"></i>Video đính kèm</div>`;
            } else if (post.phongNen && post.phongNen !== 'none') {
                mediaElem.innerHTML = `<div class="fb-post-bg-canvas fb-bg-${post.phongNen} rounded p-2 text-center text-white small" style="min-height: 60px;">Phông nền ${post.phongNen}</div>`;
            }
        }

        const modalElem = document.getElementById('fbSharePostModal');
        if (modalElem && window.bootstrap) {
            bootstrap.Modal.getOrCreateInstance(modalElem).show();
        }
    }

    function submitSharePost() {
        const postId = document.getElementById('shareTargetPostId').value;
        const caption = document.getElementById('shareCaptionInput').value.trim();
        const btn = document.getElementById('btnConfirmSharePost');

        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang chia sẻ...';
        }

        const formData = new FormData();
        formData.append('maBaiVietGoc', postId);
        if (caption) formData.append('loiBinh', caption);

        fetch('/BaiViet/ChiaSeBaiViet', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-send-check me-1"></i>Chia sẻ ngay lên Bảng tin';
            }

            if (data && data.success) {
                const modalElem = document.getElementById('fbSharePostModal');
                if (modalElem && window.bootstrap) {
                    bootstrap.Modal.getOrCreateInstance(modalElem).hide();
                }
                const shareCountSpan = document.getElementById('share-count-label-' + postId);
                if (shareCountSpan) shareCountSpan.innerText = `${data.soChiaSe} chia sẻ`;

                alert(data.message || 'Đã chia sẻ bài viết lên bảng tin!');
                loadNewsFeed(post_currentFeedFilter);
            } else if (data && data.requireLogin) {
                const reqModal = document.getElementById('fbRequireLoginModal');
                if (reqModal && window.bootstrap) {
                    bootstrap.Modal.getOrCreateInstance(reqModal).show();
                }
            } else {
                alert(data.message || 'Không thể chia sẻ bài viết!');
            }
        })
        .catch(err => {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-send-check me-1"></i>Chia sẻ ngay lên Bảng tin';
            }
            console.error("Lỗi chia sẻ bài:", err);
            alert('Có lỗi xảy ra khi kết nối máy chủ!');
        });
    }

    function copyPostLinkFromShareModal() {
        const postId = document.getElementById('shareTargetPostId').value;
        copyPostLink(postId);
        const modalElem = document.getElementById('fbSharePostModal');
        if (modalElem && window.bootstrap) {
            bootstrap.Modal.getOrCreateInstance(modalElem).hide();
        }
    }

    function copyPostLink(postId) {
        const link = window.location.origin + '/#user-post-' + postId;
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(link).then(() => {
                alert('Đã sao chép liên kết bài viết: ' + link);
            }).catch(() => {
                prompt('Sao chép liên kết bài viết:', link);
            });
        } else {
            prompt('Sao chép liên kết bài viết:', link);
        }
    }

    // Global Window bindings
    window.openCreatePostModal = openCreatePostModal;
    window.loadNewsFeed = loadNewsFeed;
    window.filterFeed = filterFeed;
    window.togglePostApproval = togglePostApproval;
    window.approvePost = approvePost;
    window.openAdminReportsModal = openAdminReportsModal;
    window.handleReportAction = handleReportAction;
    window.openReportModal = openReportModal;
    window.submitPostReport = submitPostReport;
    window.confirmDeletePost = confirmDeletePost;
    window.submitCreatePost = submitCreatePost;
    window.applyPostBackground = applyPostBackground;
    window.toggleBackgroundPalette = toggleBackgroundPalette;
    window.insertBoldText = insertBoldText;
    window.handleImageSelected = handleImageSelected;
    window.clearSelectedPostImage = clearSelectedPostImage;
    window.handleVideoSelected = handleVideoSelected;
    window.clearSelectedVideo = clearSelectedVideo;
    window.togglePostLike = togglePostLike;
    window.togglePostCommentBox = togglePostCommentBox;
    window.loadPostComments = loadPostComments;
    window.handleCommentKeyDown = handleCommentKeyDown;
    window.submitComment = submitComment;
    window.confirmDeleteComment = confirmDeleteComment;
    window.openSharePostModal = openSharePostModal;
    window.submitSharePost = submitSharePost;
    window.copyPostLinkFromShareModal = copyPostLinkFromShareModal;
    window.copyPostLink = copyPostLink;
    console.log("LanguageBook: Feed script loaded successfully.");
</script>
}
