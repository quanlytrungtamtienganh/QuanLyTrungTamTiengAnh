@model TrungTamNgoaiNgu.Models.HocVien
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Hồ sơ học viên: " + Model.HoTen;
}

<div class="edu-page-header">
    <div>
        <h2 class="edu-page-title"><i class="bi bi-person-lines-fill text-primary me-2"></i>Hồ sơ học viên</h2>
        <p class="edu-page-subtitle">Thông tin lý lịch và quá trình đăng ký học tập của học viên @Model.HoTen</p>
    </div>
    <div>
        <a asp-action="Index" class="btn-edu btn-edu-outline">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Cột trái: Thông tin cá nhân học viên -->
    <div class="col-lg-4">
        <div class="edu-card text-center">
            <div class="admin-user-avatar mx-auto mb-3" style="width: 72px; height: 72px; font-size: 1.75rem;">
                @(Model.HoTen.Length > 0 ? Model.HoTen.Substring(0, 1).ToUpper() : "H")
            </div>
            <h4 class="fw-bold mb-1">@Model.HoTen</h4>
            <span class="edu-badge badge-info-soft mb-3">
                <i class="bi bi-hash"></i> Mã HV: #HV-@Model.MaHocVien.ToString("D4")
            </span>

            <div class="border-top pt-3 text-start">
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted"><i class="bi bi-calendar me-2"></i>Ngày sinh:</span>
                    <span class="fw-semibold">@Model.NgaySinh.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted"><i class="bi bi-gender-ambiguous me-2"></i>Giới tính:</span>
                    <span class="fw-semibold">@Model.GioiTinh</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted"><i class="bi bi-telephone me-2"></i>Số điện thoại:</span>
                    <span class="fw-semibold">@Model.SoDienThoai</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted"><i class="bi bi-envelope me-2"></i>Email:</span>
                    <span class="fw-semibold">@Model.Email</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted"><i class="bi bi-person-check me-2"></i>Tên đăng nhập:</span>
                    <span class="fw-semibold text-primary">@(Model.TaiKhoan?.TenDangNhap ?? "—")</span>
                </div>
                <div class="py-2">
                    <span class="text-muted d-block mb-1"><i class="bi bi-geo-alt me-2"></i>Địa chỉ:</span>
                    <span class="fw-semibold text-dark">@(string.IsNullOrEmpty(Model.DiaChi) ? "Chưa cập nhật địa chỉ" : Model.DiaChi)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Cột phải: Lịch sử các lớp học viên đã đăng ký -->
    <div class="col-lg-8">
        <div class="edu-card">
            <div class="edu-card-header">
                <h5 class="edu-card-title"><i class="bi bi-mortarboard text-primary me-2"></i>Lịch sử đăng ký khóa học (@Model.DangKyHocs.Count lượt)</h5>
            </div>

            @if (!Model.DangKyHocs.Any())
            {
                <div class="edu-empty-state py-4">
                    <i class="bi bi-journal-x edu-empty-icon" style="font-size: 2.5rem;"></i>
                    <h5 class="edu-empty-title">Học viên chưa đăng ký lớp học nào!</h5>
                    <p class="edu-empty-desc">Học viên này chưa có lượt đăng ký khóa học nào trên hệ thống.</p>
                </div>
            }
            else
            {
                <div class="edu-table-responsive">
                    <table class="edu-table">
                        <thead>
                            <tr>
                                <th>Mã ĐK</th>
                                <th>Lớp học</th>
                                <th>Khóa học</th>
                                <th>Ngày đăng ký</th>
                                <th>Học phí</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dk in Model.DangKyHocs.OrderByDescending(d => d.NgayDangKy))
                            {
                                <tr>
                                    <td class="fw-bold text-muted">#DK-@dk.MaDangKy</td>
                                    <td class="fw-semibold text-primary">@(dk.LopHoc?.TenLop ?? "—")</td>
                                    <td>@(dk.LopHoc?.KhoaHoc?.TenKhoaHoc ?? "—")</td>
                                    <td>@dk.NgayDangKy.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="fw-bold">@dk.HocPhi.ToString("N0") đ</td>
                                    <td>
                                        @if (dk.TrangThai == "Đã xác nhận")
                                        {
                                            <span class="edu-badge badge-success-soft"><i class="bi bi-check-circle-fill"></i> Đã xác nhận</span>
                                        }
                                        else if (dk.TrangThai == "Chờ xác nhận")
                                        {
                                            <span class="edu-badge badge-warning-soft"><i class="bi bi-hourglass-split"></i> Chờ xác nhận</span>
                                        }
                                        else
                                        {
                                            <span class="edu-badge badge-danger-soft"><i class="bi bi-x-circle-fill"></i> Đã hủy</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
