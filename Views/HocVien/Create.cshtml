@model TrungTamNgoaiNgu.ViewModels.CreateHocVienViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thêm Học Viên Mới · Meta Business Suite";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-1 d-flex align-items-center gap-2">
            <i class="bi bi-person-plus-fill text-primary"></i> Thêm Học Viên Mới
        </h3>
        <p class="text-muted mb-0 small">Tạo hồ sơ học viên, thông tin địa chỉ và khởi tạo tài khoản đăng nhập</p>
    </div>
    <div>
        <a asp-action="Index" class="fb-btn fb-btn-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="fb-card p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="border-bottom pb-2 mb-3">
                    <h6 class="fw-bold text-primary mb-0"><i class="bi bi-shield-lock me-1"></i> 1. Thông tin tài khoản đăng nhập</h6>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="TenDangNhap" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-person-badge"></i></span>
                            <input asp-for="TenDangNhap" class="form-control" placeholder="VD: hocvien_an" />
                        </div>
                        <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MatKhau" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
                            <input asp-for="MatKhau" type="password" class="form-control" placeholder="Mật khẩu khởi tạo" />
                        </div>
                        <span asp-validation-for="MatKhau" class="text-danger small"></span>
                    </div>
                </div>

                <div class="border-bottom pb-2 mb-3">
                    <h6 class="fw-bold text-primary mb-0"><i class="bi bi-person-lines-fill me-1"></i> 2. Thông tin cá nhân học viên</h6>
                </div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="HoTen" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                            <input asp-for="HoTen" class="form-control" placeholder="Họ và tên đầy đủ..." />
                        </div>
                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="GioiTinh" class="form-label fw-semibold"></label>
                        <select asp-for="GioiTinh" class="form-select">
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                        </select>
                        <span asp-validation-for="GioiTinh" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="NgaySinh" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-calendar"></i></span>
                            <input asp-for="NgaySinh" type="date" class="form-control" />
                        </div>
                        <span asp-validation-for="NgaySinh" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="SoDienThoai" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                            <input asp-for="SoDienThoai" class="form-control" placeholder="0912345678" />
                        </div>
                        <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="hocvien@gmail.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Trường thông tin: Địa chỉ (User Spec 4.14) -->
                    <div class="col-md-12">
                        <label asp-for="DiaChi" class="form-label fw-semibold">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i> @Html.DisplayNameFor(m => m.DiaChi)
                        </label>
                        <textarea asp-for="DiaChi" class="form-control" rows="2" placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố..."></textarea>
                        <span asp-validation-for="DiaChi" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="fb-btn fb-btn-secondary">Hủy bỏ</a>
                    <button type="submit" class="fb-btn fb-btn-primary">
                        <i class="bi bi-check-lg me-1"></i> Lưu & Tạo học viên
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
