        <!-- Hangup / End Call -->
        <button type="button" class="btn btn-danger rounded-circle shadow p-0 d-flex align-items-center justify-content-center fb-call-hangup-btn" 
                style="width: 64px; height: 64px;" onclick="hangupCall()" title="Kết thúc cuộc gọi">
            <i class="bi bi-telephone-x-fill fs-3 text-white"></i>
