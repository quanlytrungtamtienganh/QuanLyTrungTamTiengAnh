        if (!msgListEl) return;
        if (msgListEl.querySelector(`[data-msg-id="${data.maTinNhan}"]`)) return;

        const isLike = data.noiDung === '👍' && !data.hinhAnhUrl;
        const imgHtml = data.hinhAnhUrl ? `<div class="mb-1"><a href="${data.hinhAnhUrl}" target="_blank"><img src="${data.hinhAnhUrl}" class="rounded shadow-sm" style="max-width: 100%; max-height: 200px; object-fit: cover;" /></a></div>` : '';
        const txtHtml = isLike ? `<div class="fb-bubble-like">👍</div>` : `<div>${escapeHtml(data.noiDung)}</div>`;

        const bubble = document.createElement('div');
        bubble.dataset.msgId = data.maTinNhan;
        bubble.className = `fb-bubble-theirs ${isLike ? 'fb-bubble-like' : ''}`;
        bubble.innerHTML = `
            ${imgHtml}
            ${txtHtml}
            <div class="fb-chat-msg-time text-end">${data.thoiGian}</div>
        `;
        msgListEl.appendChild(bubble);
        msgListEl.scrollTop = msgListEl.scrollHeight;
        msgListEl.dataset.lastId = data.maTinNhan;
