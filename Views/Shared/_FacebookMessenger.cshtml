            <div class="position-relative mx-auto mb-4" style="width: 140px; height: 140px;">
                <div class="call-pulse-ring ring-1"></div>
                <div class="call-pulse-ring ring-2"></div>
                <img id="callRoomActiveAvatar" src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=150&auto=format&fit=crop&q=80" 
                     class="rounded-circle shadow object-fit-cover w-100 h-100 border border-4 border-primary position-relative" style="z-index: 2;" alt="avatar" />
                <span class="position-absolute bottom-0 end-0 bg-success border border-white rounded-circle p-2" style="z-index: 3;"></span>
