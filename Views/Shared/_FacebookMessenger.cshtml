    <!-- Bottom Controls Toolbar -->
    <div class="d-flex justify-content-center align-items-center gap-3 gap-sm-4 py-2" style="z-index: 25;">
        <!-- Mic toggle -->
        <button type="button" id="btnToggleMic" class="btn btn-light rounded-circle shadow p-0 d-flex align-items-center justify-content-center fb-call-ctrl-btn" 
                style="width: 56px; height: 56px;" onclick="toggleMicrophone()" title="Bật/Tắt Micro">
            <i class="bi bi-mic-fill fs-4 text-dark" id="iconMic"></i>
