<!-- Thư viện Microsoft SignalR Client -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

<script>
    // Tự động bỏ qua màn hình chặn cảnh báo của ngrok khi gọi API từ điện thoại di động
    if (window.fetch) {
        const _origFetch = window.fetch;
        window.fetch = function (url, options = {}) {
            options = options || {};
            if (!options.headers) options.headers = {};
            if (options.headers instanceof Headers) {
                options.headers.set('ngrok-skip-browser-warning', 'true');
            } else if (Array.isArray(options.headers)) {
                options.headers.push(['ngrok-skip-browser-warning', 'true']);
            } else {
                options.headers['ngrok-skip-browser-warning'] = 'true';
            }
            return _origFetch(url, options);
        };
    }

    // State Variables
    const currentSessionUserId = @(sessionUserId ?? 0);
    const currentSessionUserName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(sessionUserName));
    let currentChatMode = 'teacher'; // 'teacher' hoặc 'group'
    let currentTargetTeacherId = null;
    let currentTargetGroupId = null;
    let currentGroupData = null;
    let currentTeacherData = null;
    let chatPollInterval = null;
    let cachedTeachers = [];
    let cachedGroups = [];
    let chat_isUserLoggedIn = @(isLoggedIn ? "true" : "false");
    let chat_userRole = "@(userRole ?? "")";
    let chat_canUserCreateGroup = @(canCreateGroup ? "true" : "false");

    // Calling & WebRTC & SignalR Variables
    let signalRCallConn = null;
    let peerConnection = null;
    let localStream = null;
    let activeCallType = null; // 'voice' hoặc 'video'
    let activeCallTargetUserId = null;
    let activeCallGroupId = null;
    let isCaller = false;
    let isCallActive = false;
    let isCallConnected = false;
    let callTimerInterval = null;
    let callSecondsCount = 0;
    let isMicMuted = false;
    let isCamOff = false;
    let incomingCallData = null;
    let callWindowMinimized = false;
    let groupPeerConnections = {}; // remoteUserId -> RTCPeerConnection
    let groupIceQueues = {}; // remoteUserId -> []
    let currentFacingMode = 'user';

    // 1. Khởi tạo
    document.addEventListener('DOMContentLoaded', function () {
        loadUnreadCount();
        setInterval(loadUnreadCount, 8000);

        // Khởi tạo SignalR Realtime Calling Hub
        if (chat_isUserLoggedIn && currentSessionUserId > 0) {
            initCallSignalR();
        }

        bindMessengerButtons();

        // Unlock Web Audio API trên điện thoại khi người dùng chạm màn hình lần đầu
        const unlockAudio = () => {
            CallSound.init();
            document.removeEventListener('touchstart', unlockAudio);
            document.removeEventListener('click', unlockAudio);
        };
        document.addEventListener('touchstart', unlockAudio, { once: true });
        document.addEventListener('click', unlockAudio, { once: true });

        // Đóng dropdown khi click ra ngoài
        document.addEventListener('click', function (e) {
            const dropdown = document.getElementById('fbMessengerDropdown');
            if (!dropdown) return;
            const isClickInsideDropdown = dropdown.contains(e.target);
            const isClickOnChatButton = e.target.closest('.fb-circle-btn[title*="Messenger"]') || 
                                        e.target.closest('#fbFloatingMessengerBubble') ||
                                        e.target.closest('[onclick*="toggleMessengerDropdown"]');

            if (!isClickInsideDropdown && !isClickOnChatButton && dropdown.style.display === 'block') {
                dropdown.style.display = 'none';
                dropdown.classList.add('d-none');
            }
        });
    });

    function bindMessengerButtons() {
        const btns = document.querySelectorAll('.fb-circle-btn[title*="Messenger"]');
        btns.forEach(btn => {
            btn.removeAttribute('href');
            btn.style.cursor = 'pointer';
            btn.onclick = function (e) {
                toggleMessengerDropdown(e);
            };
        });
    }

    // 2. Chuyển đổi Tab (Giáo viên vs Nhóm chat)
    function switchMessengerTab(tab) {
        const tabTeachers = document.getElementById('fbTabTeachersContent');
        const tabGroups = document.getElementById('fbTabGroupsContent');
        const btnT = document.getElementById('tabBtnTeachers');
        const btnG = document.getElementById('tabBtnGroups');

        if (tab === 'teachers') {
            tabTeachers.style.display = 'block';
            tabGroups.style.display = 'none';
            btnT.className = 'btn btn-sm rounded-pill flex-fill fw-semibold btn-white shadow-sm';
            btnG.className = 'btn btn-sm rounded-pill flex-fill fw-semibold text-secondary';
            loadMessengerTeachers();
        } else {
            tabTeachers.style.display = 'none';
            tabGroups.style.display = 'block';
            btnG.className = 'btn btn-sm rounded-pill flex-fill fw-semibold btn-white shadow-sm';
            btnT.className = 'btn btn-sm rounded-pill flex-fill fw-semibold text-secondary';
            loadMessengerGroups();
        }
    }

    // 3. Mở / Đóng Dropdown
    function toggleMessengerDropdown(e) {
        if (e) {
            e.preventDefault();
            e.stopPropagation();
        }
        const dropdown = document.getElementById('fbMessengerDropdown');
        if (!dropdown) return;

        const isHidden = dropdown.classList.contains('d-none') || dropdown.style.display === 'none' || dropdown.style.display === '';
        if (isHidden) {
            dropdown.classList.remove('d-none');
            dropdown.style.display = 'block';
            loadMessengerTeachers();
            loadMessengerGroups();
        } else {
            dropdown.classList.add('d-none');
            dropdown.style.display = 'none';
        }
    }

    // 4. Tải danh sách TẤT CẢ người dùng (chat 1-1 với bất kỳ ai)
    function loadMessengerTeachers() {
        const loading = document.getElementById('fbTeacherLoading');
        const listEl = document.getElementById('fbTeacherItemsList');
        if (loading) loading.style.display = 'block';

        fetch('/Chat/GetAllUsers')
            .then(res => res.json())
            .then(data => {
                if (loading) loading.style.display = 'none';
                if (data && data.success && data.users) {
                    cachedTeachers = data.users;
                    renderTeachersList(cachedTeachers);
                }
            })
            .catch(() => { if (loading) loading.style.display = 'none'; });
    }

    function renderTeachersList(users) {
        const listEl = document.getElementById('fbTeacherItemsList');
        if (!listEl) return;
        if (!users || users.length === 0) {
            listEl.innerHTML = '<div class="text-muted small p-3 text-center">Không tìm thấy người dùng nào.</div>';
            return;
        }

        let html = '';
        users.forEach(u => {
            const hasUnread = (u.unreadCount && u.unreadCount > 0);
            const unreadBadge = hasUnread ? `<span class="badge rounded-pill bg-danger shadow-sm">${u.unreadCount}</span>` : '';
            const roleBadgeColor = u.vaiTro === 'GiaoVien' ? 'bg-primary' : (u.vaiTro === 'Admin' ? 'bg-danger' : 'bg-secondary');
            const highlightClass = u.isTopHighlight ? 'fb-top-highlight' : '';
            const msgTextStyle = hasUnread ? 'fw-bold text-dark' : 'text-muted';

            html += `
                <div class="fb-messenger-item ${highlightClass}" onclick="openChatWithTeacher(${u.maTaiKhoan})">
                    <div class="position-relative">
                        <img src="${u.anhDaiDien}" alt="${u.hoTen}" class="rounded-circle object-fit-cover shadow-sm" style="width: 44px; height: 44px;" />
                        <span class="position-absolute bottom-0 end-0 bg-success border border-white rounded-circle" style="width: 11px; height: 11px;"></span>
                    </div>
                    <div class="flex-grow-1 text-truncate">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold ${hasUnread ? 'text-primary' : 'text-dark'} text-truncate" style="font-size: 14px;">${u.hoTen}</span>
                            <span class="${hasUnread ? 'fw-bold text-primary' : 'text-muted'}" style="font-size: 11px;">${u.lastMessageTime || ''}</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <span class="badge ${roleBadgeColor} text-white border text-truncate" style="max-width: 150px; font-size: 10px;">${u.chuyenMon}</span>
                            ${unreadBadge}
                        </div>
                        <div class="${msgTextStyle} text-truncate mt-1" style="font-size: 12px;">${escapeHtml(u.lastMessage)}</div>
                    </div>
                </div>
            `;
        });
        listEl.innerHTML = html;
    }

    // 5. Tải danh sách NHÓM CHAT
    function loadMessengerGroups() {
        const loading = document.getElementById('fbGroupLoading');
        const listEl = document.getElementById('fbGroupItemsList');
        if (loading) loading.style.display = 'block';

        fetch('/Chat/GetGroups')
            .then(res => res.json())
            .then(data => {
                if (loading) loading.style.display = 'none';
                if (data && data.success && data.groups) {
                    cachedGroups = data.groups;
                    renderGroupsList(cachedGroups);
                }
            })
            .catch(() => { if (loading) loading.style.display = 'none'; });
    }

    function renderGroupsList(groups) {
        const listEl = document.getElementById('fbGroupItemsList');
        if (!listEl) return;
        if (!groups || groups.length === 0) {
            listEl.innerHTML = `
                <div class="text-muted small p-4 text-center">
                    <i class="bi bi-people fs-2 text-secondary d-block mb-2"></i>
                    <div>Bạn chưa tham gia nhóm chat nào.</div>
                    ${chat_canUserCreateGroup ? '<button type="button" class="btn btn-outline-primary btn-sm rounded-pill mt-2" onclick="openCreateGroupModal()">Tạo nhóm ngay</button>' : ''}
                </div>
            `;
            return;
        }

        let html = '';
        groups.forEach(g => {
            const callBadge = g.cuocGoiDangDienRa 
                ? `<span class="badge bg-success small"><span class="spinner-grow spinner-grow-sm me-1"></span>Đang gọi ${g.loaiCuocGoi === 'video' ? 'Video' : 'Thoại'}</span>`
                : `<span class="badge bg-light text-secondary border">${g.memberCount} thành viên</span>`;
            const highlightClass = g.isTopHighlight ? 'fb-top-highlight' : '';
            const msgTextStyle = g.isTopHighlight ? 'fw-bold text-dark' : 'text-muted';

            html += `
                <div class="fb-messenger-item ${highlightClass}" onclick="openChatWithGroup(${g.maNhom})">
                    <div class="position-relative">
                        <img src="${g.anhNhom}" alt="${g.tenNhom}" class="rounded-3 object-fit-cover shadow-sm" style="width: 44px; height: 44px;" />
                    </div>
                    <div class="flex-grow-1 text-truncate">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-dark text-truncate" style="font-size: 14px;">${g.tenNhom}</span>
                            <span class="text-muted" style="font-size: 11px;">${g.lastMessageTime || ''}</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            ${callBadge}
                        </div>
                        <div class="${msgTextStyle} text-truncate mt-1" style="font-size: 12px;">${escapeHtml(g.lastMessage)}</div>
                    </div>
                </div>
            `;
        });
        listEl.innerHTML = html;
    }

    // 6. Lọc danh sách chung
    function filterMessengerList() {
        const kw = document.getElementById('fbSearchInput').value.toLowerCase().trim();
        if (!kw) {
            renderTeachersList(cachedTeachers);
            renderGroupsList(cachedGroups);
            return;
        }

        renderTeachersList(cachedTeachers.filter(gv => gv.hoTen.toLowerCase().includes(kw) || gv.chuyenMon.toLowerCase().includes(kw)));
        renderGroupsList(cachedGroups.filter(g => g.tenNhom.toLowerCase().includes(kw)));
    }

    // =========================================================================
    // 7. MỞ CHAT 1-1 HOẶC CHAT NHÓM
    // =========================================================================
    function openChatWithTeacher(teacherUserId) {
        currentChatMode = 'teacher';
        currentTargetTeacherId = teacherUserId;
        currentTargetGroupId = null;
        currentTeacherData = cachedTeachers.find(g => g.maTaiKhoan === teacherUserId);

        const dropdown = document.getElementById('fbMessengerDropdown');
        if (dropdown) { dropdown.classList.add('d-none'); dropdown.style.display = 'none'; }

        // Header
        document.getElementById('fbGroupSettingsDropdown').classList.add('d-none');
        document.getElementById('fbActiveCallBanner').classList.add('d-none');
        document.getElementById('fbActiveCallBanner').classList.remove('d-flex');

        if (currentTeacherData) {
            document.getElementById('fbChatTitle').innerText = currentTeacherData.hoTen;
            document.getElementById('fbChatSubtitle').innerText = `Đang hoạt động • ${currentTeacherData.chuyenMon}`;
            document.getElementById('fbChatAvatar').src = currentTeacherData.anhDaiDien;
            document.getElementById('fbChatAvatar').className = 'rounded-circle object-fit-cover shadow-sm';
        }

        showChatBox();
        loadMessages(teacherUserId);
        startPollingChat();
    }

    function openChatWithGroup(groupId) {
        currentChatMode = 'group';
        currentTargetGroupId = groupId;
        currentTargetTeacherId = null;
        currentGroupData = cachedGroups.find(g => g.maNhom === groupId);

        const dropdown = document.getElementById('fbMessengerDropdown');
        if (dropdown) { dropdown.classList.add('d-none'); dropdown.style.display = 'none'; }

        // Đảm bảo kết nối SignalR đã tham gia room của nhóm
        if (signalRCallConn && signalRCallConn.state === signalR.HubConnectionState.Connected) {
            signalRCallConn.invoke("JoinGroupChat", groupId).catch(e => console.warn(e));
        }

        // Header
        document.getElementById('fbGroupSettingsDropdown').classList.remove('d-none');

        if (currentGroupData) {
            document.getElementById('fbChatTitle').innerText = currentGroupData.tenNhom;
            document.getElementById('fbChatSubtitle').innerText = `${currentGroupData.memberCount} thành viên • Quản trị`;
            document.getElementById('fbChatAvatar').src = currentGroupData.anhNhom;
            document.getElementById('fbChatAvatar').className = 'rounded-3 object-fit-cover shadow-sm';

            // Menu quyền
            const menuDel = document.getElementById('menuItemDeleteGroup');
            const menuAdd = document.getElementById('menuItemAddMember');
            if (menuDel) menuDel.style.display = currentGroupData.canManage ? 'block' : 'none';
            if (menuAdd) menuAdd.style.display = currentGroupData.canManage ? 'block' : 'none';

            // Banner cuộc gọi
            updateGroupCallBanner(currentGroupData);
        }

        showChatBox();
        loadGroupMessages(groupId);
        startPollingChat();
    }

    function showChatBox() {
        const chatBox = document.getElementById('fbChatBox');
        if (chatBox) { chatBox.classList.remove('d-none'); chatBox.style.display = 'flex'; }
        const chatBody = document.getElementById('fbChatBody');
        if (chatBody) { chatBody.style.display = 'flex'; }
    }

    function startPollingChat() {
        if (chatPollInterval) clearInterval(chatPollInterval);
        chatPollInterval = setInterval(() => {
            if (currentChatMode === 'teacher' && currentTargetTeacherId) {
                loadMessages(currentTargetTeacherId, true);
            } else if (currentChatMode === 'group' && currentTargetGroupId) {
                loadGroupMessages(currentTargetGroupId, true);
            }
        }, 3000);
    }

    // =========================================================================
    // 8. TẢI & GỬI TIN NHẮN (1-1 & NHÓM)
    // =========================================================================
    function loadMessages(teacherUserId, isPolling = false) {
        const msgListEl = document.getElementById('fbChatMessageList');
        if (!msgListEl) return;

        fetch('/Chat/GetMessages?targetUserId=' + teacherUserId)
            .then(res => res.json())
            .then(data => {
                if (data && data.requireLogin) {
                    msgListEl.innerHTML = `
                        <div class="text-center py-4 px-3 text-muted">
                            <i class="bi bi-person-lock text-primary display-4 mb-2 d-block"></i>
                            <h6 class="fw-bold text-dark">Vui lòng đăng nhập tài khoản</h6>
                            <p class="small text-muted mb-3">Bạn cần đăng nhập để trao đổi trực tiếp với ${currentTeacherData ? currentTeacherData.hoTen : 'giáo viên'}.</p>
                            <a href="/TaiKhoan/Login?returnUrl=${encodeURIComponent(window.location.pathname)}" class="btn btn-primary btn-sm rounded-pill px-4">Đăng nhập ngay</a>
                        </div>
                    `;
                    return;
                }
                if (data && data.success) {
                    renderMessages(data.messages, isPolling);
                    loadUnreadCount();
                }
            })
            .catch(() => {});
    }

    function loadGroupMessages(groupId, isPolling = false) {
        const msgListEl = document.getElementById('fbChatMessageList');
        if (!msgListEl) return;

        fetch('/Chat/GetGroupMessages?maNhom=' + groupId)
            .then(res => res.json())
            .then(data => {
                if (data && data.requireLogin) {
                    msgListEl.innerHTML = `<div class="text-center py-4 px-3 text-muted"><h6 class="fw-bold">Vui lòng đăng nhập để xem nhóm!</h6></div>`;
                    return;
                }
                if (data && data.success) {
                    if (data.groupInfo) {
                        if (!currentGroupData) currentGroupData = {};
                        Object.assign(currentGroupData, data.groupInfo);
                        updateGroupCallBanner(data.groupInfo);
                    }
                    renderGroupMessages(data.messages, isPolling);
                }
            })
            .catch(() => {});
    }

    function updateGroupCallBanner(info) {
        const banner = document.getElementById('fbActiveCallBanner');
        if (!banner) return;
        if (info && info.cuocGoiDangDienRa) {
            banner.classList.remove('d-none');
            banner.classList.add('d-flex');
            const callTypeLabel = (info.loaiCuocGoi === 'video') ? 'Video' : 'Thoại';
            const callerName = info.nguoiGoiTen || 'Thành viên';
            document.getElementById('fbActiveCallText').innerHTML = `Cuộc gọi <strong>${callTypeLabel}</strong> đang diễn ra • ${escapeHtml(callerName)}`;

            const btnJoin = document.getElementById('btnBannerJoinCall');
            const btnEnd = document.getElementById('btnBannerEndCall');

            if (btnJoin) {
                if (isCallActive && activeCallGroupId === info.maNhom) {
                    btnJoin.classList.add('d-none');
                } else {
                    btnJoin.classList.remove('d-none');
                    btnJoin.innerHTML = `<i class="bi bi-telephone-inbound-fill"></i> Tham gia (${callTypeLabel})`;
                }
            }

            if (btnEnd) {
                const canEnd = (info.nguoiGoiId === currentSessionUserId) || (currentGroupData && currentGroupData.canManage) || (isCallActive && activeCallGroupId === info.maNhom);
                if (canEnd) {
                    btnEnd.classList.remove('d-none');
                } else {
                    btnEnd.classList.add('d-none');
                }
            }
        } else {
            banner.classList.add('d-none');
            banner.classList.remove('d-flex');
        }
    }

    function renderMessages(messages, isPolling) {
        const msgListEl = document.getElementById('fbChatMessageList');
        if (!msgListEl) return;
        // So sánh bằng ID tin nhắn cuối cùng (chính xác hơn count)
        const lastId = messages.length > 0 ? messages[messages.length - 1].maTinNhan : 0;
        if (isPolling && msgListEl.dataset.lastId == lastId) return;
        msgListEl.dataset.lastId = lastId;

        if (messages.length === 0) {
            msgListEl.innerHTML = `<div class="text-center py-5 text-muted small"><i class="bi bi-chat-heart text-primary fs-1 mb-2 d-block"></i><div>Bắt đầu cuộc trò chuyện với <strong>${currentTeacherData ? currentTeacherData.hoTen : 'giáo viên'}</strong>.</div></div>`;
            return;
        }

        let html = '';
        messages.forEach(msg => {
            if (msg.loaiTinNhan === 'HeThong' || msg.loaiTinNhan === 'CuocGoi') {
                html += `<div class="fb-bubble-system"><i class="bi ${msg.loaiTinNhan === 'CuocGoi' ? 'bi-telephone-fill text-success' : 'bi-info-circle'} me-1"></i>${escapeHtml(msg.noiDung)} <span class="ms-1 text-muted" style="font-size:10px;">${msg.thoiGian}</span></div>`;
                return;
            }

            const isMine = msg.isMine;
            const bubbleClass = isMine ? 'fb-bubble-mine' : 'fb-bubble-theirs';
            const isLikeThumb = msg.noiDung === '👍' && !msg.hinhAnhUrl;

            let imageHtml = msg.hinhAnhUrl ? `<div class="mb-1"><a href="${msg.hinhAnhUrl}" target="_blank"><img src="${msg.hinhAnhUrl}" class="rounded shadow-sm" style="max-width: 100%; max-height: 200px; object-fit: cover;" /></a></div>` : '';
            let textHtml = isLikeThumb ? `<div class="fb-bubble-like">👍</div>` : `<div>${escapeHtml(msg.noiDung)}</div>`;

            html += `
                <div class="${bubbleClass} ${isLikeThumb ? 'fb-bubble-like' : ''}">
                    ${imageHtml}
                    ${textHtml}
                    <div class="fb-chat-msg-time text-end">${msg.thoiGian}</div>
                </div>
            `;
        });
        msgListEl.innerHTML = html;
        msgListEl.scrollTop = msgListEl.scrollHeight;
    }

    function renderGroupMessages(messages, isPolling) {
        const msgListEl = document.getElementById('fbChatMessageList');
        if (!msgListEl) return;
        // So sánh bằng ID tin nhắn cuối cùng
        const lastId = messages.length > 0 ? messages[messages.length - 1].maTinNhan : 0;
        if (isPolling && msgListEl.dataset.lastId == lastId) return;
        msgListEl.dataset.lastId = lastId;

        if (messages.length === 0) {
            msgListEl.innerHTML = `<div class="text-center py-5 text-muted small"><i class="bi bi-people text-success fs-1 mb-2 d-block"></i><div>Chào mừng bạn đến với nhóm chat! Hãy gửi lời chào đầu tiên.</div></div>`;
            return;
        }

        let html = '';
        messages.forEach(msg => {
            if (msg.loaiTinNhan === 'CuocGoi') {
                const isLive = currentGroupData && currentGroupData.cuocGoiDangDienRa;
                if (isLive) {
                    html += `
                        <div class="fb-call-msg-card w-100 my-2">
                            <div class="d-flex align-items-center justify-content-center gap-2 mb-1">
                                <span class="spinner-grow spinner-grow-sm text-success" style="width: 10px; height: 10px;" role="status"></span>
                                <span class="badge bg-success text-white fw-semibold rounded-pill px-2 py-1" style="font-size:11px;">Cuộc gọi nhóm đang diễn ra</span>
                                <span class="text-muted" style="font-size: 11px;">${msg.thoiGian}</span>
                            </div>
                            <div class="fw-bold text-dark my-1" style="font-size: 13px;">${escapeHtml(msg.noiDung)}</div>
                            <button type="button" class="btn btn-success btn-sm rounded-pill fw-bold px-3 py-1 mt-2 shadow-sm d-inline-flex align-items-center gap-2" onclick="joinActiveGroupCall()">
                                <i class="bi bi-telephone-inbound-fill"></i> Tham gia cuộc gọi ngay
                            </button>
                        </div>
                    `;
                } else {
                    html += `
                        <div class="fb-call-msg-card ended w-100 my-1">
                            <div class="d-flex align-items-center justify-content-center gap-2 mb-1 text-muted" style="font-size: 11px;">
                                <i class="bi bi-telephone-x-fill text-secondary"></i>
                                <span>Cuộc gọi nhóm • ${msg.thoiGian}</span>
                            </div>
                            <div class="small text-secondary fw-semibold">${escapeHtml(msg.noiDung)}</div>
                            <div class="badge bg-secondary-subtle text-secondary border mt-1">Cuộc gọi đã kết thúc</div>
                        </div>
                    `;
                }
                return;
            }

            if (msg.loaiTinNhan === 'HeThong') {
                html += `<div class="fb-bubble-system"><i class="bi bi-info-circle me-1"></i>${escapeHtml(msg.noiDung)} <span class="ms-1" style="font-size:10px;">${msg.thoiGian}</span></div>`;
                return;
            }

            const isMine = msg.isMine;
            const bubbleClass = isMine ? 'fb-bubble-mine' : 'fb-bubble-theirs';
            const isLikeThumb = msg.noiDung === '👍' && !msg.hinhAnhUrl;

            let senderHeader = !isMine ? `<div class="small fw-bold text-primary mb-1 d-flex align-items-center gap-1" style="font-size:11px;"><img src="${msg.nguoiGuiAvatar}" class="rounded-circle" style="width:16px;height:16px;object-fit:cover;" /> ${escapeHtml(msg.nguoiGuiTen)}</div>` : '';
            let imageHtml = msg.hinhAnhUrl ? `<div class="mb-1"><a href="${msg.hinhAnhUrl}" target="_blank"><img src="${msg.hinhAnhUrl}" class="rounded shadow-sm" style="max-width: 100%; max-height: 200px; object-fit: cover;" /></a></div>` : '';
            let textHtml = isLikeThumb ? `<div class="fb-bubble-like">👍</div>` : `<div>${escapeHtml(msg.noiDung)}</div>`;

            html += `
                <div class="${bubbleClass} ${isLikeThumb ? 'fb-bubble-like' : ''}">
                    ${senderHeader}
                    ${imageHtml}
                    ${textHtml}
                    <div class="fb-chat-msg-time text-end">${msg.thoiGian}</div>
                </div>
            `;
        });
        msgListEl.innerHTML = html;
        msgListEl.scrollTop = msgListEl.scrollHeight;
    }

    // Gửi tin nhắn (1-1 hoặc Nhóm)
    function onSendChatClick() {
        const input = document.getElementById('fbChatTextInput');
        const fileInput = document.getElementById('fbChatFileInput');
        const text = input.value.trim();
        const hasImage = fileInput.files && fileInput.files.length > 0;

        if (!text && !hasImage) {
            sendPayload('👍', null);
            return;
        }
        sendPayload(text, hasImage ? fileInput.files[0] : null);
    }

    function sendPayload(text, imageFile) {
        const formData = new FormData();
        if (text) formData.append('noiDung', text);
        if (imageFile) formData.append('imageFile', imageFile);

        document.getElementById('fbChatTextInput').value = '';
        clearSelectedChatImage();
        updateSendButtonState();
        closeEmojiPicker();

        if (currentChatMode === 'teacher') {
            if (!currentTargetTeacherId) return;
            const targetId = currentTargetTeacherId;
            formData.append('targetUserId', targetId);
            fetch('/Chat/SendMessage', { method: 'POST', body: formData })
                .then(res => res.json())
                .then(data => {
                    if (data && data.requireLogin) { alert('Vui lòng đăng nhập!'); return; }
                    if (data && data.success) {
                        loadMessages(targetId);
                        pushTeacherToTop(targetId, null, null, text || '[Hình ảnh]', false);
                    }
                });
        } else {
            if (!currentTargetGroupId) return;
            const grpId = currentTargetGroupId;
            formData.append('maNhom', grpId);
            fetch('/Chat/SendGroupMessage', { method: 'POST', body: formData })
                .then(res => res.json())
                .then(data => {
                    if (data && data.requireLogin) { alert('Vui lòng đăng nhập!'); return; }
                    if (data && data.success) {
                        loadGroupMessages(grpId);
                        pushGroupToTop(grpId, null, null, 'Bạn: ' + (text || '[Hình ảnh]'), false);
                    }
                });
        }
    }

    // =========================================================================
    // 9. QUẢN LÝ NHÓM: TẠO NHÓM, XEM THÀNH VIÊN, KICK, THÊM, XÓA NHÓM
    // =========================================================================
    function openCreateGroupModal() {
        if (!chat_canUserCreateGroup) {
            alert('Chỉ Giáo viên, Quản lý hoặc Admin mới có quyền tạo nhóm chat!');
            return;
        }
        document.getElementById('newGroupNameInput').value = '';
        const modal = new bootstrap.Modal(document.getElementById('fbCreateGroupModal'));
        modal.show();

        // Tải danh sách ứng viên có thể thêm vào nhóm
        const container = document.getElementById('createGroupCandidatesList');
        container.innerHTML = '<div class="text-center py-3 text-muted small"><div class="spinner-border spinner-border-sm text-primary mb-1"></div><div>Đang tải danh sách thành viên...</div></div>';

        fetch('/Chat/GetCandidateMembers?maNhom=0')
            .then(res => res.json())
            .then(data => {
                if (data && data.candidates) {
                    let html = '';
                    data.candidates.forEach(c => {
                        html += `
                            <div class="form-check d-flex align-items-center gap-2 p-2 border-bottom hover-bg">
                                <input class="form-check-input group-member-checkbox" type="checkbox" value="${c.maTaiKhoan}" id="chkUser_${c.maTaiKhoan}" onchange="updateSelectedCount()" />
                                <img src="${c.anhDaiDien}" class="rounded-circle object-fit-cover" style="width:28px;height:28px;" />
                                <label class="form-check-label flex-grow-1 small" for="chkUser_${c.maTaiKhoan}" style="cursor:pointer;">
                                    <strong>${c.hoTen}</strong> <span class="badge bg-light text-muted border ms-1">${c.chuyenMon}</span>
                                </label>
                            </div>
                        `;
                    });
                    container.innerHTML = html || '<div class="text-muted p-2 small">Không có ứng viên nào.</div>';
                }
            });
    }

    function updateSelectedCount() {
        const count = document.querySelectorAll('.group-member-checkbox:checked').length;
        document.getElementById('selectedMembersCount').innerText = `Đã chọn: ${count}`;
    }

    function submitCreateGroup() {
        const name = document.getElementById('newGroupNameInput').value.trim();
        const avatar = document.getElementById('newGroupAvatarInput').value.trim();
        if (!name) { alert('Vui lòng nhập tên nhóm chat!'); return; }

        const checkboxes = document.querySelectorAll('.group-member-checkbox:checked');
        const memberIds = Array.from(checkboxes).map(cb => parseInt(cb.value));

        fetch('/Chat/CreateGroup', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                tenNhom: name,
                anhNhom: avatar,
                memberIds: memberIds
            })
        })
        .then(res => res.json())
        .then(data => {
            if (data && data.success) {
                bootstrap.Modal.getInstance(document.getElementById('fbCreateGroupModal')).hide();
                loadMessengerGroups();
                openChatWithGroup(data.maNhom);
            } else {
                alert(data.message || 'Không thể tạo nhóm chat!');
            }
        });
    }

    // Xem danh sách thành viên nhóm
    function openGroupMembersModal() {
        if (!currentTargetGroupId) return;
        const container = document.getElementById('groupMembersListContainer');
        container.innerHTML = '<div class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm text-primary mb-2"></div><div>Đang tải thành viên...</div></div>';
        const modal = new bootstrap.Modal(document.getElementById('fbGroupMembersModal'));
        modal.show();

        fetch('/Chat/GetGroupMembers?maNhom=' + currentTargetGroupId)
            .then(res => res.json())
            .then(data => {
                if (data && data.members) {
                    let html = '';
                    data.members.forEach(m => {
                        const isLeader = m.vaiTroTrongNhom === 'TruongNhom';
                        const kickBtn = m.canKick ? `<button type="button" class="btn btn-outline-danger btn-sm py-0 px-2 rounded-pill" onclick="kickMember(${m.maTaiKhoan}, '${escapeHtml(m.hoTen)}')"><i class="bi bi-x-circle me-1"></i>Kick</button>` : '';

                        html += `
                            <div class="d-flex justify-content-between align-items-center p-2 border-bottom hover-bg rounded">
                                <div class="d-flex align-items-center gap-2">
                                    <img src="${m.anhDaiDien}" class="rounded-circle object-fit-cover shadow-sm" style="width:36px;height:36px;" />
                                    <div>
                                        <div class="fw-bold small text-dark">${m.hoTen}</div>
                                        <div class="text-muted" style="font-size:11px;">
                                            <span class="badge ${isLeader ? 'bg-primary' : 'bg-light text-dark border'}">${isLeader ? 'Trưởng nhóm' : 'Thành viên'}</span>
                                            &bull; ${m.vaiTro === 'Admin' ? 'Admin' : (m.vaiTro === 'GiaoVien' ? 'Giáo viên' : 'Học viên')}
                                        </div>
                                    </div>
                                </div>
                                <div>${kickBtn}</div>
                            </div>
                        `;
                    });
                    container.innerHTML = html;
                }
            });
    }

    // Kick thành viên
    function kickMember(userId, userName) {
        if (!confirm(`Bạn có chắc chắn muốn mời thành viên "${userName}" ra khỏi nhóm chat này?`)) return;
        fetch('/Chat/KickGroupMember?maNhom=' + currentTargetGroupId + '&maTaiKhoan=' + userId, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if (data && data.success) {
                    openGroupMembersModal();
                    loadGroupMessages(currentTargetGroupId);
                } else {
                    alert(data.message || 'Lỗi khi kick thành viên!');
                }
            });
    }

    // Thêm thành viên vào nhóm
    function openAddMemberModal() {
        if (!currentTargetGroupId) return;
        const container = document.getElementById('addCandidateListContainer');
        container.innerHTML = '<div class="text-center py-3 text-muted small"><div class="spinner-border spinner-border-sm text-primary mb-1"></div><div>Đang tải ứng viên...</div></div>';
        const modal = new bootstrap.Modal(document.getElementById('fbAddMemberModal'));
        modal.show();

        fetch('/Chat/GetCandidateMembers?maNhom=' + currentTargetGroupId)
            .then(res => res.json())
            .then(data => {
                if (data && data.candidates) {
                    if (data.candidates.length === 0) {
                        container.innerHTML = '<div class="text-muted p-3 text-center small">Tất cả tài khoản trong hệ thống đều đã có trong nhóm!</div>';
                        return;
                    }
                    let html = '';
                    data.candidates.forEach(c => {
                        html += `
                            <div class="d-flex justify-content-between align-items-center p-2 border-bottom hover-bg rounded">
                                <div class="d-flex align-items-center gap-2">
