    // 10.4 Bắt đầu cuộc gọi (Người gọi / Caller)
    async function initiateCall(callType) {
        if (!chat_isUserLoggedIn) {
            alert('Vui lòng đăng nhập để thực hiện cuộc gọi!');
            return;
        }

        CallSound.init();
        const preRemoteAudio = document.getElementById('callLiveRemoteAudio');
        const preRemoteVideo = document.getElementById('callLiveRemoteVideo');
        if (preRemoteAudio) preRemoteAudio.play().catch(() => {});
        if (preRemoteVideo) preRemoteVideo.play().catch(() => {});

        if (currentChatMode === 'group') {
            // Nếu nhóm đang có cuộc gọi diễn ra, tham gia trực tiếp thay vì tạo cuộc gọi đè
            if (currentGroupData && currentGroupData.cuocGoiDangDienRa) {
                await joinGroupCallDirectly(currentTargetGroupId, currentGroupData.loaiCuocGoi || callType);
                return;
            }

            if (!currentTargetGroupId) return;
            activeCallGroupId = currentTargetGroupId;
            activeCallTargetUserId = null;
            activeCallType = callType;
            isCaller = true;
            isCallActive = true;
            isCallConnected = false;

            const grpName = currentGroupData ? currentGroupData.tenNhom : 'Nhóm chat';
            const grpAvatar = currentGroupData ? currentGroupData.anhNhom : 'https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=150&auto=format&fit=crop&q=80';

            openCallRoomModal(callType, grpName, grpAvatar, 'Đang chờ thành viên tham gia...');

            // Lấy stream an toàn (hỗ trợ cả PC lẫn điện thoại di động)
            const constraints = {
                audio: true,
                video: callType === 'video' ? { facingMode: 'user', width: { ideal: 640 }, height: { ideal: 480 } } : false
            };

            localStream = await getSafeUserMedia(constraints);
            const localVid = document.getElementById('callLiveLocalVideo');
            if (localVid && localStream) localVid.srcObject = localStream;

            onCallEstablished();

            // Gọi API backend và phát SignalR tới toàn bộ thành viên nhóm
            fetch(`/Chat/StartGroupCall?maNhom=${activeCallGroupId}&loaiCuocGoi=${callType}`, { method: 'POST' })
                .then(r => r.json())
                .then(res => {
                    if (res && res.success) {
                        if (currentGroupData) {
                            currentGroupData.cuocGoiDangDienRa = true;
                            currentGroupData.loaiCuocGoi = callType;
                            currentGroupData.nguoiGoiTen = res.nguoiGoiTen || 'Bạn';
                            updateGroupCallBanner(currentGroupData);
                        }
                        if (signalRCallConn) {
                            signalRCallConn.invoke("StartGroupCall", activeCallGroupId, currentSessionUserId, callType, grpName, res.nguoiGoiTen || 'Thành viên', res.callerAvatar || '')
                                .catch(err => console.error("StartGroupCall invoke error:", err));
                        }
                    }
                });

        } else {
            // Cuộc gọi 1-1 với giáo viên / người dùng
            if (!currentTargetTeacherId) {
                alert('Vui lòng chọn người cần gọi trong danh sách!');
                return;
            }
            activeCallType = callType;
            isCaller = true;
            isCallActive = true;
            isCallConnected = false;
            activeCallTargetUserId = currentTargetTeacherId;
            activeCallGroupId = null;

            const targetName = currentTeacherData ? currentTeacherData.hoTen : 'Người nhận';
            const targetAvatar = currentTeacherData ? currentTeacherData.anhDaiDien : 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=150&auto=format&fit=crop&q=80';

            openCallRoomModal(callType, targetName, targetAvatar, 'Đang đổ chuông...');
            CallSound.playOutgoingTone();

            const constraints = {
                audio: true,
                video: callType === 'video' ? { facingMode: 'user', width: { ideal: 640 }, height: { ideal: 480 } } : false
            };

            localStream = await getSafeUserMedia(constraints);
            const localVid = document.getElementById('callLiveLocalVideo');
            if (localVid && localStream) localVid.srcObject = localStream;

            createPeerConnection(activeCallTargetUserId, false);

            fetch(`/Chat/StartDirectCall?targetUserId=${activeCallTargetUserId}&loaiCuocGoi=${callType}`, { method: 'POST' })
                .then(r => r.json())
                .then(res => {
                    if (res && res.success && signalRCallConn) {
                        signalRCallConn.invoke("CallUser", activeCallTargetUserId, currentSessionUserId, callType, res.callerName, res.callerAvatar)
                            .catch(err => console.error("CallUser invoke error:", err));
                    }
                });
        }
    }

    // 10.4.1 Tham gia trực tiếp vào cuộc gọi nhóm đang diễn ra (Join Ongoing Group Call)
    async function joinGroupCallDirectly(groupId, callType) {
        if (!chat_isUserLoggedIn) {
            alert('Vui lòng đăng nhập để tham gia cuộc gọi nhóm!');
            return;
        }

        dismissIncomingCall();
        CallSound.init();

        const preRemoteAudio = document.getElementById('callLiveRemoteAudio');
        const preRemoteVideo = document.getElementById('callLiveRemoteVideo');
        if (preRemoteAudio) preRemoteAudio.play().catch(() => {});
        if (preRemoteVideo) preRemoteVideo.play().catch(() => {});

        activeCallType = callType || 'video';
        activeCallGroupId = groupId;
        activeCallTargetUserId = null;
        isCaller = false;
        isCallActive = true;
        isCallConnected = false;

        const grpName = currentGroupData ? currentGroupData.tenNhom : 'Nhóm chat';
        const grpAvatar = currentGroupData ? currentGroupData.anhNhom : 'https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=150&auto=format&fit=crop&q=80';

        openCallRoomModal(activeCallType, grpName, grpAvatar, 'Đang trong cuộc gọi nhóm');

        const constraints = {
            audio: true,
            video: activeCallType === 'video' ? { facingMode: 'user', width: { ideal: 640 }, height: { ideal: 480 } } : false
        };

        localStream = await getSafeUserMedia(constraints);
        const localVid = document.getElementById('callLiveLocalVideo');
        if (localVid && localStream) localVid.srcObject = localStream;

        onCallEstablished();

        // Gửi SignalR báo cho cả nhóm biết mình đã tham gia phòng
        const myName = (currentTeacherData && currentTeacherData.hoTen) ? currentTeacherData.hoTen : 'Thành viên';
        const myAvatar = (currentTeacherData && currentTeacherData.anhDaiDien) ? currentTeacherData.anhDaiDien : 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=150&auto=format&fit=crop&q=80';

        if (signalRCallConn) {
            signalRCallConn.invoke("JoinGroupChat", groupId).catch(e => {});
            signalRCallConn.invoke("JoinGroupCall", groupId, currentSessionUserId, myName, myAvatar)
                .catch(err => console.error("JoinGroupCall error:", err));
        }

        // Cập nhật banner trong chat
        if (currentGroupData) {
            updateGroupCallBanner(currentGroupData);
        }
    }

    // 10.5 Trả lời cuộc gọi đến (Người nhận / Receiver)
    async function acceptIncomingCall() {
        if (!incomingCallData) return;
        const callInfo = incomingCallData;
        dismissIncomingCall();

        if (callInfo.isGroup) {
            await joinGroupCallDirectly(callInfo.groupId, callInfo.callType);
        } else {
            // Cuộc gọi 1-1
            CallSound.init();
            const preRemoteAudio = document.getElementById('callLiveRemoteAudio');
            const preRemoteVideo = document.getElementById('callLiveRemoteVideo');
            if (preRemoteAudio) preRemoteAudio.play().catch(() => {});
            if (preRemoteVideo) preRemoteVideo.play().catch(() => {});

            isCaller = false;
            isCallActive = true;
            isCallConnected = false;
            activeCallType = callInfo.callType;
            activeCallTargetUserId = callInfo.callerUserId;
            activeCallGroupId = null;

            openCallRoomModal(activeCallType, callInfo.callerName, callInfo.callerAvatar, 'Đang kết nối...');

            const constraints = {
                audio: true,
                video: activeCallType === 'video' ? { facingMode: 'user', width: { ideal: 640 }, height: { ideal: 480 } } : false
            };

            localStream = await getSafeUserMedia(constraints);
            const localVid = document.getElementById('callLiveLocalVideo');
            if (localVid && localStream) localVid.srcObject = localStream;

            // FIX: Tạo PeerConnection TRƯỚC khi gửi AcceptCall để ICE candidate không bị mất
            createPeerConnection(activeCallTargetUserId, false);

            if (signalRCallConn) {
                signalRCallConn.invoke("AcceptCall", activeCallTargetUserId, currentSessionUserId, activeCallType)
                    .catch(err => console.error("AcceptCall error:", err));
            }
            onCallEstablished();
        }
    }

    // 10.6 Từ chối cuộc gọi
    function rejectIncomingCall() {
        if (!incomingCallData) return;
        const callInfo = incomingCallData;
        dismissIncomingCall();

        if (!callInfo.isGroup && signalRCallConn) {
            signalRCallConn.invoke("RejectCall", callInfo.callerUserId, currentSessionUserId, "Đối phương bận hoặc đã từ chối");
            fetch(`/Chat/EndDirectCall?targetUserId=${callInfo.callerUserId}&loaiCuocGoi=${callInfo.callType}&durationSeconds=0&status=rejected`, { method: 'POST' });
        }
        incomingCallData = null;
    }

    function dismissIncomingCall() {
        CallSound.stop();
        const toast = document.getElementById('fbIncomingCallToast');
        if (toast) toast.classList.add('d-none');
    }

    // 10.7 Khi cuộc gọi đã kết nối thành công (Đếm thời gian + UI xanh)
    function onCallEstablished() {
        isCallConnected = true;
        CallSound.stop();

        const badge = document.getElementById('callRoomStatusBadge');
        if (badge) {
            badge.className = 'badge bg-success px-3 py-2 fs-6 rounded-pill d-flex align-items-center gap-2';
        }
        document.getElementById('callRoomStatusText').innerText = activeCallType === 'video' ? 'Đang gọi Video' : 'Đang gọi Thoại';
        document.getElementById('callSignalDesc').innerText = 'Kết nối trực tuyến HD • Âm thanh rõ nét';

        if (!callTimerInterval) {
            callSecondsCount = 0;
            callTimerInterval = setInterval(() => {
                callSecondsCount++;
                const m = String(Math.floor(callSecondsCount / 60)).padStart(2, '0');
                const s = String(callSecondsCount % 60).padStart(2, '0');
                document.getElementById('callDurationTimer').innerText = `${m}:${s}`;
            }, 1000);
        }
    }

    // 10.8 Gác máy / Kết thúc cuộc gọi
    function hangupCall() {
        const savedDuration = callSecondsCount;
        const savedTargetUser = activeCallTargetUserId;
        const savedType = activeCallType;
        const savedIsGroup = !!activeCallGroupId;
        const savedGroupId = activeCallGroupId;
        const wasCaller = isCaller;

        CallSound.playEndTone();

        // Gửi SignalR thông báo kết thúc hoặc rời phòng
        if (signalRCallConn) {
            if (savedIsGroup) {
                if (wasCaller) {
                    // Người bắt đầu cuộc gọi kết thúc cuộc gọi cho cả nhóm
                    signalRCallConn.invoke("EndGroupCall", savedGroupId, currentSessionUserId).catch(e => {});
                    fetch(`/Chat/EndGroupCall?maNhom=${savedGroupId}`, { method: 'POST' }).then(() => {
                        if (currentTargetGroupId === savedGroupId) loadGroupMessages(savedGroupId);
                    });
                } else {
                    // Thành viên tham gia gác máy rời khỏi phòng
                    signalRCallConn.invoke("LeaveGroupCall", savedGroupId, currentSessionUserId).catch(e => {});
                }
            } else if (savedTargetUser) {
                signalRCallConn.invoke("EndCall", savedTargetUser, currentSessionUserId).catch(e => {});
                const status = (savedDuration > 0 || isCallConnected) ? 'ended' : 'missed';
                fetch(`/Chat/EndDirectCall?targetUserId=${savedTargetUser}&loaiCuocGoi=${savedType}&durationSeconds=${savedDuration}&status=${status}`, { method: 'POST' })
                    .then(r => r.json())
                    .then(data => {
                        if (currentChatMode === 'teacher' && currentTargetTeacherId === savedTargetUser) {
                            loadMessages(savedTargetUser);
                        }
                    });
            }
        }

        cleanupAndCloseCallUI();
    }

    function cleanupAndCloseCallUI() {
        CallSound.stop();
        if (callTimerInterval) {
            clearInterval(callTimerInterval);
            callTimerInterval = null;
        }
        callSecondsCount = 0;
        isCallActive = false;
        isCallConnected = false;
        isCaller = false;
        activeCallTargetUserId = null;
        activeCallGroupId = null;
        iceCandidatesQueue = [];

        // Dừng các media tracks
        if (localStream) {
            localStream.getTracks().forEach(track => track.stop());
            localStream = null;
        }

        // Đóng peer connection đơn 1-1
        if (peerConnection) {
            try { peerConnection.close(); } catch (e) {}
            peerConnection = null;
        }

        // Đóng tất cả peer connections nhóm mesh
        Object.keys(groupPeerConnections).forEach(uid => {
            try { groupPeerConnections[uid].close(); } catch (e) {}
        });
        groupPeerConnections = {};
        groupIceQueues = {};

        // Dọn dẹp video & audio elements — FIX: dừng hết tracks trước khi set null
        const localVid = document.getElementById('callLiveLocalVideo');
        if (localVid) {
            if (localVid.srcObject) {
                localVid.srcObject.getTracks().forEach(t => t.stop());
            }
            localVid.srcObject = null;
        }
        const remoteVid = document.getElementById('callLiveRemoteVideo');
        if (remoteVid) {
            remoteVid.srcObject = null;
            remoteVid.classList.add('d-none');
        }
        const remoteAud = document.getElementById('callLiveRemoteAudio');
        if (remoteAud) {
            remoteAud.srcObject = null;
        }

        // Ẩn Call Room modal
        const room = document.getElementById('fbCallRoomModal');
        if (room) {
            room.classList.add('d-none');
            room.style.display = 'none';
            room.classList.remove('fb-call-minimized');
            callWindowMinimized = false;
        }
        document.getElementById('callDurationTimer').innerText = '00:00';

        // Cập nhật lại banner nhóm nếu đang mở
        if (currentGroupData) {
            updateGroupCallBanner(currentGroupData);
        }
    }

    // 10.9 Mở giao diện Call Room
    function openCallRoomModal(callType, title, avatar, statusText) {
        const room = document.getElementById('fbCallRoomModal');
        room.classList.remove('d-none');
        room.style.display = 'flex';

        document.getElementById('callRoomTitle').innerText = title;
        document.getElementById('callRoomActiveName').innerText = title;
        if (avatar) document.getElementById('callRoomActiveAvatar').src = avatar;

        const badge = document.getElementById('callRoomStatusBadge');
        badge.className = 'badge bg-primary px-3 py-2 fs-6 rounded-pill d-flex align-items-center gap-2';
        document.getElementById('callRoomStatusText').innerText = statusText;
        document.getElementById('callSignalDesc').innerText = 'Đang phát tín hiệu cuộc gọi...';
        document.getElementById('callDurationTimer').innerText = '00:00';

        // Giao diện Video vs Thoại
        const pipBox = document.getElementById('callVideoSimBox');
        const remoteVideo = document.getElementById('callLiveRemoteVideo');
        const voiceStage = document.getElementById('callVoiceStageBox');
        const switchCamBtn = document.getElementById('btnSwitchCam');

        if (callType === 'video') {
            pipBox.classList.remove('d-none');
            remoteVideo.classList.add('d-none');
            voiceStage.classList.remove('d-none');
            if (switchCamBtn) switchCamBtn.classList.remove('d-none');
        } else {
            pipBox.classList.add('d-none');
            remoteVideo.classList.add('d-none');
            voiceStage.classList.remove('d-none');
            if (switchCamBtn) switchCamBtn.classList.add('d-none');
        }

        // Reset trạng thái Mic / Cam
        isMicMuted = false;
        isCamOff = false;
        document.getElementById('iconMic').className = 'bi bi-mic-fill fs-4 text-dark';
        document.getElementById('iconCam').className = 'bi bi-camera-video-fill fs-4 text-dark';

        // Kiểm tra và hiển thị banner cảnh báo nếu thiết bị di động truy cập bằng HTTP
        checkAndShowHttpsWarning();
    }

    function checkAndShowHttpsWarning() {
        const isLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
        if (!window.isSecureContext && !isLocal && window.location.protocol === 'http:') {
            const banner = document.getElementById('callHttpMobileWarningBanner');
            if (banner) banner.classList.remove('d-none');
        }
    }

    function redirectToHttpsCall() {
        const httpsPort = '5001';
        const httpsUrl = 'https://' + window.location.hostname + ':' + httpsPort + window.location.pathname + window.location.search;
        window.location.href = httpsUrl;
    }

    // 10.10 Nút thu nhỏ / phóng to cửa sổ cuộc gọi
    function toggleCallWindowSize() {
        const room = document.getElementById('fbCallRoomModal');
        const icon = document.getElementById('btnResizeIcon');
        callWindowMinimized = !callWindowMinimized;
        if (callWindowMinimized) {
            room.classList.add('fb-call-minimized');
            icon.className = 'bi bi-arrows-angle-expand';
        } else {
            room.classList.remove('fb-call-minimized');
            icon.className = 'bi bi-arrows-angle-contract';
        }
    }

    // 10.11 Nút Bật/Tắt Mic & Camera thực tế
    function toggleMicrophone() {
        if (!localStream) return;
        isMicMuted = !isMicMuted;
        localStream.getAudioTracks().forEach(track => {
            track.enabled = !isMicMuted;
        });
        const icon = document.getElementById('iconMic');
        if (isMicMuted) {
            icon.className = 'bi bi-mic-mute-fill fs-4 text-danger';
        } else {
            icon.className = 'bi bi-mic-fill fs-4 text-dark';
        }
    }

    function toggleCamera() {
        if (!localStream) return;
        isCamOff = !isCamOff;
        localStream.getVideoTracks().forEach(track => {
            track.enabled = !isCamOff;
        });
        const icon = document.getElementById('iconCam');
        const videoBox = document.getElementById('callVideoSimBox');
        if (isCamOff) {
            icon.className = 'bi bi-camera-video-off-fill fs-4 text-danger';
            if (videoBox) videoBox.style.opacity = '0.2';
        } else {
            icon.className = 'bi bi-camera-video-fill fs-4 text-dark';
            if (videoBox) videoBox.style.opacity = '1';
        }
    }

    // Đổi camera trước / sau trên điện thoại di động
    async function switchCamera() {
        if (!localStream || activeCallType !== 'video') return;
        try {
            currentFacingMode = (currentFacingMode === 'user') ? 'environment' : 'user';
            const newStream = await navigator.mediaDevices.getUserMedia({
                video: { facingMode: currentFacingMode, width: { ideal: 640 }, height: { ideal: 480 } },
                audio: false
            });
            const newVideoTrack = newStream.getVideoTracks()[0];
            const oldVideoTrack = localStream.getVideoTracks()[0];
            if (oldVideoTrack) {
                oldVideoTrack.stop();
                localStream.removeTrack(oldVideoTrack);
            }
            localStream.addTrack(newVideoTrack);
            const localVid = document.getElementById('callLiveLocalVideo');
            if (localVid) localVid.srcObject = localStream;

            const replaceTrackOnPc = (pc) => {
                if (!pc) return;
                const sender = pc.getSenders().find(s => s.track && s.track.kind === 'video');
                if (sender) sender.replaceTrack(newVideoTrack);
            };
            if (peerConnection) replaceTrackOnPc(peerConnection);
            Object.values(groupPeerConnections).forEach(pc => {
                replaceTrackOnPc(pc);
            });
        } catch (e) {
            console.warn("switchCamera error:", e);
        }
    }

    // Tham gia cuộc gọi nhóm đang diễn ra (từ banner hoặc từ tin nhắn)
    async function joinActiveGroupCall() {
        if (!currentTargetGroupId) return;
        const callType = (currentGroupData && currentGroupData.loaiCuocGoi) ? currentGroupData.loaiCuocGoi : 'video';
        await joinGroupCallDirectly(currentTargetGroupId, callType);
    }

    // Kết thúc cuộc gọi nhóm từ banner hoặc phòng gọi
    function endCurrentCall() {
        if (isCallActive) {
            hangupCall();
        } else if (currentTargetGroupId) {
            if (confirm("Bạn có chắc chắn muốn kết thúc cuộc gọi của nhóm này không?")) {
                if (signalRCallConn) {
                    signalRCallConn.invoke("EndGroupCall", currentTargetGroupId, currentSessionUserId).catch(e => {});
                }
                fetch(`/Chat/EndGroupCall?maNhom=${currentTargetGroupId}`, { method: 'POST' })
                    .then(() => {
                        loadGroupMessages(currentTargetGroupId);
                    });
            }
        }
    }

    // =========================================================================
    // 12. CÁC HÀM TIỆN ÍCH KHÁC (EMOJI, ẢNH, COLLAPSE, BADGES)
    // =========================================================================
    function onChatImageSelected(input) {
        if (input.files && input.files[0]) {
            const file = input.files[0];
            const reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('fbChatImagePreview').src = e.target.result;
                document.getElementById('fbChatImageName').innerText = file.name;
                document.getElementById('fbChatImagePreviewContainer').classList.remove('d-none');
                document.getElementById('fbChatImagePreviewContainer').classList.add('d-flex');
                updateSendButtonState();
            };
            reader.readAsDataURL(file);
        }
    }

    function clearSelectedChatImage() {
        document.getElementById('fbChatFileInput').value = '';
        const previewContainer = document.getElementById('fbChatImagePreviewContainer');
        previewContainer.classList.add('d-none');
        previewContainer.classList.remove('d-flex');
        updateSendButtonState();
    }

    function toggleEmojiPicker() {
        document.getElementById('fbEmojiPicker').classList.toggle('d-none');
    }
    function closeEmojiPicker() {
        const p = document.getElementById('fbEmojiPicker');
        if (p) p.classList.add('d-none');
    }
    function insertEmoji(emoji) {
        const input = document.getElementById('fbChatTextInput');
        input.value += emoji;
        input.focus();
        updateSendButtonState();
    }
    function updateSendButtonState() {
        const input = document.getElementById('fbChatTextInput');
        const fileInput = document.getElementById('fbChatFileInput');
        const icon = document.getElementById('fbChatActionIcon');
        const hasText = input.value.trim().length > 0;
        const hasImage = fileInput.files && fileInput.files.length > 0;

        if (hasText || hasImage) {
            icon.className = 'bi bi-send-fill text-primary';
            icon.style.fontSize = '17px';
        } else {
            icon.className = 'bi bi-hand-thumbs-up-fill';
            icon.style.fontSize = '20px';
            icon.style.color = '#0866ff';
        }
    }
    function handleChatInputKey(e) {
        if (e.key === 'Enter') onSendChatClick();
    }
    function toggleChatCollapse(e) {
        if (e) e.stopPropagation();
        const body = document.getElementById('fbChatBody');
        body.style.display = (body.style.display === 'none') ? 'flex' : 'none';
    }
    function closeChatBox() {
        const chatBox = document.getElementById('fbChatBox');
        if (chatBox) { chatBox.classList.add('d-none'); chatBox.style.display = 'none'; }
        if (chatPollInterval) clearInterval(chatPollInterval);
        currentTargetTeacherId = null;
        currentTargetGroupId = null;
    }
    function loadUnreadCount() {
        fetch('/Chat/GetUnreadCount')
            .then(res => res.json())
            .then(data => {
                const count = (data && data.count) ? data.count : 0;
                const badges = document.querySelectorAll('.fb-badge-count, #fbFloatingUnreadBadge');
                badges.forEach(badge => {
                    badge.style.display = count > 0 ? 'inline-block' : 'none';
                    if (count > 0) badge.innerText = count;
                });
            })
            .catch(() => {});
    }
    function escapeHtml(text) {
        if (!text) return '';
        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return text.replace(/[&<>"']/g, m => map[m]);
    }
</script>
