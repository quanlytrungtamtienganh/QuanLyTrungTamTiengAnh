    // Tạo Video Track động hiển thị Avatar + Tên + Hiệu ứng sóng âm thanh (Không bao giờ bị màn đen, an toàn 100% không bị dính lỗi CORS Canvas)
    function createDynamicAvatarVideoTrack(name, avatarUrl) {
        try {
            let canvas = document.getElementById('rtcDynamicAvatarCanvas');
            if (!canvas) {
                canvas = document.createElement('canvas');
                canvas.id = 'rtcDynamicAvatarCanvas';
                canvas.width = 640;
                canvas.height = 480;
                canvas.style.position = 'fixed';
                canvas.style.top = '-9999px';
                canvas.style.left = '-9999px';
                canvas.style.opacity = '0';
                canvas.style.pointerEvents = 'none';
                document.body.appendChild(canvas);
            }
            const ctx = canvas.getContext('2d');

            let angle = 0;
            const drawFrame = () => {
                angle += 0.08;
                // Nền gradient công nghệ mượt mà
                const grad = ctx.createLinearGradient(0, 0, canvas.width, canvas.height);
                grad.addColorStop(0, '#0f172a');
                grad.addColorStop(0.5, '#1e1b4b');
                grad.addColorStop(1, '#0f172a');
                ctx.fillStyle = grad;
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                const cx = canvas.width / 2;
                const cy = 190;

                // Các vòng tròn phát sóng động
                for (let i = 1; i <= 3; i++) {
                    const r = 68 + (i * 26) + Math.sin(angle + i * 1.5) * 12;
                    ctx.beginPath();
                    ctx.arc(cx, cy, r, 0, Math.PI * 2);
                    ctx.strokeStyle = `rgba(56, 189, 248, ${0.4 - i * 0.1})`;
                    ctx.lineWidth = 3;
                    ctx.stroke();
                }

                // Vẽ Avatar hình tròn vector đẹp (Không load ảnh ngoài để tránh bị CORS taint canvas)
                ctx.save();
                ctx.beginPath();
                ctx.arc(cx, cy, 60, 0, Math.PI * 2);
                ctx.fillStyle = '#0284c7';
                ctx.fill();

                // Chữ cái đầu tiên
                ctx.fillStyle = '#ffffff';
                ctx.font = 'bold 52px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                const initialChar = (name && name.trim().length > 0) ? name.trim().charAt(0).toUpperCase() : 'U';
                ctx.fillText(initialChar, cx, cy);
                ctx.restore();

                // Viền sáng avatar
                ctx.beginPath();
                ctx.arc(cx, cy, 62, 0, Math.PI * 2);
                ctx.strokeStyle = '#38bdf8';
                ctx.lineWidth = 4;
                ctx.stroke();

                // Tên người dùng
                ctx.fillStyle = '#ffffff';
                ctx.font = 'bold 24px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText(name || 'Người dùng', cx, 310);

                // Badge trạng thái
                ctx.fillStyle = '#38bdf8';
                ctx.font = '15px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
                ctx.fillText('🎙️ Âm thanh HD • Camera mô phỏng trực tuyến', cx, 345);
            };

            drawFrame();
            const timer = setInterval(drawFrame, 66); // ~15 fps

            const captureFunc = canvas.captureStream || canvas.mozCaptureStream;
            if (captureFunc) {
                const stream = captureFunc.call(canvas, 15);
                if (stream && stream.getVideoTracks().length > 0) {
                    const track = stream.getVideoTracks()[0];
                    const origStop = track.stop.bind(track);
                    track.stop = () => {
                        clearInterval(timer);
                        if (canvas && canvas.parentNode) canvas.parentNode.removeChild(canvas);
                        origStop();
                    };
                    return track;
                }
            }
        } catch (e) {
            console.warn("[WebRTC] createDynamicAvatarVideoTrack error:", e);
        }
        return null;
    }

    function createSyntheticAudioTrack() {
        try {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (AudioCtx) {
                const actx = new AudioCtx();
                if (actx.state === 'suspended') actx.resume();
                const dest = actx.createMediaStreamDestination();
                const osc = actx.createOscillator();
                const gain = actx.createGain();
                gain.gain.value = 0.001;
                osc.connect(gain);
                gain.connect(dest);
                osc.start();
                if (dest.stream && dest.stream.getAudioTracks().length > 0) {
                    return dest.stream.getAudioTracks()[0];
                }
            }
        } catch (e) {
            console.warn("[WebRTC] Synthetic audio error:", e);
        }
        return null;
    }

    // Hàm lấy MediaStream an toàn: Hỗ trợ PC, Mobile, fallback camera linh hoạt không bao giờ bị đen màn hình
    async function getSafeUserMedia(constraints) {
        // 1. Kiểm tra Secure Context (Bảo mật trình duyệt)
        const isLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
        if (!window.isSecureContext && !isLocal && window.location.protocol === 'http:') {
            const httpsPort = '5001';
            const httpsUrl = 'https://' + window.location.hostname + ':' + httpsPort + window.location.pathname + window.location.search;
            const shouldRedirect = confirm("📱 THÔNG BÁO CHO THIẾT BỊ DI ĐỘNG & MẠNG LAN:\n\nTrình duyệt điện thoại chặn Camera & Micro khi truy cập bằng giao thức HTTP thường.\n\nBạn có muốn chuyển sang HTTPS (Cổng 5001) để bật đầy đủ hình ảnh camera & âm thanh không?\n(Sau khi chuyển, chọn 'Nâng cao / Advanced' -> 'Tiếp tục truy cập')");
            if (shouldRedirect) {
                window.location.href = httpsUrl;
                return null;
            }
        }

        let mediaStream = null;

        // 2. Chuẩn WebRTC hiện đại
        if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
            // Thử lần 1: với constraints yêu cầu
            try {
                mediaStream = await navigator.mediaDevices.getUserMedia(constraints);
                console.log("[WebRTC] Lấy MediaStream thành công với constraints ban đầu.");
                return mediaStream;
            } catch (err1) {
                console.warn("[WebRTC] Lần 1 thất bại:", err1.name, err1.message);
            }

            // Thử lần 2: Nới lỏng cấu hình video (hỗ trợ mobile & camera đặc thù)
            if (constraints.video) {
                try {
                    const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
                    mediaStream = await navigator.mediaDevices.getUserMedia({
                        audio: true,
                        video: isMobile ? { facingMode: 'user' } : true
                    });
                    console.log("[WebRTC] Lấy MediaStream thành công (chế độ tương thích).");
                    return mediaStream;
                } catch (err2) {
                    console.warn("[WebRTC] Lần 2 (relaxed) thất bại:", err2.name, err2.message);
                }

                try {
                    mediaStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: true });
                    console.log("[WebRTC] Lấy MediaStream thành công (video: true).");
                    return mediaStream;
                } catch (err3) {
                    console.warn("[WebRTC] Lần 3 (video: true) thất bại:", err3.name, err3.message);
                }
            }

            // Thử lần 4: Lấy âm thanh thật (Microphone) nếu camera đang bận do ứng dụng khác hoặc tab khác
            let audioOnlyStream = null;
            try {
                audioOnlyStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
                console.log("[WebRTC] Đã lấy Microphone thật thành công!");
            } catch (errAudio) {
                console.warn("[WebRTC] Không thể mở Microphone:", errAudio.name, errAudio.message);
            }

            // Nếu người dùng gọi video nhưng Camera bị khóa/bận/không có:
            // Ghép Microphone thật với Video Track mô phỏng Avatar động rực rỡ để KHÔNG BAO GIỜ BỊ MÀN ĐEN
            if (constraints.video) {
                const combined = new MediaStream();
                if (audioOnlyStream && audioOnlyStream.getAudioTracks().length > 0) {
                    audioOnlyStream.getAudioTracks().forEach(t => combined.addTrack(t));
                } else {
                    const synthA = createSyntheticAudioTrack();
                    if (synthA) combined.addTrack(synthA);
                }

                const myAvatar = (currentTeacherData && currentTeacherData.anhDaiDien) ? currentTeacherData.anhDaiDien : '';
                const synthV = createDynamicAvatarVideoTrack(currentSessionUserName || 'Bạn', myAvatar);
                if (synthV) combined.addTrack(synthV);

                return combined;
            } else if (audioOnlyStream) {
                return audioOnlyStream;
            }
        }

        // 3. Fallback hoàn toàn nếu không có getUserMedia
        const fallbackStream = new MediaStream();
        const synthA = createSyntheticAudioTrack();
        if (synthA) fallbackStream.addTrack(synthA);
        if (constraints.video) {
            const synthV = createDynamicAvatarVideoTrack(currentSessionUserName || 'Bạn', '');
            if (synthV) fallbackStream.addTrack(synthV);
        }
        return fallbackStream;
    }

    // Helper chuẩn hóa dữ liệu WebRTC (Candidate & SDP) gửi nhận qua SignalR chống lỗi serialization
    function formatIceCandidateForSignal(cand) {
        if (!cand) return null;
        return {
            candidate: cand.candidate || '',
            sdpMid: (cand.sdpMid !== undefined && cand.sdpMid !== null) ? String(cand.sdpMid) : '0',
            sdpMLineIndex: (cand.sdpMLineIndex !== undefined && cand.sdpMLineIndex !== null) ? Number(cand.sdpMLineIndex) : 0,
            usernameFragment: cand.usernameFragment || ''
        };
    }

    function parseIceCandidateFromSignal(raw) {
        if (!raw) return null;
        const candStr = (typeof raw === 'string') ? raw : (raw.candidate || '');
        if (!candStr) return null;
        return {
            candidate: candStr,
            sdpMid: (raw.sdpMid !== undefined && raw.sdpMid !== null) ? String(raw.sdpMid) : '0',
            sdpMLineIndex: (raw.sdpMLineIndex !== undefined && raw.sdpMLineIndex !== null) ? Number(raw.sdpMLineIndex) : 0,
            usernameFragment: raw.usernameFragment || ''
        };
    }

    function formatSdpForSignal(desc) {
        if (!desc) return null;
        return {
            type: desc.type,
            sdp: desc.sdp
        };
    }

    // Hàng đợi giải quyết triệt để Race-Condition của ICE Candidate giữa PC & Mobile
    let iceCandidatesQueue = [];

    async function processQueuedIceCandidates() {
        if (!peerConnection || !peerConnection.remoteDescription || !peerConnection.remoteDescription.type) {
            return;
        }
        if (iceCandidatesQueue.length > 0) {
            console.log(`[WebRTC] Đang nạp ${iceCandidatesQueue.length} queued ICE candidates`);
            while (iceCandidatesQueue.length > 0) {
                const cand = iceCandidatesQueue.shift();
                try {
                    await peerConnection.addIceCandidate(new RTCIceCandidate(cand));
                } catch (e) {
                    console.warn("[WebRTC] Lỗi addIceCandidate từ queue:", e);
                }
            }
        }
    }

    function createPeerConnection(remoteTargetId, isGroup = false) {
        if (peerConnection) {
            try { peerConnection.close(); } catch (e) {}
            peerConnection = null;
        }

        try {
            peerConnection = new RTCPeerConnection(rtcConfiguration);
            console.log('[WebRTC] RTCPeerConnection khởi tạo thành công.');
        } catch (e) {
            console.error('[WebRTC] Không thể tạo RTCPeerConnection:', e);
            return null;
        }

        // Truyền tracks từ localStream sang đối phương
        if (localStream) {
            localStream.getTracks().forEach(track => {
                peerConnection.addTrack(track, localStream);
                console.log('[WebRTC] addTrack:', track.kind, track.label);
            });
        }

        // Gửi ICE Candidate qua SignalR (chuẩn hóa dữ liệu object an toàn)
        peerConnection.onicecandidate = (event) => {
            if (event.candidate && signalRCallConn) {
                const candData = formatIceCandidateForSignal(event.candidate);
                if (candData && candData.candidate) {
                    if (isGroup) {
                        signalRCallConn.invoke("SendGroupSignal", remoteTargetId, currentSessionUserId, { candidate: candData })
                            .catch(err => console.error("SignalR SendGroupSignal error:", err));
                    } else {
                        signalRCallConn.invoke("SendSignal", remoteTargetId, currentSessionUserId, { candidate: candData })
                            .catch(err => console.error("SignalR SendSignal error:", err));
                    }
                }
            }
        };

        // Khi nhận track media từ đối phương
        if (!peerConnection._remoteStream) {
            peerConnection._remoteStream = new MediaStream();
        }
        peerConnection.ontrack = (event) => {
            console.log('[WebRTC] ontrack received:', event.track.kind, 'streams:', event.streams ? event.streams.length : 0);
            const remoteVideo = document.getElementById('callLiveRemoteVideo');
            const remoteAudio = document.getElementById('callLiveRemoteAudio');
            const voiceStage = document.getElementById('callVoiceStageBox');

            // 1. Luôn thêm track vào _remoteStream tích lũy an toàn
            if (!peerConnection._remoteStream.getTracks().some(t => t.id === event.track.id)) {
                peerConnection._remoteStream.addTrack(event.track);
                console.log('[WebRTC] Track added to _remoteStream:', event.track.kind, event.track.id);
            }

            const nativeStream = peerConnection._remoteStream;

            // 2. Gán vào video element khi nhận được video track
            if (event.track.kind === 'video' && remoteVideo) {
                if (!remoteVideo.srcObject || remoteVideo.srcObject.id !== nativeStream.id) {
                    remoteVideo.srcObject = nativeStream;
                }
                remoteVideo.muted = false;
                remoteVideo.volume = 1.0;
                remoteVideo.classList.remove('d-none');
                if (voiceStage) voiceStage.classList.add('d-none');
                remoteVideo.play().catch(e => {
                    console.warn("[WebRTC] remoteVideo play unmuted error, fallback muted:", e);
                    remoteVideo.muted = true;
                    remoteVideo.play().catch(() => {});
                });
            }

            // 3. Gán vào audio element để phát âm thanh rõ ràng
            if (event.track.kind === 'audio' && remoteAudio) {
                if (!remoteAudio.srcObject || remoteAudio.srcObject.id !== nativeStream.id) {
                    remoteAudio.srcObject = nativeStream;
                }
                remoteAudio.muted = false;
                remoteAudio.volume = 1.0;
                remoteAudio.play().catch(e => console.warn("[WebRTC] remoteAudio play warning:", e));
            }

            // 4. Lắng nghe track unmuted & ended events
            event.track.onunmute = () => {
                console.log(`[WebRTC] Track unmuted: ${event.track.kind}`);
                if (event.track.kind === 'video' && remoteVideo) {
                    remoteVideo.play().catch(() => {});
                }
                if (event.track.kind === 'audio' && remoteAudio) {
                    remoteAudio.muted = false;
                    remoteAudio.play().catch(() => {});
                }
            };
            event.track.onended = () => {
                console.log(`[WebRTC] Track ended: ${event.track.kind}`);
            };
        };

        peerConnection.onconnectionstatechange = () => {
            console.log('[WebRTC] ConnectionState:', peerConnection.connectionState);
            const sub = document.getElementById('callRoomSubTitle');
            if (peerConnection.connectionState === 'connected') {
                if (sub) sub.innerText = 'Đã kết nối trực tuyến HD';
                onCallEstablished();
            } else if (peerConnection.connectionState === 'connecting') {
                if (sub) sub.innerText = 'Đang thiết lập kênh trực tiếp...';
            } else if (peerConnection.connectionState === 'failed') {
                if (sub) sub.innerText = 'Lỗi kết nối P2P (Failed)';
            }
        };

        peerConnection.oniceconnectionstatechange = () => {
            console.log('[WebRTC] ICE ConnectionState:', peerConnection.iceConnectionState);
            const sub = document.getElementById('callRoomSubTitle');
            if (peerConnection.iceConnectionState === 'connected' || peerConnection.iceConnectionState === 'completed') {
                if (sub) sub.innerText = 'Đã kết nối trực tuyến HD';
                onCallEstablished();
            } else if (peerConnection.iceConnectionState === 'checking') {
                if (sub) sub.innerText = 'Đang bắt tay ICE...';
            } else if (peerConnection.iceConnectionState === 'failed') {
                if (sub) sub.innerText = 'Lỗi ICE kết nối';
            }
        };

        return peerConnection;
    }

    // Khởi tạo RTCPeerConnection riêng biệt cho từng thành viên trong cuộc gọi nhóm (WebRTC Mesh)
    function createPeerConnectionForGroupMember(remoteUserId, remoteUserName, isInitiator) {
        if (groupPeerConnections[remoteUserId]) {
            try { groupPeerConnections[remoteUserId].close(); } catch (e) {}
            delete groupPeerConnections[remoteUserId];
        }

        let pc;
        try {
            pc = new RTCPeerConnection(rtcConfiguration);
            groupPeerConnections[remoteUserId] = pc;
            console.log(`[WebRTC Group] Đã tạo RTCPeerConnection cho user ${remoteUserId}`);
        } catch (e) {
            console.error('[WebRTC Group] Lỗi tạo PeerConnection:', e);
            return null;
        }

        // Truyền tracks từ localStream sang đối phương
        if (localStream) {
            localStream.getTracks().forEach(track => {
                pc.addTrack(track, localStream);
            });
        }

        // Gửi ICE Candidate cho riêng user này qua SignalR
        pc.onicecandidate = (event) => {
            if (event.candidate && signalRCallConn && activeCallGroupId) {
                const candData = formatIceCandidateForSignal(event.candidate);
                if (candData && candData.candidate) {
                    signalRCallConn.invoke("SendGroupSignalToPeer", activeCallGroupId, currentSessionUserId, remoteUserId, { candidate: candData })
                        .catch(err => console.error("SendGroupSignalToPeer candidate error:", err));
                }
            }
        };

        // Khi nhận track media từ đối phương (WebRTC Mesh nhóm)
        // --- FIX: Dùng _remoteStream tích lũy an toàn, không phụ thuộc vào event.streams ---
        pc._remoteStream = new MediaStream();
        pc.ontrack = (event) => {
            console.log(`[WebRTC Group] ontrack received từ user ${remoteUserId}:`, event.track.kind);
            const remoteVideo = document.getElementById('callLiveRemoteVideo');
            const remoteAudio = document.getElementById('callLiveRemoteAudio');
            const voiceStage = document.getElementById('callVoiceStageBox');

            if (!pc._remoteStream.getTracks().some(t => t.id === event.track.id)) {
                pc._remoteStream.addTrack(event.track);
            }

            // Luôn dùng _remoteStream tích lũy (ổn định trên PC lẫn mobile)
            const nativeStream = pc._remoteStream;

            if (event.track.kind === 'video' && remoteVideo) {
                if (!remoteVideo.srcObject || remoteVideo.srcObject.id !== nativeStream.id) {
                    remoteVideo.srcObject = nativeStream;
                }
                remoteVideo.muted = false;
                remoteVideo.volume = 1.0;
                remoteVideo.classList.remove('d-none');
                if (voiceStage) voiceStage.classList.add('d-none');
                remoteVideo.play().catch(e => {
                    console.warn("[WebRTC Group] Video play unmuted warning, trying muted:", e);
                    remoteVideo.muted = true;
                    remoteVideo.play().catch(() => {});
                });
            }

            if (event.track.kind === 'audio' && remoteAudio) {
                if (!remoteAudio.srcObject || remoteAudio.srcObject.id !== nativeStream.id) {
                    remoteAudio.srcObject = nativeStream;
                }
                remoteAudio.muted = false;
                remoteAudio.volume = 1.0;
                remoteAudio.play().catch(e => console.warn("[WebRTC Group] Audio play warning:", e));
            }

            event.track.onunmute = () => {
                console.log(`[WebRTC Group] Track unmuted từ user ${remoteUserId}:`, event.track.kind);
                if (event.track.kind === 'video' && remoteVideo) remoteVideo.play().catch(() => {});
                if (event.track.kind === 'audio' && remoteAudio) {
                    remoteAudio.muted = false;
                    remoteAudio.play().catch(() => {});
                }
            };

            onCallEstablished();
        };

        pc.onconnectionstatechange = () => {
            console.log(`[WebRTC Group] User ${remoteUserId} ConnectionState:`, pc.connectionState);
            if (pc.connectionState === 'connected') {
                onCallEstablished();
            }
        };

        pc.oniceconnectionstatechange = () => {
            console.log(`[WebRTC Group] User ${remoteUserId} ICE ConnectionState:`, pc.iceConnectionState);
            if (pc.iceConnectionState === 'connected' || pc.iceConnectionState === 'completed') {
                onCallEstablished();
            }
        };

        return pc;
    }

    // 10.3 Khởi tạo kết nối SignalR CallHub
    function initCallSignalR() {
        if (!chat_isUserLoggedIn || !currentSessionUserId || typeof signalR === 'undefined') return;

        signalRCallConn = new signalR.HubConnectionBuilder()
            .withUrl("/callHub")
            .withAutomaticReconnect([0, 2000, 5000, 10000])
            .build();

        // Tự động đăng ký lại khi SignalR kết nối lại (đặc biệt hữu ích trên di động khi khóa màn hình)
        signalRCallConn.onreconnected(connectionId => {
            console.log("[SignalR] CallHub đã kết nối lại! connectionId:", connectionId);
            if (currentSessionUserId > 0) {
                signalRCallConn.invoke("RegisterUser", currentSessionUserId)
                    .catch(e => console.error("[SignalR] Lỗi đăng ký lại sau reconnect:", e));
            }
        });

        // A. Nhận cuộc gọi đến 1-1
        signalRCallConn.on("IncomingCall", function (data) {
            console.log("SignalR IncomingCall:", data);
            if (isCallActive) {
                signalRCallConn.invoke("RejectCall", data.callerUserId, currentSessionUserId, "Người dùng đang trong cuộc gọi khác");
                return;
            }
            incomingCallData = data;
            incomingCallData.isGroup = false;

            document.getElementById('incomingCallerName').innerText = data.callerName;
            document.getElementById('incomingGroupTitle').innerText = 'đang gọi cho bạn...';
            document.getElementById('incomingCallerAvatar').src = data.callerAvatar;
            document.getElementById('incomingCallTypeBadge').innerText = data.callType === 'video' ? '📹 Cuộc gọi Video đến' : '📞 Cuộc gọi Thoại đến';

            document.getElementById('fbIncomingCallToast').classList.remove('d-none');
            CallSound.playIncomingRingtone();
        });

        // B. Đối phương đã nhấc máy / chấp nhận cuộc gọi
        signalRCallConn.on("CallAccepted", async function (data) {
            console.log("SignalR CallAccepted:", data);
            CallSound.stop();
            onCallEstablished();

            // Nếu là người gọi, bắt đầu tạo WebRTC Offer
            if (isCaller && peerConnection) {
                try {
                    const senders = peerConnection.getSenders();
                    if (senders.length === 0 && localStream) {
                        localStream.getTracks().forEach(track => {
                            peerConnection.addTrack(track, localStream);
                            console.log('[WebRTC] Re-addTrack (CallAccepted):', track.kind);
                        });
                    }

                    const offer = await peerConnection.createOffer({
                        offerToReceiveAudio: true,
                        offerToReceiveVideo: (activeCallType === 'video')
                    });
                    await peerConnection.setLocalDescription(offer);
                    console.log('[WebRTC] Offer SDP tạo thành công, gửi tới đối phương...');
                    const sdpPayload = formatSdpForSignal(peerConnection.localDescription);
                    await signalRCallConn.invoke("SendSignal", activeCallTargetUserId, currentSessionUserId, { sdp: sdpPayload });
                } catch (err) {
                    console.error("Lỗi khi tạo WebRTC Offer:", err);
                }
            }
        });

        // C. Đối phương từ chối
        signalRCallConn.on("CallRejected", function (data) {
            console.log("SignalR CallRejected:", data);
            CallSound.stop();
            CallSound.playBusyTone();

            const badge = document.getElementById('callRoomStatusBadge');
            if (badge) badge.className = 'badge bg-danger px-3 py-2 fs-6 rounded-pill d-flex align-items-center gap-2';
            document.getElementById('callRoomStatusText').innerText = data.reason || 'Đối phương đã từ chối';
            document.getElementById('callSignalDesc').innerText = 'Cuộc gọi kết thúc';

            setTimeout(() => {
                cleanupAndCloseCallUI();
            }, 2500);
        });

        // D. Đối phương gác máy
        signalRCallConn.on("CallEnded", function (data) {
            console.log("SignalR CallEnded:", data);
            CallSound.playEndTone();
            cleanupAndCloseCallUI();
            if (currentChatMode === 'teacher' && currentTargetTeacherId) {
                loadMessages(currentTargetTeacherId);
            }
        });

        // E. Trao đổi tín hiệu WebRTC P2P (SDP Offer/Answer & ICE Candidates với Queue chống rớt gói)
        signalRCallConn.on("ReceiveSignal", async function (data) {
            console.log("[SignalR] ReceiveSignal:", data);

            // 1. Nếu là ICE Candidate
            if (data.signalData && data.signalData.candidate) {
                const candData = parseIceCandidateFromSignal(data.signalData.candidate);
                if (candData && candData.candidate) {
                    if (!peerConnection || !peerConnection.remoteDescription || !peerConnection.remoteDescription.type) {
                        console.log("[WebRTC] RemoteDescription chưa sẵn sàng, lưu candidate vào hàng đợi.");
                        iceCandidatesQueue.push(candData);
                    } else {
                        try {
                            await peerConnection.addIceCandidate(new RTCIceCandidate(candData));
                        } catch (err) {
                            console.warn("[WebRTC] Lỗi addIceCandidate:", err);
                        }
                    }
                }
                return;
            }

            // 2. Nếu là SDP Offer / Answer
            if (data.signalData && data.signalData.sdp) {
                const sdp = data.signalData.sdp;
                if (!peerConnection) {
                    console.warn("[WebRTC] Nhận SDP nhưng peerConnection chưa tạo, khởi tạo ngay...");
                    createPeerConnection(data.senderUserId, false);
                }

                try {
                    const sdpType = sdp.type;
                    const sdpContent = sdp.sdp || sdp;
                    const rtcDesc = new RTCSessionDescription({ type: sdpType, sdp: sdpContent });

                    if (sdpType === 'offer') {
                        console.log("[WebRTC] Nhận Offer từ đối phương, đang thiết lập RemoteDescription...");
                        await peerConnection.setRemoteDescription(rtcDesc);
                        await processQueuedIceCandidates();

                        // Đảm bảo localStream tracks đã được add trước khi tạo answer
                        if (localStream) {
                            const existingSenders = peerConnection.getSenders();
                            localStream.getTracks().forEach(track => {
                                const alreadyAdded = existingSenders.some(s => s.track && s.track.id === track.id);
                                if (!alreadyAdded) {
                                    peerConnection.addTrack(track, localStream);
                                    console.log('[WebRTC] addTrack trước createAnswer:', track.kind);
                                }
                            });
                        }

                        const answer = await peerConnection.createAnswer();
                        await peerConnection.setLocalDescription(answer);
                        console.log("[WebRTC] Đã tạo Answer, gửi về người gọi...");
                        const sdpPayload = formatSdpForSignal(peerConnection.localDescription);
                        await signalRCallConn.invoke("SendSignal", data.senderUserId, currentSessionUserId, { sdp: sdpPayload });
                    } else if (sdpType === 'answer') {
                        console.log("[WebRTC] Nhận Answer từ đối phương, đang thiết lập RemoteDescription...");
                        await peerConnection.setRemoteDescription(rtcDesc);
                        await processQueuedIceCandidates();
                    }
                } catch (err) {
                    console.error("[WebRTC] Lỗi xử lý SDP:", err);
                }
            }
        });

        // F. Cuộc gọi nhóm
        signalRCallConn.on("GroupIncomingCall", function (data) {
            console.log("SignalR GroupIncomingCall:", data);
            // 1. Cập nhật trạng thái nhóm trong cachedGroups
            const grp = cachedGroups.find(g => g.maNhom === data.groupId);
            if (grp) {
                grp.cuocGoiDangDienRa = true;
                grp.loaiCuocGoi = data.callType;
                grp.nguoiGoiTen = data.callerName;
                renderGroupsList(cachedGroups);
            }
            // 2. Cập nhật banner nếu đang mở nhóm này
            if (currentChatMode === 'group' && currentTargetGroupId === data.groupId) {
                if (!currentGroupData) currentGroupData = {};
                currentGroupData.cuocGoiDangDienRa = true;
                currentGroupData.loaiCuocGoi = data.callType;
                currentGroupData.nguoiGoiTen = data.callerName;
                updateGroupCallBanner(currentGroupData);
            }
            // 3. Nếu chưa trong cuộc gọi nào và không phải chính mình gọi, hiện Toast chuông gọi đến
            if (!isCallActive && data.callerUserId !== currentSessionUserId) {
                incomingCallData = data;
                incomingCallData.isGroup = true;

                document.getElementById('incomingCallerName').innerText = data.callerName;
                document.getElementById('incomingGroupTitle').innerText = `trong nhóm "${data.groupName}"`;
                document.getElementById('incomingCallerAvatar').src = data.callerAvatar || 'https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=150&auto=format&fit=crop&q=80';
                document.getElementById('incomingCallTypeBadge').innerText = data.callType === 'video' ? '📹 Cuộc gọi Video nhóm' : '📞 Cuộc gọi Thoại nhóm';

                document.getElementById('fbIncomingCallToast').classList.remove('d-none');
                CallSound.playIncomingRingtone();
            }
        });

        signalRCallConn.on("GroupCallEnded", function (data) {
            console.log("SignalR GroupCallEnded:", data);
            // 1. Nếu đang hiển thị toast chuông gọi đến của nhóm này, ẩn đi
            if (incomingCallData && incomingCallData.isGroup && incomingCallData.groupId === data.groupId) {
                dismissIncomingCall();
            }
            // 2. Nếu đang trong cuộc gọi nhóm này, đóng phòng gọi
            if (activeCallGroupId === data.groupId) {
                CallSound.playEndTone();
                cleanupAndCloseCallUI();
            }
            // 3. Cập nhật cachedGroups
            const grp = cachedGroups.find(g => g.maNhom === data.groupId);
            if (grp) {
                grp.cuocGoiDangDienRa = false;
                grp.loaiCuocGoi = null;
                grp.nguoiGoiTen = null;
                renderGroupsList(cachedGroups);
            }
            // 4. Cập nhật banner nếu đang mở nhóm này
            if (currentChatMode === 'group' && currentTargetGroupId === data.groupId) {
                if (currentGroupData) {
                    currentGroupData.cuocGoiDangDienRa = false;
                    updateGroupCallBanner(currentGroupData);
                }
                loadGroupMessages(data.groupId, true);
            }
        });

        // Nhận thông báo thay đổi trạng thái cuộc gọi nhóm (bắt đầu / kết thúc)
        signalRCallConn.on("GroupCallStateChanged", function (data) {
            console.log("SignalR GroupCallStateChanged:", data);
            const grp = cachedGroups.find(g => g.maNhom === data.groupId);
            if (grp) {
                grp.cuocGoiDangDienRa = data.isCallActive;
                grp.loaiCuocGoi = data.callType;
                grp.nguoiGoiTen = data.callerName;
                renderGroupsList(cachedGroups);
            }
            if (currentChatMode === 'group' && currentTargetGroupId === data.groupId) {
                if (!currentGroupData) currentGroupData = {};
                currentGroupData.cuocGoiDangDienRa = data.isCallActive;
                currentGroupData.loaiCuocGoi = data.callType;
                currentGroupData.nguoiGoiTen = data.callerName;
                updateGroupCallBanner(currentGroupData);
                loadGroupMessages(data.groupId, true);
            }
        });

        // Khi có thành viên mới tham gia vào cuộc gọi nhóm đang diễn ra (WebRTC Mesh Initiator)
        signalRCallConn.on("UserJoinedGroupCall", async function (data) {
            console.log("SignalR UserJoinedGroupCall:", data);
            if (!isCallActive || activeCallGroupId !== data.groupId || data.userId === currentSessionUserId) return;

            const remoteId = data.userId;
            const pc = createPeerConnectionForGroupMember(remoteId, data.userName, true);
            if (!pc) return;

            try {
                const offer = await pc.createOffer({
                    offerToReceiveAudio: true,
                    offerToReceiveVideo: (activeCallType === 'video')
                });
                await pc.setLocalDescription(offer);
                console.log(`[WebRTC Group] Đã tạo Offer, gửi tới user ${remoteId}...`);
                const sdpPayload = formatSdpForSignal(pc.localDescription);
                await signalRCallConn.invoke("SendGroupSignalToPeer", activeCallGroupId, currentSessionUserId, remoteId, { sdp: sdpPayload });
            } catch (err) {
                console.error("[WebRTC Group] Lỗi tạo Offer:", err);
            }
        });

        // Khi một thành viên rời khỏi cuộc gọi nhóm
        signalRCallConn.on("UserLeftGroupCall", function (data) {
            console.log("SignalR UserLeftGroupCall:", data);
            if (groupPeerConnections[data.userId]) {
                try { groupPeerConnections[data.userId].close(); } catch (e) {}
                delete groupPeerConnections[data.userId];
            }
        });

        // Trao đổi tín hiệu WebRTC P2P trong nhóm (SDP Offer/Answer & ICE Candidates)
        signalRCallConn.on("ReceiveGroupSignal", async function (data) {
            console.log("[SignalR] ReceiveGroupSignal:", data);
            if (data.targetUserId && data.targetUserId !== currentSessionUserId) return;
            if (data.senderUserId === currentSessionUserId) return;

            const senderId = data.senderUserId;

            // 1. ICE Candidate
            if (data.signalData && data.signalData.candidate) {
                const candData = parseIceCandidateFromSignal(data.signalData.candidate);
                if (candData && candData.candidate) {
                    const pc = groupPeerConnections[senderId] || peerConnection;
                    if (!pc || !pc.remoteDescription || !pc.remoteDescription.type) {
                        if (!groupIceQueues[senderId]) groupIceQueues[senderId] = [];
                        groupIceQueues[senderId].push(candData);
                    } else {
                        try {
                            await pc.addIceCandidate(new RTCIceCandidate(candData));
                        } catch (err) {
                            console.warn("[WebRTC Group] Lỗi addIceCandidate:", err);
                        }
                    }
                }
                return;
            }

            // 2. SDP Offer / Answer
            if (data.signalData && data.signalData.sdp) {
                const sdp = data.signalData.sdp;
                const sdpType = sdp.type;
                const sdpContent = sdp.sdp || sdp;
                const rtcDesc = new RTCSessionDescription({ type: sdpType, sdp: sdpContent });

                if (sdpType === 'offer') {
                    console.log(`[WebRTC Group] Nhận Offer từ user ${senderId}, tạo Answer...`);
                    let pc = groupPeerConnections[senderId];
                    if (!pc) {
                        pc = createPeerConnectionForGroupMember(senderId, 'Thành viên', false);
                    }
                    try {
                        await pc.setRemoteDescription(rtcDesc);
                        if (groupIceQueues[senderId] && groupIceQueues[senderId].length > 0) {
                            for (const c of groupIceQueues[senderId]) {
                                try { await pc.addIceCandidate(new RTCIceCandidate(c)); } catch (e) {}
                            }
                            groupIceQueues[senderId] = [];
                        }

                        const answer = await pc.createAnswer();
                        await pc.setLocalDescription(answer);
                        console.log(`[WebRTC Group] Đã tạo Answer, gửi về user ${senderId}...`);
                        const sdpPayload = formatSdpForSignal(pc.localDescription);
                        await signalRCallConn.invoke("SendGroupSignalToPeer", activeCallGroupId, currentSessionUserId, senderId, { sdp: sdpPayload });
                    } catch (err) {
                        console.error("[WebRTC Group] Lỗi xử lý Offer SDP:", err);
                    }
                } else if (sdpType === 'answer') {
                    console.log(`[WebRTC Group] Nhận Answer từ user ${senderId}...`);
                    const pc = groupPeerConnections[senderId];
                    if (pc) {
                        try {
                            await pc.setRemoteDescription(rtcDesc);
                            if (groupIceQueues[senderId] && groupIceQueues[senderId].length > 0) {
                                for (const c of groupIceQueues[senderId]) {
                                    try { await pc.addIceCandidate(new RTCIceCandidate(c)); } catch (e) {}
                                }
                                groupIceQueues[senderId] = [];
                            }
                        } catch (err) {
                            console.error("[WebRTC Group] Lỗi setRemoteDescription Answer:", err);
                        }
                    }
                }
            }
        });

        // G. Nhận tin nhắn trực tiếp 1-1 thời gian thực
        signalRCallConn.on("ReceiveDirectMessage", function (data) {
            console.log("SignalR ReceiveDirectMessage:", data);
            handleIncomingDirectMessage(data);
        });

        // H. Nhận tin nhắn nhóm thời gian thực
        signalRCallConn.on("ReceiveGroupMessage", function (data) {
            console.log("SignalR ReceiveGroupMessage:", data);
            handleIncomingGroupMessage(data);
        });

        // Bắt đầu kết nối và đăng ký user
        signalRCallConn.start()
            .then(() => {
                console.log("SignalR CallHub đã kết nối thành công!");
                signalRCallConn.invoke("RegisterUser", currentSessionUserId);
            })
            .catch(err => console.error("SignalR CallHub start error:", err));
    }

    // =========================================================================
    // 10.3.1 XỬ LÝ NHẬN TIN NHẮN REALTIME & ĐẨY LÊN ĐẦU DANH SÁCH
    // =========================================================================
    let toastNewMessageTimer = null;
    let currentToastSenderData = null;

    function handleIncomingDirectMessage(data) {
        const isChatOpenWithSender = (currentChatMode === 'teacher' && 
                                      currentTargetTeacherId === data.senderUserId && 
                                      isChatBoxVisible());

        if (isChatOpenWithSender) {
            appendDirectMessage(data);
            CallSound.playMessagePop();
            fetch('/Chat/GetMessages?targetUserId=' + data.senderUserId).catch(() => {});
        } else {
            showNewMessageToast({
                type: 'teacher',
                targetId: data.senderUserId,
                title: data.senderName,
                avatar: data.senderAvatar,
                content: data.noiDung || (data.loaiTinNhan === 'HinhAnh' ? '[Hình ảnh]' : 'Tin nhắn mới'),
                badge: 'Tin nhắn mới'
            });
            CallSound.playMessageChime();
            loadUnreadCount();
        }

        // Đẩy người gửi lên trên đầu danh sách tin nhắn
        pushTeacherToTop(data.senderUserId, data.senderName, data.senderAvatar, data.noiDung || (data.loaiTinNhan === 'HinhAnh' ? '[Hình ảnh]' : 'Tin nhắn mới'), !isChatOpenWithSender);
    }

    function handleIncomingGroupMessage(data) {
        if (data.senderUserId === currentSessionUserId) return;

        const isChatOpenWithGroup = (currentChatMode === 'group' && 
                                     currentTargetGroupId === data.groupId && 
                                     isChatBoxVisible());

        if (isChatOpenWithGroup) {
            appendGroupMessage(data);
            CallSound.playMessagePop();
        } else {
            showNewMessageToast({
                type: 'group',
                targetId: data.groupId,
                title: `${data.senderName} (${data.groupName})`,
                avatar: data.senderAvatar,
                content: data.noiDung || (data.loaiTinNhan === 'HinhAnh' ? '[Hình ảnh]' : 'Tin nhắn mới'),
                badge: 'Tin nhắn nhóm'
            });
            CallSound.playMessageChime();
        }

        // Đẩy nhóm lên trên đầu danh sách tin nhắn
        pushGroupToTop(data.groupId, data.groupName, null, `${data.senderName}: ${data.noiDung || '[Hình ảnh]'}`, !isChatOpenWithGroup);
    }

    function pushTeacherToTop(userId, name, avatar, lastText, isUnread) {
        let user = cachedTeachers.find(u => u.maTaiKhoan === userId);
        if (user) {
            user.lastMessage = lastText;
            user.lastMessageTime = 'Vừa xong';
            if (isUnread) user.unreadCount = (user.unreadCount || 0) + 1;
            user.isTopHighlight = true;
            cachedTeachers = [user, ...cachedTeachers.filter(u => u.maTaiKhoan !== userId)];
        } else if (name) {
            user = {
                maTaiKhoan: userId,
                hoTen: name,
                anhDaiDien: avatar || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=150&auto=format&fit=crop&q=80',
                chuyenMon: 'Người dùng',
                vaiTro: 'HocVien',
                isOnline: true,
                lastMessage: lastText,
                lastMessageTime: 'Vừa xong',
                unreadCount: isUnread ? 1 : 0,
                isTopHighlight: true
            };
            cachedTeachers = [user, ...cachedTeachers];
        }
        renderTeachersList(cachedTeachers);
        setTimeout(() => { if (user) user.isTopHighlight = false; }, 3000);
    }

    function pushGroupToTop(groupId, groupName, groupAvatar, lastText, isUnread) {
        let group = cachedGroups.find(g => g.maNhom === groupId);
        if (group) {
            group.lastMessage = lastText;
            group.lastMessageTime = 'Vừa xong';
            group.isTopHighlight = true;
            cachedGroups = [group, ...cachedGroups.filter(g => g.maNhom !== groupId)];
        } else if (groupName) {
            group = {
                maNhom: groupId,
                tenNhom: groupName,
                anhNhom: groupAvatar || 'https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=150&auto=format&fit=crop&q=80',
                memberCount: 2,
                lastMessage: lastText,
                lastMessageTime: 'Vừa xong',
                isTopHighlight: true
            };
            cachedGroups = [group, ...cachedGroups];
        }
        renderGroupsList(cachedGroups);
        setTimeout(() => { if (group) group.isTopHighlight = false; }, 3000);
    }

