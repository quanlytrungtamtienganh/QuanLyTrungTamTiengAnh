                style="width: 56px; height: 56px;" onclick="toggleCamera()" title="Bật/Tắt Camera">
            <i class="bi bi-camera-video-fill fs-4 text-dark" id="iconCam"></i>
        </button>

        <!-- Flip/Switch camera on mobile -->
        <button type="button" id="btnSwitchCam" class="btn btn-light rounded-circle shadow p-0 d-flex align-items-center justify-content-center fb-call-ctrl-btn d-none" 
                style="width: 56px; height: 56px;" onclick="switchCamera()" title="Đổi camera trước/sau">
            <i class="bi bi-arrow-repeat fs-4 text-dark" id="iconSwitchCam"></i>
