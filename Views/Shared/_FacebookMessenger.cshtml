@* Component Chat Facebook Messenger: Chat 1-1 với Giáo viên & Chat Nhóm, Quản lý thành viên, Gọi Thoại & Video Call *@
@{
    var sessionUserId = Context.Session.GetInt32("MaTaiKhoan");
    var sessionUserName = Context.Session.GetString("HoTen") ?? "Bạn";
    var userRole = Context.Session.GetString("VaiTro");
    var isLoggedIn = sessionUserId.HasValue;
    var canCreateGroup = userRole == "Admin" || userRole == "GiaoVien";
}

<!-- =========================================================================
     1. MESSENGER DROPDOWN: TABS GIÁO VIÊN & NHÓM CHAT
     ========================================================================= -->
<div id="fbMessengerDropdown" class="fb-messenger-dropdown shadow-lg d-none" 
     style="position: fixed; top: 56px; right: 20px; width: 380px; max-width: calc(100vw - 30px); background: #ffffff; border-radius: 12px; border: 1px solid #ced0d4; z-index: 10050; box-shadow: 0 12px 28px 0 rgba(0,0,0,0.25), 0 2px 4px 0 rgba(0,0,0,0.1); overflow: hidden; display: none;">
    <!-- Dropdown Header -->
    <div class="p-3 border-bottom bg-white">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-messenger text-primary"></i> Đoạn chat Messenger
            </h5>
            <div class="d-flex gap-1 align-items-center">
                @if (canCreateGroup)
                {
                    <button type="button" class="btn btn-sm btn-primary py-1 px-2 rounded-pill small fw-semibold" onclick="openCreateGroupModal()" title="Chỉ Giáo viên và Quản lý/Admin được tạo nhóm">
                        <i class="bi bi-plus-lg me-1"></i>Tạo nhóm
                    </button>
                }
                <button type="button" class="btn btn-sm btn-light rounded-circle p-0 d-flex align-items-center justify-content-center" 
                        style="width: 28px; height: 28px;" onclick="toggleMessengerDropdown(event)" title="Đóng">✕</button>
            </div>
        </div>

        <!-- Navigation Tabs: Mọi người vs Nhóm chat -->
        <div class="d-flex gap-1 bg-light p-1 rounded-pill mb-2">
            <button type="button" id="tabBtnTeachers" class="btn btn-sm rounded-pill flex-fill fw-semibold btn-white shadow-sm" onclick="switchMessengerTab('teachers')">
                <i class="bi bi-people-fill me-1 text-primary"></i> Mọi người
            </button>
            <button type="button" id="tabBtnGroups" class="btn btn-sm rounded-pill flex-fill fw-semibold text-secondary" onclick="switchMessengerTab('groups')">
                <i class="bi bi-chat-dots-fill me-1 text-success"></i> Nhóm chat
            </button>
        </div>

        <!-- Search input -->
        <div class="input-group input-group-sm">
            <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" id="fbSearchInput" class="form-control bg-light border-0" 
                   placeholder="Tìm kiếm..." onkeyup="filterMessengerList()" />
        </div>
    </div>

    <!-- Tab 1: Danh sách Giáo viên trung tâm -->
    <div id="fbTabTeachersContent" style="max-height: 400px; overflow-y: auto; padding: 6px; background: #fff;">
        <div class="text-center py-4 text-muted small" id="fbTeacherLoading">
            <div class="spinner-border spinner-border-sm text-primary mb-2" role="status"></div>
            <div>Đang tải danh sách giáo viên...</div>
        </div>
        <div id="fbTeacherItemsList"></div>
    </div>

    <!-- Tab 2: Danh sách Nhóm chat -->
    <div id="fbTabGroupsContent" style="max-height: 400px; overflow-y: auto; padding: 6px; background: #fff; display: none;">
        <div class="text-center py-4 text-muted small" id="fbGroupLoading">
            <div class="spinner-border spinner-border-sm text-success mb-2" role="status"></div>
            <div>Đang tải danh sách nhóm chat...</div>
        </div>
        <div id="fbGroupItemsList"></div>
    </div>

    <!-- Dropdown Footer -->
    <div class="p-2 border-top bg-light d-flex justify-content-between align-items-center small text-muted px-3">
        <span><i class="bi bi-shield-check text-success me-1"></i>Hệ thống chat trung tâm</span>
        @if (canCreateGroup)
        {
            <span class="badge bg-success-subtle text-success border border-success-subtle">Quyền Quản lý / Giáo viên</span>
        }
    </div>
</div>

<!-- =========================================================================
     2. CỬA SỔ CHAT NỔI (FLOATING CHAT BOX: HỖ TRỢ CẢ 1-1 VÀ NHÓM CHAT)
     ========================================================================= -->
<div id="fbChatBox" class="fb-chat-box shadow-lg d-none" 
     style="position: fixed; bottom: 0; right: 90px; width: 360px; max-width: calc(100vw - 20px); background: #fff; border-radius: 12px 12px 0 0; border: 1px solid #ced0d4; z-index: 10040; box-shadow: 0 12px 28px rgba(0,0,0,0.25); display: none; flex-direction: column;">
    
    <!-- Chat Header -->
    <div class="p-2 px-3 border-bottom d-flex justify-content-between align-items-center bg-white" 
         style="border-radius: 12px 12px 0 0; cursor: pointer;" onclick="toggleChatCollapse(event)">
        
        <div class="d-flex align-items-center gap-2 text-truncate">
            <div class="position-relative">
                <img id="fbChatAvatar" src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=150&auto=format&fit=crop&q=80" 
                     alt="Avatar" class="rounded-circle object-fit-cover shadow-sm" style="width: 38px; height: 38px;" />
                <span id="fbChatOnlineBadge" class="position-absolute bottom-0 end-0 bg-success border border-white rounded-circle" style="width: 10px; height: 10px;"></span>
            </div>
            <div class="text-truncate">
                <div id="fbChatTitle" class="fw-bold text-dark text-truncate" style="font-size: 14px;">Cô Mai Anh</div>
                <div id="fbChatSubtitle" class="text-muted text-truncate" style="font-size: 11px;">Đang hoạt động &bull; IELTS 8.5</div>
            </div>
        </div>

        <!-- Header Actions: Gọi thoại, Video Call, Menu nhóm, Thu nhỏ, Đóng -->
        <div class="d-flex align-items-center gap-1" onclick="event.stopPropagation()">
            <!-- Nút gọi thoại (Voice call) -->
            <button type="button" class="btn btn-sm btn-light rounded-circle text-primary" title="Bắt đầu cuộc gọi thoại (Voice Call)" onclick="initiateCall('voice')">
                <i class="bi bi-telephone-fill" style="font-size: 13px;"></i>
            </button>
            <!-- Nút gọi video (Video call) -->
            <button type="button" class="btn btn-sm btn-light rounded-circle text-primary" title="Bắt đầu cuộc gọi video (Video Call)" onclick="initiateCall('video')">
                <i class="bi bi-camera-video-fill" style="font-size: 13px;"></i>
            </button>
            
            <!-- Menu tùy chọn nhóm (chỉ hiển thị khi chat nhóm) -->
            <div class="dropdown d-none" id="fbGroupSettingsDropdown">
                <button type="button" class="btn btn-sm btn-light rounded-circle text-secondary" data-bs-toggle="dropdown" aria-expanded="false" title="Tùy chọn nhóm">
                    <i class="bi bi-three-dots-vertical" style="font-size: 14px;"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow p-2" style="font-size: 13px; min-width: 190px;">
                    <li><a class="dropdown-item py-1 rounded" href="javascript:void(0)" onclick="openGroupMembersModal()"><i class="bi bi-people me-2"></i>Xem thành viên</a></li>
                    <li id="menuItemAddMember"><a class="dropdown-item py-1 rounded text-primary" href="javascript:void(0)" onclick="openAddMemberModal()"><i class="bi bi-person-plus me-2"></i>Thêm thành viên</a></li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li id="menuItemDeleteGroup"><a class="dropdown-item py-1 rounded text-danger" href="javascript:void(0)" onclick="confirmDeleteCurrentGroup()"><i class="bi bi-trash3 me-2"></i>Xóa nhóm chat</a></li>
                </ul>
            </div>

            <button type="button" class="btn btn-sm btn-light rounded-circle" title="Thu nhỏ" onclick="toggleChatCollapse(event)">
                <i class="bi bi-dash-lg" style="font-size: 14px;"></i>
            </button>
            <button type="button" class="btn btn-sm btn-light rounded-circle text-secondary" title="Đóng chat" onclick="closeChatBox()">
                <i class="bi bi-x-lg" style="font-size: 14px;"></i>
            </button>
        </div>
    </div>

    <!-- Active Call Live Pulsing Banner (Khi nhóm có cuộc gọi đang diễn ra) -->
    <div id="fbActiveCallBanner" class="px-3 py-2 text-white d-none justify-content-between align-items-center shadow-sm" 
         style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border-bottom: 1px solid rgba(255,255,255,0.25); font-size: 12px; z-index: 5;">
        <div class="d-flex align-items-center gap-2 text-truncate me-2">
            <span class="spinner-grow spinner-grow-sm text-white flex-shrink-0" role="status" style="width: 10px; height: 10px;"></span>
            <span id="fbActiveCallText" class="fw-semibold text-truncate">Cuộc gọi nhóm đang diễn ra...</span>
        </div>
        <div class="d-flex gap-1 flex-shrink-0 align-items-center">
            <button type="button" id="btnBannerJoinCall" class="btn btn-light btn-sm py-1 px-3 fw-bold rounded-pill shadow-sm d-flex align-items-center gap-1" style="font-size: 11px; color: #047857;" onclick="joinActiveGroupCall()">
                <i class="bi bi-telephone-inbound-fill"></i> Tham gia
            </button>
            <button type="button" id="btnBannerEndCall" class="btn btn-outline-light btn-sm py-1 px-2 rounded-pill d-none" style="font-size: 11px;" onclick="endCurrentCall()">
                Kết thúc
            </button>
        </div>
    </div>

    <!-- Chat Body (Messages List) -->
    <div id="fbChatBody" style="display: flex; flex-direction: column; height: 360px;">
        <div id="fbChatMessageList" style="flex: 1; overflow-y: auto; padding: 12px; background: #fff; display: flex; flex-direction: column; gap: 8px;">
            <!-- Messages rendered via JS -->
        </div>

        <!-- Image Preview Thumbnail -->
        <div id="fbChatImagePreviewContainer" class="p-2 border-top bg-light d-none align-items-center gap-2">
            <div class="position-relative">
                <img id="fbChatImagePreview" src="" alt="preview" style="height: 50px; width: 50px; object-fit: cover; border-radius: 8px; border: 1px solid #ced0d4;" />
                <button type="button" class="btn btn-danger btn-sm rounded-circle position-absolute top-0 end-0 p-0" 
                        style="width: 18px; height: 18px; font-size: 10px; line-height: 1; transform: translate(30%, -30%);" onclick="clearSelectedChatImage()">✕</button>
            </div>
            <span class="small text-muted text-truncate" id="fbChatImageName">image.png</span>
        </div>

        <!-- Emoji Picker Popover -->
        <div id="fbEmojiPicker" class="p-2 border-top bg-light d-none" style="max-height: 160px; overflow-y: auto;">
            <div class="small fw-semibold text-muted mb-1 px-1">Biểu tượng cảm xúc Facebook:</div>
            <div class="d-flex flex-wrap gap-1" style="font-size: 20px;">
                <span class="fb-emoji-item p-1 rounded" style="cursor: pointer;" onclick="insertEmoji('👍')">👍</span>
                <span class="fb-emoji-item p-1 rounded" style="cursor: pointer;" onclick="insertEmoji('❤️')">❤️</span>
                <span class="fb-emoji-item p-1 rounded" style="cursor: pointer;" onclick="insertEmoji('😂')">😂</span>
                <span class="fb-emoji-item p-1 rounded" style="cursor: pointer;" onclick="insertEmoji('😍')">😍</span>
                <span class="fb-emoji-item p-1 rounded" style="cursor: pointer;" onclick="insertEmoji('😮')">😮</span>
                <span class="fb-emoji-item p-1 rounded" style="cursor: pointer;" onclick="insertEmoji('😢')">😢</span>
                <span class="fb-emoji-item p-1 rounded" style="cursor: pointer;" onclick="insertEmoji('😡')">😡</span>
                <span class="fb-emoji-item p-1 rounded" style="cursor: pointer;" onclick="insertEmoji('🔥')">🔥</span>
                <span class="fb-emoji-item p-1 rounded" style="cursor: pointer;" onclick="insertEmoji('👏')">👏</span>
                <span class="fb-emoji-item p-1 rounded" style="cursor: pointer;" onclick="insertEmoji('🎉')">🎉</span>
                <span class="fb-emoji-item p-1 rounded" style="cursor: pointer;" onclick="insertEmoji('📚')">📚</span>
                <span class="fb-emoji-item p-1 rounded" style="cursor: pointer;" onclick="insertEmoji('🎓')">🎓</span>
                <span class="fb-emoji-item p-1 rounded" style="cursor: pointer;" onclick="insertEmoji('✍️')">✍️</span>
                <span class="fb-emoji-item p-1 rounded" style="cursor: pointer;" onclick="insertEmoji('🎯')">🎯</span>
                <span class="fb-emoji-item p-1 rounded" style="cursor: pointer;" onclick="insertEmoji('💡')">💡</span>
                <span class="fb-emoji-item p-1 rounded" style="cursor: pointer;" onclick="insertEmoji('💯')">💯</span>
                <span class="fb-emoji-item p-1 rounded" style="cursor: pointer;" onclick="insertEmoji('🌟')">🌟</span>
                <span class="fb-emoji-item p-1 rounded" style="cursor: pointer;" onclick="insertEmoji('📝')">📝</span>
                <span class="fb-emoji-item p-1 rounded" style="cursor: pointer;" onclick="insertEmoji('👌')">👌</span>
                <span class="fb-emoji-item p-1 rounded" style="cursor: pointer;" onclick="insertEmoji('🤝')">🤝</span>
            </div>
        </div>

        <!-- Chat Footer / Input Controls -->
        <div class="p-2 border-top bg-white d-flex align-items-center gap-1">
            <!-- Attach Image Button -->
            <label for="fbChatFileInput" class="btn btn-sm btn-light rounded-circle text-primary m-0 d-flex align-items-center justify-content-center" 
                   style="width: 32px; height: 32px; cursor: pointer;" title="Đính kèm hình ảnh">
                <i class="bi bi-images" style="font-size: 16px;"></i>
            </label>
            <input type="file" id="fbChatFileInput" accept="image/*" style="display: none;" onchange="onChatImageSelected(this)" />

            <!-- Emoji Picker Toggle -->
            <button type="button" class="btn btn-sm btn-light rounded-circle text-warning p-0 d-flex align-items-center justify-content-center" 
                    style="width: 32px; height: 32px;" title="Biểu cảm Facebook" onclick="toggleEmojiPicker()">
                <i class="bi bi-emoji-smile-fill" style="font-size: 18px;"></i>
            </button>

            <!-- Text Input -->
            <div class="flex-grow-1">
                <input type="text" id="fbChatTextInput" class="form-control form-control-sm rounded-pill border-0 bg-light px-3" 
                       placeholder="Aa / Nhập tin nhắn..." autocomplete="off" onkeyup="handleChatInputKey(event)" oninput="updateSendButtonState()" />
            </div>

            <!-- Thumbs Up / Send Action Button -->
            <button type="button" id="fbChatActionBtn" class="btn btn-sm btn-light rounded-circle p-0 d-flex align-items-center justify-content-center text-primary" 
                    style="width: 34px; height: 34px;" title="Gửi Like hoặc Tin nhắn" onclick="onSendChatClick()">
                <i id="fbChatActionIcon" class="bi bi-hand-thumbs-up-fill" style="font-size: 20px; color: #0866ff;"></i>
            </button>
        </div>
    </div>
</div>

<!-- =========================================================================
     3. FLOATING MESSENGER BUBBLE AT BOTTOM-RIGHT
     ========================================================================= -->
<div id="fbFloatingMessengerBubble" class="shadow-lg position-fixed" 
     style="bottom: 24px; right: 24px; width: 56px; height: 56px; border-radius: 50%; background: linear-gradient(135deg, #0084ff, #00c6ff); color: #fff; display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 10030; box-shadow: 0 4px 16px rgba(0,132,255,0.45); transition: transform 0.2s;" 
     onclick="toggleMessengerDropdown(event)" title="Nhắn tin với giáo viên & nhóm học">
    <i class="bi bi-messenger" style="font-size: 26px;"></i>
    <span id="fbFloatingUnreadBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display:none; font-size: 11px;">0</span>
</div>

<!-- =========================================================================
     4. MODAL: TẠO NHÓM CHAT MỚI (CHỈ GIÁO VIÊN & ADMIN)
     ========================================================================= -->
<div class="modal fade" id="fbCreateGroupModal" tabindex="-1" aria-hidden="true" style="z-index: 10060;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0 rounded-4">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-people-fill text-primary"></i> Tạo Nhóm Chat Mới
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Tên nhóm chat <span class="text-danger">*</span></label>
                    <input type="text" id="newGroupNameInput" class="form-control" placeholder="VD: Lớp IELTS Intensive K38, CLB Tiếng Nhật N3..." />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Ảnh đại diện nhóm (URL)</label>
                    <input type="text" id="newGroupAvatarInput" class="form-control" placeholder="https://..." value="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=150&auto=format&fit=crop&q=80" />
                </div>
                <div class="mb-2">
                    <label class="form-label fw-semibold small d-flex justify-content-between">
                        <span>Chọn thành viên tham gia nhóm:</span>
                        <span class="text-muted" id="selectedMembersCount">Đã chọn: 0</span>
                    </label>
                    <div id="createGroupCandidatesList" style="max-height: 220px; overflow-y: auto; border: 1px solid #e4e6eb; border-radius: 8px; padding: 6px;">
                        <div class="text-center py-3 text-muted small">Đang tải danh sách tài khoản...</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-top">
                <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-primary btn-sm rounded-pill px-4" onclick="submitCreateGroup()">
                    <i class="bi bi-check2-circle me-1"></i> Tạo nhóm ngay
                </button>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================================
     5. MODAL: QUẢN LÝ THÀNH VIÊN NHÓM (XEM & KICK THÀNH VIÊN)
     ========================================================================= -->
<div class="modal fade" id="fbGroupMembersModal" tabindex="-1" aria-hidden="true" style="z-index: 10060;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0 rounded-4">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-person-lines-fill text-primary"></i> Thành Viên Nhóm Chat
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div id="groupMembersListContainer" style="max-height: 350px; overflow-y: auto; padding: 10px;">
                    <!-- Populated via JS -->
                </div>
            </div>
            <div class="modal-footer bg-light border-top d-flex justify-content-between">
                <button type="button" id="btnAddMemberInModal" class="btn btn-outline-primary btn-sm rounded-pill" onclick="openAddMemberModal()">
                    <i class="bi bi-person-plus-fill me-1"></i> Thêm thành viên
                </button>
                <button type="button" class="btn btn-secondary btn-sm rounded-pill" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================================
     6. MODAL: THÊM THÀNH VIÊN MỚI VÀO NHÓM
     ========================================================================= -->
<div class="modal fade" id="fbAddMemberModal" tabindex="-1" aria-hidden="true" style="z-index: 10070;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0 rounded-4">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-person-plus text-primary"></i> Thêm Thành Viên Vào Nhóm
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div class="small text-muted mb-2">Chọn tài khoản muốn thêm vào nhóm:</div>
                <div id="addCandidateListContainer" style="max-height: 300px; overflow-y: auto;">
                    <!-- Populated via JS -->
                </div>
            </div>
            <div class="modal-footer bg-light border-top">
                <button type="button" class="btn btn-secondary btn-sm rounded-pill" data-bs-dismiss="modal">Xong</button>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================================
     7. PHÒNG GỌI THOẠI & GỌI VIDEO CALL (CALL ROOM OVERLAY MODAL)
     ========================================================================= -->
<div id="fbCallRoomModal" class="d-none" 
     style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: #111418; z-index: 10080; display: flex; flex-direction: column; justify-content: space-between; padding: 20px; color: #fff; transition: all 0.3s ease;">
    <!-- Top Bar -->
    <div class="d-flex justify-content-between align-items-center" style="z-index: 25;">
        <div class="d-flex align-items-center gap-3">
            <div id="callRoomStatusBadge" class="badge bg-primary px-3 py-2 fs-6 rounded-pill d-flex align-items-center gap-2">
                <span class="spinner-grow spinner-grow-sm text-light"></span>
                <span id="callRoomStatusText">Đang kết nối...</span>
            </div>
            <div>
                <h5 id="callRoomTitle" class="fw-bold mb-0 text-white">Cô Mai Anh</h5>
                <small id="callRoomSubTitle" class="text-white-50">Cuộc gọi trực tuyến</small>
            </div>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span id="callDurationTimer" class="fs-4 fw-mono text-white fw-bold px-3 py-1 bg-dark bg-opacity-75 rounded-pill border border-secondary">00:00</span>
            <button type="button" class="btn btn-sm btn-outline-light rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;" onclick="toggleCallWindowSize()" title="Thu nhỏ / Phóng to">
                <i class="bi bi-arrows-angle-contract" id="btnResizeIcon"></i>
            </button>
        </div>
    </div>

    <!-- Cảnh báo trợ giúp HTTPS cho thiết bị di động / mạng LAN -->
    <div id="callHttpMobileWarningBanner" class="alert alert-warning py-2 px-3 my-2 rounded-pill d-none small d-flex align-items-center justify-content-between border border-warning" style="z-index: 30;">
        <span class="text-dark fw-semibold"><i class="bi bi-shield-exclamation text-danger me-1 fs-6"></i> Trình duyệt điện thoại chặn Camera & Mic qua HTTP thường.</span>
        <button type="button" class="btn btn-sm btn-dark rounded-pill py-1 px-3 ms-2 fw-bold" onclick="redirectToHttpsCall()">Bật HTTPS (Cổng 5001)</button>
    </div>

    <!-- Center Call Stage (Video/Voice Grid) -->
    <div class="flex-grow-1 position-relative d-flex justify-content-center align-items-center my-3 overflow-hidden rounded-4 shadow-lg border border-secondary" id="callVideoStage" style="background: #000; min-height: 300px;">
        <!-- 1. REMOTE VIDEO (Người bên kia) -->
        <video id="callLiveRemoteVideo" autoplay playsinline webkit-playsinline class="w-100 h-100 object-fit-contain d-none" style="max-height: 75vh;"></video>
        <!-- 1.1 REMOTE AUDIO (Chuyên biệt phát âm thanh rõ nét hai chiều, không bao giờ bị ngắt trên thiết bị di động) -->
        <audio id="callLiveRemoteAudio" autoplay playsinline style="position: fixed; top: -9999px; left: -9999px; width: 1px; height: 1px; opacity: 0; pointer-events: none;"></audio>

        <!-- 2. SÂN KHẤU GỌI THOẠI (VOICE CALL) HOẶC KHI CHƯA NHẬN VIDEO -->
