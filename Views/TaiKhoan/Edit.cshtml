@model TrungTamNgoaiNgu.ViewModels.EditTaiKhoanViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chỉnh Sửa Tài Khoản #" + Model.MaTaiKhoan;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-1 d-flex align-items-center gap-2">
            <i class="bi bi-person-gear text-primary"></i> Chỉnh Sửa Thông Tin Tài Khoản
        </h3>
        <p class="text-muted mb-0 small">Cập nhật thông tin định danh, vai trò phân quyền và trạng thái hoạt động</p>
    </div>
    <div>
        <a asp-action="Index" class="fb-btn fb-btn-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="fb-card p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MaTaiKhoan" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="TenDangNhap" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-person-badge"></i></span>
                            <input asp-for="TenDangNhap" class="form-control" />
                        </div>
                        <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="HoTen" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                            <input asp-for="HoTen" class="form-control" />
                        </div>
                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="VaiTro" class="form-label fw-semibold"></label>
                        <select asp-for="VaiTro" class="form-select">
                            <option value="HocVien">Học viên (HocVien)</option>
                            <option value="GiaoVien">Giáo viên (GiaoVien)</option>
                            <option value="Admin">Quản trị viên (Admin)</option>
                        </select>
                        <span asp-validation-for="VaiTro" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="TrangThai" class="form-label fw-semibold"></label>
                        <select asp-for="TrangThai" class="form-select">
                            <option value="HoatDong">Hoạt động (HoatDong)</option>
                            <option value="Khoa">Tạm khóa tài khoản (Khoa)</option>
                        </select>
                        <span asp-validation-for="TrangThai" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <div class="p-3 bg-light rounded-3 border">
                            <label asp-for="MatKhauMoi" class="form-label fw-semibold d-flex align-items-center gap-1">
                                <i class="bi bi-key-fill text-warning"></i> @Html.DisplayNameFor(m => m.MatKhauMoi)
                            </label>
                            <input asp-for="MatKhauMoi" type="password" class="form-control" placeholder="Nhập mật khẩu mới nếu cần đổi, hoặc để trống..." autocomplete="new-password" />
                            <div class="form-text text-muted">Nếu không muốn thay đổi mật khẩu hiện tại, bạn hãy để trống ô này.</div>
                            <span asp-validation-for="MatKhauMoi" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="fb-btn fb-btn-secondary">Hủy bỏ</a>
                    <button type="submit" class="fb-btn fb-btn-primary">
                        <i class="bi bi-check-lg me-1"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
