@model TrungTamNgoaiNgu.ViewModels.GuiYeuCauOtpViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đổi Mật Khẩu qua OTP Gmail";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · LanguageBook</title>
    
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        body {
            background: linear-gradient(135deg, #f0f4f8 0%, #e2e8f0 100%);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 16px;
        }

        .auth-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            border: 1px solid #e2e8f0;
            width: 100%;
            max-width: 460px;
            overflow: hidden;
            transition: transform 0.2s ease;
        }

        .auth-header {
            background: linear-gradient(135deg, #0866ff 0%, #0052cc 100%);
            color: #ffffff;
            padding: 32px 28px;
            text-align: center;
            position: relative;
        }

        .auth-header-icon {
            width: 64px;
            height: 64px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            margin-bottom: 12px;
            backdrop-filter: blur(4px);
        }

        .auth-body {
            padding: 32px 28px;
        }

        .form-control-custom {
            height: 50px;
            border-radius: 10px;
            border: 1.5px solid #cbd5e1;
            padding: 12px 16px;
            font-size: 15px;
            transition: all 0.2s;
        }

        .form-control-custom:focus {
            border-color: #0866ff;
            box-shadow: 0 0 0 3px rgba(8, 102, 255, 0.15);
        }

        .btn-submit {
            height: 50px;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 700;
            background: #0866ff;
            border: none;
            color: #ffffff;
            transition: background 0.2s ease, transform 0.1s ease;
        }

        .btn-submit:hover {
            background: #0052cc;
            color: #ffffff;
            transform: translateY(-1px);
        }

        .rule-badge {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 14px;
            font-size: 13px;
            color: #475569;
            margin-bottom: 24px;
        }
    </style>
</head>
<body>

    <div class="auth-card">
        <!-- Header -->
        <div class="auth-header">
            <div class="auth-header-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h4 class="fw-bold mb-1">Đổi Mật Khẩu Tài Khoản</h4>
            <p class="mb-0 opacity-75 small">Xác thực chính chủ an toàn qua mã OTP Gmail</p>
        </div>

        <!-- Body -->
        <div class="auth-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success d-flex align-items-center gap-2 py-2 px-3 mb-3 small" role="alert">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <div>@TempData["Success"]</div>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 mb-3 small" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <div>@TempData["Error"]</div>
                </div>
            }

            <!-- Quy định đổi mật khẩu -->
            <div class="rule-badge">
                <div class="fw-bold text-dark mb-1 d-flex align-items-center gap-1">
                    <i class="bi bi-info-circle-fill text-primary"></i> Quy định đổi mật khẩu:
                </div>
                <ul class="mb-0 ps-3 small text-muted">
                    <li>Nhập chính xác <strong>Gmail đã lưu</strong> trong tài khoản.</li>
                    <li>Mã OTP có thời hạn sử dụng <strong>trong vòng 5 phút</strong>.</li>
                    <li>Giới hạn đổi mật khẩu tối đa <strong>5 lần / 1 ngày</strong>.</li>
                </ul>
            </div>

            <form asp-action="DoiMatKhau" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-bold small text-dark">
                        <i class="bi bi-envelope-at-fill text-primary me-1"></i> Địa chỉ Gmail của tài khoản:
                    </label>
                    <input asp-for="Email" class="form-control form-control-custom" placeholder="Ví dụ: hocvien@gmail.com" autofocus />
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <button type="submit" class="btn btn-submit w-100 mb-3 d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-send-fill"></i> Nhận Mã OTP Qua Gmail
                </button>

                <div class="text-center pt-2 border-top">
                    <a asp-action="Login" class="text-decoration-none small text-muted d-inline-flex align-items-center gap-1">
                        <i class="bi bi-arrow-left"></i> Quay lại trang Đăng nhập
                    </a>
                </div>
            </form>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
