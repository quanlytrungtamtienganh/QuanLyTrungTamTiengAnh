@model TrungTamNgoaiNgu.ViewModels.XacNhanDoiMatKhauViewModel
@{
    Layout = null;
    ViewData["Title"] = "Xác Nhận OTP & Đổi Mật Khẩu";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · LanguageBook</title>
    
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        body {
            background: linear-gradient(135deg, #f0f4f8 0%, #e2e8f0 100%);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 16px;
        }

        .auth-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            border: 1px solid #e2e8f0;
            width: 100%;
            max-width: 480px;
            overflow: hidden;
        }

        .auth-header {
            background: linear-gradient(135deg, #0866ff 0%, #0052cc 100%);
            color: #ffffff;
            padding: 28px 24px;
            text-align: center;
        }

        .auth-body {
            padding: 28px 24px;
        }

        .otp-input {
            height: 56px;
            border-radius: 10px;
            border: 2px solid #cbd5e1;
            font-size: 26px;
            font-weight: 800;
            letter-spacing: 8px;
            text-align: center;
            font-family: SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
            color: #1e3a8a;
            background-color: #f8fafc;
            transition: all 0.2s;
        }

        .otp-input:focus {
            border-color: #0866ff;
            background-color: #ffffff;
            box-shadow: 0 0 0 3px rgba(8, 102, 255, 0.15);
        }

        .form-control-custom {
            height: 48px;
            border-radius: 10px;
            border: 1.5px solid #cbd5e1;
            padding: 10px 14px;
            font-size: 15px;
        }

        .form-control-custom:focus {
            border-color: #0866ff;
            box-shadow: 0 0 0 3px rgba(8, 102, 255, 0.15);
        }

        .btn-submit {
            height: 50px;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 700;
            background: #0866ff;
            border: none;
            color: #ffffff;
            transition: all 0.2s;
        }

        .btn-submit:hover:not(:disabled) {
            background: #0052cc;
            color: #ffffff;
            transform: translateY(-1px);
        }

        .countdown-box {
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            border-radius: 10px;
            padding: 12px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .countdown-timer {
            font-family: monospace;
            font-size: 18px;
            font-weight: 800;
            color: #1d4ed8;
        }

        .countdown-timer.expired {
            color: #dc2626;
        }
    </style>
</head>
<body>

    <div class="auth-card">
        <!-- Header -->
        <div class="auth-header">
            <div class="mb-2">
                <i class="bi bi-key-fill fs-1 text-white opacity-90"></i>
            </div>
            <h4 class="fw-bold mb-1">Xác Nhận Đổi Mật Khẩu</h4>
            <p class="mb-0 opacity-75 small">Nhập mã OTP đã được gửi về Gmail của bạn</p>
        </div>

        <!-- Body -->
        <div class="auth-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success d-flex align-items-center gap-2 py-2 px-3 mb-3 small" role="alert">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <div>@TempData["Success"]</div>
                </div>
            }

            @if (TempData["OfflineOtpAlert"] != null)
            {
                <div class="alert alert-warning d-flex align-items-center gap-2 py-2 px-3 mb-3 small" role="alert">
                    <i class="bi bi-bell-fill fs-5 text-warning"></i>
                    <div><strong>@TempData["OfflineOtpAlert"]</strong></div>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 mb-3 small" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <div>@TempData["Error"]</div>
                </div>
            }

            <!-- Thông tin Gmail & Giới hạn đổi -->
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom text-muted small">
                <div>
                    <i class="bi bi-envelope-check text-primary"></i> Gmail: <strong class="text-dark">@Model.Email</strong>
                </div>
                <div>
                    <span class="badge bg-light text-dark border">
                        <i class="bi bi-arrow-repeat text-primary"></i> Đã đổi: <strong>@Model.SoLanDaDoiHomNay/5</strong> lần hôm nay
                    </span>
                </div>
            </div>

            <!-- Khung đếm ngược thời gian OTP (5 phút) -->
            <div class="countdown-box" id="countdownContainer">
                <div class="d-flex align-items-center gap-2 small text-dark">
                    <i class="bi bi-clock-history fs-5 text-primary" id="clockIcon"></i>
                    <span>Thời hạn mã OTP (5 phút):</span>
                </div>
                <div class="countdown-timer" id="countdownTimer">05:00</div>
            </div>

            <form asp-action="XacNhanDoiMatKhau" method="post" id="resetPasswordForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Email" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small mb-3"></div>

                <!-- Ô nhập Mã OTP 6 chữ số -->
                <div class="mb-3">
                    <label asp-for="MaOtp" class="form-label fw-bold small text-dark d-flex justify-content-between">
                        <span><i class="bi bi-patch-check-fill text-primary me-1"></i> Nhập mã OTP 6 chữ số:</span>
                        <span class="text-muted fw-normal small">(Xem trong hòm thư Gmail)</span>
                    </label>
                    <input asp-for="MaOtp" class="form-control otp-input" maxlength="6" placeholder="------" autocomplete="off" autofocus />
                    <span asp-validation-for="MaOtp" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Mật khẩu mới -->
                <div class="mb-3">
                    <label asp-for="MatKhauMoi" class="form-label fw-bold small text-dark">
                        <i class="bi bi-lock-fill text-primary me-1"></i> Mật khẩu mới:
                    </label>
                    <div class="input-group">
                        <input asp-for="MatKhauMoi" type="password" id="txtMatKhauMoi" class="form-control form-control-custom" placeholder="Tối thiểu 6 ký tự" />
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePass('txtMatKhauMoi', 'iconMoi')">
                            <i class="bi bi-eye-fill" id="iconMoi"></i>
                        </button>
                    </div>
                    <span asp-validation-for="MatKhauMoi" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Xác nhận mật khẩu mới -->
                <div class="mb-4">
                    <label asp-for="XacNhanMatKhau" class="form-label fw-bold small text-dark">
                        <i class="bi bi-shield-check text-primary me-1"></i> Nhập lại mật khẩu mới:
                    </label>
                    <div class="input-group">
                        <input asp-for="XacNhanMatKhau" type="password" id="txtXacNhanMatKhau" class="form-control form-control-custom" placeholder="Nhập lại mật khẩu mới" />
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePass('txtXacNhanMatKhau', 'iconXacNhan')">
                            <i class="bi bi-eye-fill" id="iconXacNhan"></i>
                        </button>
                    </div>
                    <span asp-validation-for="XacNhanMatKhau" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Nút xác nhận đổi mật khẩu -->
                <button type="submit" id="btnSubmitChange" class="btn btn-submit w-100 mb-3 d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-check-circle-fill"></i> Xác Nhận Đổi Mật Khẩu
                </button>
            </form>

            <!-- Nút gửi lại mã OTP -->
            <div class="text-center pt-2 border-top d-flex justify-content-between align-items-center">
                <form asp-action="GuiLaiOtp" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="email" value="@Model.Email" />
                    <button type="submit" class="btn btn-link btn-sm text-decoration-none text-primary p-0">
                        <i class="bi bi-arrow-clockwise"></i> Gửi lại mã OTP
                    </button>
                </form>

                <a asp-action="DoiMatKhau" class="text-decoration-none small text-muted">
                    <i class="bi bi-arrow-left"></i> Đổi Gmail khác
                </a>
            </div>
        </div>
    </div>

    <!-- Script đếm ngược 5 phút & ẩn hiện mật khẩu -->
    <script>
        let remainingSeconds = @Model.RemainingSeconds;
        const timerElement = document.getElementById("countdownTimer");
        const submitBtn = document.getElementById("btnSubmitChange");
        const container = document.getElementById("countdownContainer");
        const clockIcon = document.getElementById("clockIcon");

        function updateCountdown() {
            if (remainingSeconds <= 0) {
                timerElement.innerText = "00:00 (Hết hạn)";
                timerElement.classList.add("expired");
                container.style.backgroundColor = "#fef2f2";
                container.style.borderColor = "#fecaca";
                clockIcon.className = "bi bi-exclamation-circle-fill fs-5 text-danger";
                submitBtn.disabled = true;
                submitBtn.innerText = "Mã OTP đã hết hạn - Hãy gửi lại mã";
                submitBtn.classList.remove("btn-submit");
                submitBtn.classList.add("btn-secondary");
                return;
            }

            const minutes = Math.floor(remainingSeconds / 60);
            const seconds = remainingSeconds % 60;
            timerElement.innerText = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
            remainingSeconds--;
            setTimeout(updateCountdown, 1000);
        }

        updateCountdown();

        function togglePass(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === "password") {
                input.type = "text";
                icon.className = "bi bi-eye-slash-fill";
            } else {
                input.type = "password";
                icon.className = "bi bi-eye-fill";
            }
        }
    </script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
