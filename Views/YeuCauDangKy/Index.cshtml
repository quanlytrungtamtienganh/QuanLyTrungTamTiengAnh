@model List<TrungTamNgoaiNgu.Models.YeuCauDangKy>
@{
    ViewData["Title"] = "Quản lý yêu cầu đăng ký tài khoản";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var trangThai = ViewBag.TrangThai as string;
}

<!-- Thống kê nhanh -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <a href="/YeuCauDangKy" class="text-decoration-none">
            <div class="card border-0 shadow-sm rounded-3 @(trangThai == null ? "border-primary border-2" : "")">
                <div class="card-body d-flex align-items-center gap-3 p-3">
                    <div class="rounded-3 p-3" style="background:#fff8e1;">
                        <i class="bi bi-hourglass-split text-warning fs-4"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-4 text-warning">@ViewBag.TongChoXuLy</div>
                        <div class="text-muted small">Chờ xử lý</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="/YeuCauDangKy?trangThai=DaTao" class="text-decoration-none">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body d-flex align-items-center gap-3 p-3">
                    <div class="rounded-3 p-3" style="background:#e8f5e9;">
                        <i class="bi bi-person-check-fill text-success fs-4"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-4 text-success">@ViewBag.TongDaTao</div>
                        <div class="text-muted small">Đã tạo tài khoản</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="/YeuCauDangKy?trangThai=DaTu" class="text-decoration-none">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body d-flex align-items-center gap-3 p-3">
                    <div class="rounded-3 p-3" style="background:#fce4e4;">
                        <i class="bi bi-x-circle-fill text-danger fs-4"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-4 text-danger">@ViewBag.TongDaTu</div>
                        <div class="text-muted small">Đã từ chối</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Alerts -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 d-flex gap-2 align-items-center">
        <i class="bi bi-check-circle-fill fs-5"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Bộ lọc -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body py-2 px-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex gap-2 flex-wrap">
            <a href="/YeuCauDangKy" class="btn btn-sm rounded-pill @(trangThai == null ? "btn-primary" : "btn-outline-secondary")">
                Tất cả (@(ViewBag.TongChoXuLy + ViewBag.TongDaTao + ViewBag.TongDaTu))
            </a>
            <a href="/YeuCauDangKy?trangThai=ChoXuLy" class="btn btn-sm rounded-pill @(trangThai == "ChoXuLy" ? "btn-warning" : "btn-outline-warning")">
                <i class="bi bi-hourglass-split me-1"></i>Chờ xử lý (@ViewBag.TongChoXuLy)
            </a>
            <a href="/YeuCauDangKy?trangThai=DaTao" class="btn btn-sm rounded-pill @(trangThai == "DaTao" ? "btn-success" : "btn-outline-success")">
                <i class="bi bi-check2 me-1"></i>Đã tạo (@ViewBag.TongDaTao)
            </a>
            <a href="/YeuCauDangKy?trangThai=DaTu" class="btn btn-sm rounded-pill @(trangThai == "DaTu" ? "btn-danger" : "btn-outline-danger")">
                <i class="bi bi-x me-1"></i>Từ chối (@ViewBag.TongDaTu)
            </a>
        </div>
        <span class="text-muted small">Tổng: <strong>@Model.Count</strong> yêu cầu</span>
    </div>
</div>

<!-- Danh sách -->
@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox fs-1 d-block mb-3 text-secondary"></i>
        <h5>Không có yêu cầu nào</h5>
        <p class="small">Chưa có yêu cầu đăng ký tài khoản nào phù hợp.</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var yc in Model)
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-3 @(yc.TrangThai == "ChoXuLy" ? "border-start border-warning border-3" : "")">
                    <div class="card-body p-3">
                        <div class="row align-items-center g-3">
                            <!-- Avatar + Info -->
                            <div class="col-md-4 d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white"
                                     style="width:48px;height:48px;flex-shrink:0;font-size:18px;background:@(yc.VaiTroMongMuon == "GiaoVien" ? "#0866ff" : "#28a745");">
                                    @yc.HoTen.Substring(0, 1).ToUpper()
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">@yc.HoTen</div>
                                    <div class="text-muted small">
                                        <i class="bi bi-envelope me-1"></i>@yc.Email
                                    </div>
                                    @if (!string.IsNullOrEmpty(yc.SoDienThoai))
                                    {
                                        <div class="text-muted small">
                                            <i class="bi bi-telephone me-1"></i>@yc.SoDienThoai
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Vai trò + Ngày + Ghi chú -->
                            <div class="col-md-3">
                                <span class="badge @(yc.VaiTroMongMuon == "GiaoVien" ? "bg-primary" : "bg-success") mb-1">
                                    <i class="bi @(yc.VaiTroMongMuon == "GiaoVien" ? "bi-person-video3" : "bi-mortarboard") me-1"></i>
                                    @(yc.VaiTroMongMuon == "GiaoVien" ? "Giáo viên" : "Học viên")
                                </span>
                                <div class="text-muted small"><i class="bi bi-clock me-1"></i>@yc.NgayGui.ToString("dd/MM/yyyy HH:mm")</div>
                                @if (!string.IsNullOrEmpty(yc.GhiChu))
                                {
                                    <div class="text-secondary small mt-1 fst-italic" style="font-size:12px;">💬 @yc.GhiChu</div>
                                }
                            </div>

                            <!-- Trạng thái -->
                            <div class="col-md-2 text-center">
                                @if (yc.TrangThai == "ChoXuLy")
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2"><i class="bi bi-hourglass me-1"></i>Chờ xử lý</span>
                                }
                                else if (yc.TrangThai == "DaTao")
                                {
                                    <span class="badge bg-success px-3 py-2"><i class="bi bi-check2-circle me-1"></i>Đã tạo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3 py-2"><i class="bi bi-x-circle me-1"></i>Đã từ chối</span>
                                }
                            </div>

                            <!-- Actions -->
                            <div class="col-md-3 d-flex gap-2 justify-content-end flex-wrap">
                                @if (yc.TrangThai == "ChoXuLy")
                                {
                                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-3"
                                            onclick="openTaoTaiKhoan(@yc.MaYeuCau, '@Html.Raw(yc.HoTen.Replace("'", "\\'"))', '@yc.Email', '@yc.VaiTroMongMuon')">
                                        <i class="bi bi-person-plus me-1"></i>Tạo tài khoản
                                    </button>
                                    <form method="post" action="/YeuCauDangKy/TuChoi" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="maYeuCau" value="@yc.MaYeuCau" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                                onclick="return confirm('Từ chối yêu cầu của @yc.HoTen?')">
                                            <i class="bi bi-x me-1"></i>Từ chối
                                        </button>
                                    </form>
                                }
                                <form method="post" action="/YeuCauDangKy/Xoa" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="maYeuCau" value="@yc.MaYeuCau" />
                                    <button type="submit" class="btn btn-outline-secondary btn-sm rounded-circle"
                                            onclick="return confirm('Xóa yêu cầu này?')" title="Xóa">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Modal Tạo tài khoản -->
<div class="modal fade" id="modalTaoTaiKhoan" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0 rounded-4">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                    <i class="bi bi-person-plus-fill text-primary"></i> Tạo tài khoản mới
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/YeuCauDangKy/TaoTaiKhoan">
                @Html.AntiForgeryToken()
                <input type="hidden" id="modalMaYeuCau" name="maYeuCau" />
                <div class="modal-body p-4">
                    <div class="alert alert-info small py-2">
                        <i class="bi bi-envelope-fill me-1"></i>
                        Sau khi tạo, hệ thống sẽ tự động gửi thông tin đăng nhập về Gmail của người dùng.
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                        <input type="text" id="modalHoTen" name="hoTen" class="form-control rounded-3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Gmail <span class="text-danger">*</span></label>
                        <input type="email" id="modalEmail" name="email" class="form-control rounded-3" required />
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tên đăng nhập <span class="text-danger">*</span></label>
                            <input type="text" id="modalTenDangNhap" name="tenDangNhap" class="form-control rounded-3"
                                   placeholder="VD: nguyenvana" required pattern="[a-z0-9_.]+" title="Chỉ dùng chữ thường, số, dấu chấm hoặc gạch dưới" />
                            <div class="form-text">Chỉ chữ thường, số, không dấu cách</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Mật khẩu <span class="text-danger">*</span></label>
                            <input type="text" id="modalMatKhau" name="matKhau" class="form-control rounded-3"
                                   placeholder="VD: Lbook@2024" required minlength="6" />
                            <div class="form-text">Tối thiểu 6 ký tự</div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="form-label fw-semibold">Vai trò <span class="text-danger">*</span></label>
                        <select id="modalVaiTro" name="vaiTro" class="form-select rounded-3" required>
                            <option value="HocVien">🎓 Học viên</option>
                            <option value="GiaoVien">👨‍🏫 Giáo viên</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4" id="btnSubmitTaoTaiKhoan">
                        <i class="bi bi-person-check me-1" id="iconSubmitTaoTaiKhoan"></i>
                        <span id="textSubmitTaoTaiKhoan">Tạo tài khoản & Gửi mail</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openTaoTaiKhoan(maYeuCau, hoTen, email, vaiTroMongMuon) {
        document.getElementById('modalMaYeuCau').value = maYeuCau;
        document.getElementById('modalHoTen').value = hoTen;
        document.getElementById('modalEmail').value = email;
        document.getElementById('modalVaiTro').value = vaiTroMongMuon === 'GiaoVien' ? 'GiaoVien' : 'HocVien';

        // Tu dong tao username tu phan truoc at-sign cua email
        var atIndex = email.indexOf('\x40');
        var emailPart = atIndex > 0 ? email.substring(0, atIndex) : email;
        var username = emailPart.toLowerCase().replace(new RegExp('[^a-z0-9._]', 'g'), '');
        document.getElementById('modalTenDangNhap').value = username;

        // Tu dong tao password mac dinh ngau nhien
        var rnd = Math.floor(1000 + Math.random() * 9000);
        document.getElementById('modalMatKhau').value = 'Lbook\x40\x40' + rnd;

        // Reset submit button state
        var btn = document.getElementById('btnSubmitTaoTaiKhoan');
        var icon = document.getElementById('iconSubmitTaoTaiKhoan');
        var text = document.getElementById('textSubmitTaoTaiKhoan');
        if (btn) {
            btn.disabled = false;
            if (icon) icon.className = 'bi bi-person-check me-1';
            if (text) text.textContent = 'Tạo tài khoản & Gửi mail';
        }

        new bootstrap.Modal(document.getElementById('modalTaoTaiKhoan')).show();
    }

    // Chống bấm tạo tài khoản nhiều lần & hiện loading
    document.querySelector('#modalTaoTaiKhoan form').addEventListener('submit', function () {
        var btn = document.getElementById('btnSubmitTaoTaiKhoan');
        var icon = document.getElementById('iconSubmitTaoTaiKhoan');
        var text = document.getElementById('textSubmitTaoTaiKhoan');
        if (btn && this.checkValidity()) {
            setTimeout(function() {
                btn.disabled = true;
                if (icon) icon.className = 'spinner-border spinner-border-sm me-1';
                if (text) text.textContent = ' Đang tạo tài khoản...';
            }, 10);
        }
    });
</script>
